@model IEnumerable<WebIeltsFree.Models.Announcement>

@{
    ViewData["Title"] = "Announcements";
}

<div class="mb-6">
    <h1 class="fs-3 mb-1">Announcements</h1>
    <p>Post platform-wide announcements for all users (teachers and students).</p>
</div>

<div class="mb-4 d-flex justify-content-between align-items-center">
    <div>
        <a asp-action="Create" class="btn btn-primary">
            <i class="ti ti-plus me-1"></i>New Announcement
        </a>
    </div>
</div>

<div class="card">
    <div class="card-header d-flex justify-content-between align-items-center bg-transparent px-4 py-3">
        <h5 class="mb-0">All Announcements</h5>
    </div>
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th>Title</th>
                    <th>Posted By</th>
                    <th>Created At</th>
                    <th>Expires At</th>
                    <th>Status</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td>
                            <strong>@item.Title</strong>
                            <div class="text-muted small">@item.Content</div>
                        </td>
                        <td>@(item.Teacher?.Profile?.FullName ?? item.Teacher?.Email ?? "System")</td>
                        <td>@item.CreatedAt.ToString("yyyy-MM-dd HH:mm")</td>
                        <td>
                            @if (item.ExpiresAt.HasValue)
                            {
                                @item.ExpiresAt.Value.ToString("yyyy-MM-dd HH:mm")
                            }
                            else
                            {
                                <span class="text-muted">Never</span>
                            }
                        </td>
                        <td>
                            @if (item.IsActive && (!item.ExpiresAt.HasValue || item.ExpiresAt.Value > DateTime.UtcNow))
                            {
                                <span class="badge bg-success-subtle text-success">Active</span>
                            }
                            else if (!item.IsActive)
                            {
                                <span class="badge bg-danger-subtle text-danger">Deactivated</span>
                            }
                            else
                            {
                                <span class="badge bg-secondary-subtle text-secondary">Expired</span>
                            }
                        </td>
                        <td>
                            <div class="d-flex gap-2">
                                <a asp-action="Edit" asp-route-id="@item.AnnouncementId" class="btn btn-light btn-sm btn-icon" title="Edit">
                                    <i class="ti ti-pencil"></i>
                                </a>
                                @if (item.IsActive)
                                {
                                    <form asp-action="Delete" asp-route-id="@item.AnnouncementId" method="post" onsubmit="return confirm('Are you sure you want to deactivate this announcement?');" style="display:inline;">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="btn btn-light btn-sm btn-icon text-danger" title="Deactivate">
                                            <i class="ti ti-power"></i>
                                        </button>
                                    </form>
                                }
                            </div>
                        </td>
                    </tr>
                }
                @if (!Model.Any())
                {
                    <tr>
                        <td colspan="6" class="text-center py-4 text-muted">
                            <i class="ti ti-speakerphone fs-1 d-block mb-2"></i>
                            No announcements found.
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
