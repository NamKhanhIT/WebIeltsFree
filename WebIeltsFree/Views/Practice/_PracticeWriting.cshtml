@* AI IELTS WRITING WORKSPACE *@
@{
    Layout = null; // Completely take over the layout for an immersive app experience
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>AI IELTS Writing Studio</title>
    
    <!-- Load Tailwind CSS -->
    <script src="https://cdn.tailwindcss.com"></script>
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    fontFamily: { sans: ['Inter', 'sans-serif'] },
                    colors: {
                        brand: { 50: '#eef2ff', 100: '#e0e7ff', 200: '#c7d2fe', 300: '#a5b4fc', 400: '#818cf8', 500: '#6366f1', 600: '#4f46e5', 700: '#4338ca' }
                    }
                }
            }
        }
    </script>
    
    <!-- Load Fonts and Quill CSS -->
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <link href="https://cdn.quilljs.com/1.3.7/quill.snow.css" rel="stylesheet">
    
    <style>
        /* Base overrides to prevent inherited layout issues */
        * {
            box-sizing: border-box;
        }
        html, body {
            margin: 0;
            padding: 0;
            background: #f6f8fc;
            overflow-x: hidden;
            overflow-y: auto;
        }
        body {
            display: flex;
            min-height: 100vh;
        }
        header, footer, nav, .navbar, .footer, main::before, main::after { display: none !important; height: 0 !important; visibility: hidden !important; }
        main, .py-4, .container, body > div { max-width: 100% !important; width: 100% !important; padding: 0 !important; margin: 0 !important; }
        
        /* Quill Customization to look like Notion/Grammarly */
        .ql-toolbar.ql-snow {
            border: none !important;
            border-bottom: 1px solid #e2e8f0 !important;
            padding: 16px 32px !important;
            font-family: 'Inter', sans-serif;
            background: rgb(255, 255, 255);
            border-top-left-radius: 1rem;
            border-top-right-radius: 1rem;
            position: sticky;
            top: 0;
            z-index: 20;
        }
        .ql-container.ql-snow {
            border: none !important;
            font-family: 'Inter', sans-serif;
            font-size: 1.125rem;
            line-height: 1.8;
            color: #334155;
            height: auto;
        }
        .ql-container {
            min-height: 500px !important;
            position: relative;
            z-index: 1;
        }
        .ql-editor {
            padding: 32px 48px;
            min-height: 500px !important;
            padding-top: 24px !important;
            background: white;
            position: relative;
            z-index: 2;
            max-width: 100%;
        }
        #editorEmptyGuide {
            position: relative;
            z-index: 1;
        }
        .ql-editor.ql-blank::before {
            top: 24px !important;
            left: 48px !important;
            font-size: 30px;
            color: #cbd5e1 !important;
            font-style: normal;
            font-weight: 400;
        }
        
        /* Hide scrollbars for clean UI */
        .hide-scrollbar::-webkit-scrollbar { display: none; }
        .hide-scrollbar { -ms-overflow-style: none; scrollbar-width: none; }
        
        /* Custom Scrollbar for Editor */
        ::-webkit-scrollbar { width: 6px; }
        ::-webkit-scrollbar-track { background: transparent; }
        ::-webkit-scrollbar-thumb { background: #cbd5e1; border-radius: 10px; }
        ::-webkit-scrollbar-thumb:hover { background: #94a3b8; }
        
        /* Focus Mode Transitions */
        .left-sidebar-transition, .right-sidebar-transition, .editor-canvas-transition {
            transition: all 0.4s cubic-bezier(0.4, 0, 0.2, 1) !important;
        }
        .left-sidebar-blur {
            opacity: 0.6;
            pointer-events: none;
        }
        .right-sidebar-collapse {
            width: 120px !important;
            min-width: 120px !important;
            max-width: 120px !important;
            opacity: 0.5;
        }
        
        .btn-ai {
            background: linear-gradient(135deg, #6366f1 0%, #8b5cf6 100%);
        }
        .btn-ai:hover {
            background: linear-gradient(135deg, #4f46e5 0%, #7c3aed 100%);
            transform: translateY(-1px);
        }
    </style>
</head>
<body class="bg-[#f6f8fc] font-sans text-slate-800 antialiased" style="font-family: 'Inter', sans-serif;">
    
    <!-- Root Layout Container -->
    <div class="min-h-screen w-full flex lg:flex-row flex-col">
        
        <!-- LEFT COLUMN: TASK OVERVIEW (Width: 320px) -->
        <div id="leftSidebar" class="w-[320px] min-w-[320px] max-w-[320px] left-sidebar-transition lg:sticky lg:top-0 lg:h-screen bg-white border-r border-slate-200 flex flex-col z-10 shadow-sm flex-shrink-0">
        <!-- Logo & Top Actions -->
        <div class="h-16 flex items-center justify-between px-6 border-b border-slate-100">
            <div class="flex items-center gap-2 text-brand-600 font-bold text-lg cursor-pointer hover:opacity-80 transition-opacity">
                <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z" /></svg>
                IELTS Studio
            </div>
            <a href="/" class="text-xs font-medium text-slate-400 hover:text-slate-600 flex items-center gap-1 transition-colors">
                <svg xmlns="http://www.w3.org/2000/svg" class="h-3.5 w-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18" /></svg>
                Exit
            </a>
        </div>
        
        <div class="p-6 overflow-y-auto flex-1 hide-scrollbar">
            <!-- Badges & Task Type Switcher -->
            <div class="flex items-center gap-2 mb-4">
                <select id="writingTaskType" class="px-2.5 py-1 text-xs font-semibold bg-brand-50 text-brand-600 rounded-md border border-brand-100 focus:outline-none focus:ring-1 focus:ring-brand-500 cursor-pointer">
                    <option value="1" selected>Task 1 (Report)</option>
                    <option value="2">Task 2 (Essay)</option>
                </select>
                <span class="px-2.5 py-1 text-xs font-medium bg-slate-100 text-slate-600 rounded-md">Academic</span>
                <span class="px-2.5 py-1 text-xs font-medium bg-amber-50 text-amber-600 rounded-md border border-amber-100 flex items-center gap-1">
                    <svg xmlns="http://www.w3.org/2000/svg" class="h-3 w-3" viewBox="0 0 20 20" fill="currentColor"><path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z" /></svg>
                    Target 7.0+
                </span>
            </div>
            
            <!-- Prompt Text -->
            <h2 id="writingPromptBox" class="text-[15px] font-semibold text-slate-800 mb-2 leading-relaxed">
                The chart below shows energy usage by sector from 2000 to 2020.
            </h2>
            <p class="text-xs text-slate-500 mb-6 leading-relaxed">Summarize the information by selecting and reporting the main features, and make comparisons where relevant.</p>
            
            <div id="writingChartContainer" class="mb-8">
                <div onclick="openChartModal()" class="bg-slate-50 rounded-xl aspect-[4/3] w-full flex items-center justify-center border border-slate-200 relative overflow-hidden group cursor-pointer hover:border-brand-300 transition-colors">
                    <!-- High Fidelity Image Rendering -->
                    <img id="writingChartImg" class="absolute inset-0 w-full h-full object-cover transition-transform duration-500 group-hover:scale-105" style="display: none;" alt="Task 1 Chart Reference">
                    
                    <div id="writingChartOverlay" class="absolute inset-0 bg-slate-900/40 opacity-0 group-hover:opacity-100 transition-opacity duration-300 flex items-center justify-center z-10" style="display: none;">
                        <span class="text-xs font-semibold text-white bg-brand-600/90 backdrop-blur-sm px-4 py-2 rounded-full shadow-md flex items-center gap-1.5 border border-white/20">
                            <svg xmlns="http://www.w3.org/2000/svg" class="h-3.5 w-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0zM10 7v3m0 0v3m0-3h3m-3 0H7" /></svg>
                            Click to Enlarge
                        </span>
                    </div>

                    <div id="writingChartFallback" class="absolute inset-0 flex flex-col items-center justify-center p-6 text-center select-none">
                        <div class="absolute inset-0 opacity-5 bg-[url('data:image/svg+xml;base64,PHN2ZyB4bWxucz0iaHR0cDovL3d3dy53My5vcmcvMjAwMC9zdmciIHdpZHRoPSIyMCIgaGVpZ2h0PSIyMCI+PGNpcmNsZSBjeD0iMSIgY3k9IjEiIHI9IjEiIGZpbGw9IiMwMDAiLz48L3N2Zz4=')] group-hover:opacity-10 transition-opacity"></div>
                        <div class="flex flex-col items-center text-slate-400 group-hover:text-brand-500 transition-all duration-300 transform group-hover:scale-105 z-10">
                            <svg xmlns="http://www.w3.org/2000/svg" class="h-12 w-12 mb-3 stroke-[1.2]" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                <path stroke-linecap="round" stroke-linejoin="round" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z" />
                            </svg>
                            <span class="text-xs font-bold text-slate-700 mb-1">Visual Report Draft</span>
                            <span class="text-[10px] text-slate-400 px-3 max-w-[200px]">Diagram pending upload. Click for pre-writing outline.</span>
                        </div>
                    </div>
                </div>
            </div>
            
            <!-- AI Task Insights -->
            <div class="mb-6">
                <h3 class="text-xs font-bold text-slate-400 uppercase tracking-wider mb-4 flex items-center gap-2">
                    <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 text-brand-500" viewBox="0 0 20 20" fill="currentColor"><path fill-rule="evenodd" d="M11.3 1.046A1 1 0 0112 2v5h4a1 1 0 01.82 1.573l-7 10A1 1 0 018 18v-5H4a1 1 0 01-.82-1.573l7-10a1 1 0 011.12-.38z" clip-rule="evenodd" /></svg>
                    AI Pre-writing Analysis
                </h3>
                
                <div class="space-y-5">
                    <div>
                        <div class="text-[11px] font-semibold text-slate-500 mb-2">TREND KEYWORDS</div>
                        <div class="flex flex-wrap gap-2">
                            <span class="px-2.5 py-1 text-[11px] font-medium bg-emerald-50 text-emerald-700 rounded border border-emerald-100 hover:bg-emerald-100 cursor-pointer transition-colors">upward trend</span>
                            <span class="px-2.5 py-1 text-[11px] font-medium bg-rose-50 text-rose-700 rounded border border-rose-100 hover:bg-rose-100 cursor-pointer transition-colors">plummeted</span>
                            <span class="px-2.5 py-1 text-[11px] font-medium bg-slate-100 text-slate-700 rounded border border-slate-200 hover:bg-slate-200 cursor-pointer transition-colors">remained stable</span>
                            <span class="px-2.5 py-1 text-[11px] font-medium bg-amber-50 text-amber-700 rounded border border-amber-100 hover:bg-amber-100 cursor-pointer transition-colors">fluctuated slightly</span>
                        </div>
                    </div>
                    
                    <div>
                        <div class="text-[11px] font-semibold text-slate-500 mb-2">OVERVIEW HINT</div>
                        <div class="text-xs text-slate-600 bg-brand-50/50 p-3 rounded-xl border border-brand-100/50 leading-relaxed shadow-sm">
                            <span class="font-semibold text-brand-600">Tip:</span> Start by comparing the highest and lowest energy sectors. Notice how industrial usage decreased significantly while domestic increased.
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- CENTER COLUMN: AI WRITING STUDIO (Flex 1) -->
    <div class="flex-1 min-w-0 flex flex-col relative bg-[#fafbfd] z-0">
        
        <!-- Topbar -->
        <div class="h-16 px-8 flex items-center justify-between bg-white sticky top-0 z-10 border-b border-slate-200 shadow-sm">
            <div class="flex items-center gap-4">
                <h1 class="text-lg font-semibold text-slate-800 tracking-tight">Your Essay</h1>
                <div class="flex items-center gap-1.5 text-[11px] font-medium text-slate-500 bg-slate-100 px-2 py-0.5 rounded-md border border-slate-200">
                    <span class="w-1.5 h-1.5 rounded-full bg-emerald-500 animate-pulse"></span> Saved just now
                </div>
            </div>
            
            <div class="flex items-center gap-3">
                <!-- Word Count Display in Topbar -->
                <div class="flex items-center gap-2 mr-2 px-3 py-1.5 bg-slate-50 rounded-lg border border-slate-200">
                    <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 text-slate-400" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z" /></svg>
                    <span class="text-sm font-semibold text-slate-700" id="wordCount">0</span>
                    <span class="text-xs text-slate-400">/ 150 words</span>
                </div>
                
                <!-- Save Draft Button -->
                <button id="saveDraftBtnWriting" class="px-4 py-2.5 text-sm font-semibold text-slate-600 hover:text-slate-800 hover:bg-slate-100 rounded-xl border border-slate-200 bg-white shadow-sm transition-all flex items-center gap-1.5">
                    <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7H5a2 2 0 00-2 2v9a2 2 0 002 2h14a2 2 0 002-2V9a2 2 0 00-2-2h-3m-1 4l-3 3m0 0l-3-3m3 3V4" /></svg>
                    Save Draft
                </button>
                
                <!-- Analyze with AI Button -->
                <button id="submitBtnWriting" class="btn-ai px-5 py-2.5 text-sm font-semibold text-white rounded-xl transition-all flex items-center gap-2 shadow-md">
                    <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19.428 15.428a2 2 0 00-1.022-.547l-2.387-.477a6 6 0 00-3.86.517l-.318.158a6 6 0 01-3.86.517L6.05 15.21a2 2 0 00-1.806.547M8 4h8l-1 1v5.172a2 2 0 00.586 1.414l5 5c1.26 1.26.367 3.414-1.415 3.414H4.828c-1.782 0-2.674-2.154-1.414-3.414l5-5A2 2 0 009 10.172V5L8 4z" /></svg>
                    Analyze with AI
                </button>
            </div>
        </div>
        
        <div class="flex-1 overflow-y-auto px-6 xl:px-10 py-8">
            
            <!-- Validation Error Banner -->
            <div id="writingValidationError" class="hidden w-full max-w-4xl mx-auto mb-6 transition-all duration-300">
                <div class="bg-rose-50 border border-rose-200 rounded-2xl p-5 flex items-start gap-4 shadow-sm relative overflow-hidden">
                    <div class="absolute top-0 left-0 w-1.5 h-full bg-rose-500"></div>
                    <div class="p-2 bg-rose-100/80 text-rose-600 rounded-xl">
                        <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" viewBox="0 0 20 20" fill="currentColor">
                            <path fill-rule="evenodd" d="M18 10a8 8 0 11-16 0 8 8 0 0116 0zm-7 4a1 1 0 11-2 0 1 1 0 012 0zm-1-9a1 1 0 00-1 1v4a1 1 0 102 0V6a1 1 0 00-1-1z" clip-rule="evenodd" />
                        </svg>
                    </div>
                    <div class="flex-1">
                        <h4 class="text-sm font-bold text-rose-800">Essay Validation Error</h4>
                        <p id="writingValidationMessage" class="text-xs text-rose-600 mt-1.5 leading-relaxed font-medium">Your essay must be at least 50 words to be analyzed.</p>
                    </div>
                    <button onclick="document.getElementById('writingValidationError').classList.add('hidden')" class="text-rose-400 hover:text-rose-600 transition-colors p-1 rounded-lg hover:bg-rose-100/50">
                        <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" /></svg>
                    </button>
                </div>
            </div>

            <div class="w-full max-w-4xl mx-auto editor-canvas-transition bg-white rounded-2xl shadow-[0_8px_30px_rgb(0,0,0,0.04)] border border-slate-200 flex flex-col overflow-hidden transition-shadow duration-300 focus-within:shadow-[0_8px_40px_rgba(99,102,241,0.08)] focus-within:border-brand-300 relative">
                
                <div id="editorEmptyGuide" class="px-12 pt-10 pb-4 flex flex-col gap-6">
                    
                    <div>
                        <div class="flex items-center gap-2 text-sm font-semibold text-slate-800 mb-4">
                            <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 text-amber-500" viewBox="0 0 20 20" fill="currentColor"><path d="M11 3a1 1 0 10-2 0v1a1 1 0 102 0V3zM15.657 5.757a1 1 0 00-1.414-1.414l-.707.707a1 1 0 001.414 1.414l.707-.707zM18 10a1 1 0 01-1 1h-1a1 1 0 110-2h1a1 1 0 011 1zM5.05 6.464A1 1 0 106.464 5.05l-.707-.707a1 1 0 00-1.414 1.414l.707.707zM5 10a1 1 0 01-1 1H3a1 1 0 110-2h1a1 1 0 011 1zM8 16v-1h4v1a2 2 0 11-4 0zM12 14c.015-.34.208-.646.477-.859a4 4 0 10-4.954 0c.27.213.462.519.476.859h4z" /></svg>
                            Recommended Structure
                        </div>
                        <div class="grid grid-cols-3 gap-3">
                            <div class="bg-blue-50/50 p-4 rounded-xl border border-blue-100/50 text-center">
                                <span class="block text-[10px] font-bold text-blue-600 uppercase mb-1">Introduction</span>
                                <p class="text-xs text-slate-500">Paraphrase the prompt</p>
                            </div>
                            <div class="bg-amber-50/50 p-4 rounded-xl border border-amber-100/50 text-center">
                                <span class="block text-[10px] font-bold text-amber-600 uppercase mb-1">Overview</span>
                                <p class="text-xs text-slate-500">Identify main trends</p>
                            </div>
                            <div class="bg-emerald-50/50 p-4 rounded-xl border border-emerald-100/50 text-center">
                                <span class="block text-[10px] font-bold text-emerald-600 uppercase mb-1">Details</span>
                                <p class="text-xs text-slate-500">Compare specific data</p>
                            </div>
                        </div>
                    </div>

                    <div id="aiFloatingHelper" class="flex flex-col gap-4">
                        <div class="flex items-center gap-2 text-brand-600 text-[11px] font-bold uppercase tracking-wider">
                            <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 text-brand-500" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9.663 17h4.673M12 3v1m6.364 1.636l-.707.707M21 12h-1M4 12H3m3.343-5.657l-.707-.707m2.828 9.9a5 5 0 117.072 0l-.548.547A3.374 3.374 0 0014 18.469V19a2 2 0 11-4 0v-.531c0-.895-.356-1.754-.988-2.386l-.548-.547z" /></svg>
                            AI Writing Assistant Suggestions
                        </div>
                        <div class="grid grid-cols-2 gap-4">
                            <div class="bg-slate-50 p-4 rounded-xl border border-slate-200/60 shadow-sm">
                                <span class="text-[10px] font-bold text-slate-400 block mb-1">SAMPLE INTRODUCTION</span>
                                <p class="text-xs text-slate-500 italic leading-relaxed">"The provided bar chart depicts the proportion of energy consumption across various industries..."</p>
                            </div>
                            <div class="bg-slate-50 p-4 rounded-xl border border-slate-200/60 shadow-sm">
                                <span class="text-[10px] font-bold text-slate-400 block mb-1">BAND 7.5 HINT</span>
                                <p class="text-xs text-slate-500 leading-relaxed">Use cohesive linkers like <strong class="text-brand-500 font-medium">"In stark contrast"</strong> or <strong class="text-brand-500 font-medium">"Parallel to this"</strong> to join segments.</p>
                            </div>
                        </div>
                        <div class="bg-gradient-to-r from-brand-50/60 to-purple-50/60 p-3 rounded-xl border border-brand-100/40 text-xs text-brand-700 flex items-center justify-between shadow-sm">
                            <span class="flex items-center gap-1.5 font-medium">
                                <span class="w-1.5 h-1.5 rounded-full bg-brand-500 animate-pulse"></span>
                                Need inspiration? Start writing to activate real-time grammar checking & lexical suggestions.
                            </span>
                        </div>
                    </div>
                </div>

                <div class="absolute -top-3 left-1/2 transform -translate-x-1/2 bg-slate-800 text-white text-[11px] font-medium px-3 py-1 rounded-full shadow-lg flex items-center gap-2 opacity-0 transition-opacity duration-300" id="aiStatusPill">
                    <span class="w-1.5 h-1.5 rounded-full bg-brand-400 animate-ping"></span> AI is analyzing your coherence
                </div>

                <textarea id="writingAnswer" name="writingAnswer" class="hidden"></textarea>

                <div id="editor" class="flex-1 relative z-10 bg-white"></div>
            </div>
            
            <div class="h-20 w-full flex-shrink-0"></div> <!-- Spacer -->
        </div>
        
        <div class="h-14 bg-white border-t border-slate-200 flex items-center justify-center gap-8 text-[11px] font-semibold text-slate-400 uppercase tracking-wider shadow-[0_-10px_20px_rgba(0,0,0,0.01)] z-10 relative">
            <div class="flex items-center gap-2 group cursor-pointer" title="Grammar Range & Accuracy">
                <span class="w-1.5 h-1.5 rounded-full bg-slate-300 transition-colors" id="stat-grammar-dot"></span>
                <span class="group-hover:text-slate-600 transition-colors">Grammar: <span class="text-slate-800" id="stat-grammar">Waiting...</span></span>
            </div>
            <div class="w-px h-4 bg-slate-200"></div>
            <div class="flex items-center gap-2 group cursor-pointer" title="Lexical Resource">
                <span class="w-1.5 h-1.5 rounded-full bg-slate-300 transition-colors" id="stat-vocab-dot"></span>
                <span class="group-hover:text-slate-600 transition-colors">Vocab: <span class="text-slate-800" id="stat-vocab">Waiting...</span></span>
            </div>
            <div class="w-px h-4 bg-slate-200"></div>
            <div class="flex items-center gap-2 group cursor-pointer" title="Coherence & Cohesion">
