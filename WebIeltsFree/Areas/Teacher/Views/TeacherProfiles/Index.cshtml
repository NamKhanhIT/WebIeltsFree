@model WebIeltsFree.Models.TeacherProfile

@{
    ViewData["Title"] = "My Profile";
}

<div class="mb-6 d-flex justify-content-between align-items-center">
    <div>
        <h1 class="fs-3 mb-1">My Profile</h1>
        <p class="mb-0 text-muted">Manage your public teacher profile. Students can view this to learn about your qualifications and expertise.</p>
    </div>
    <a href="@Url.Action("Preview", "TeacherProfiles")" class="btn btn-outline-primary">
        <i class="bi bi-eye me-1"></i>Preview Public Profile
    </a>
</div>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        <i class="ti ti-circle-check me-2"></i>@TempData["Success"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        <i class="ti ti-alert-triangle me-2"></i>@TempData["Error"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<div class="row">
    <div class="col-lg-8">
        <div class="card">
            <div class="card-header d-flex justify-content-between align-items-center bg-transparent px-4 py-3">
                <h5 class="mb-0"><i class="ti ti-user-circle me-2"></i>Profile Information</h5>
                @if (Model.IsPublic)
                {
                    <span class="badge bg-success-subtle text-success"><i class="ti ti-eye me-1"></i>Public</span>
                }
                else
                {
                    <span class="badge bg-secondary-subtle text-secondary"><i class="ti ti-eye-off me-1"></i>Hidden</span>
                }
            </div>
            <div class="card-body p-4">
                <form asp-action="Save" method="post" enctype="multipart/form-data">
                    @Html.AntiForgeryToken()

                    <!-- Account Info Section -->
                    <div class="row mb-3">
                        <div class="col-md-6">
                            <label for="fullName" class="form-label fw-semibold">
                                <i class="ti ti-user me-1"></i>Public Name (Full Name)
                            </label>
                            <input type="text" id="fullName" name="fullName" class="form-control"
                                   value="@ViewBag.FullName" placeholder="e.g. Mr. John Doe" />
                        </div>
                        <div class="col-md-6">
                            <label for="avatarFile" class="form-label fw-semibold">
                                <i class="ti ti-photo me-1"></i>Avatar
                            </label>
                            <input type="file" id="avatarFile" name="avatarFile" class="form-control" accept="image/*" />
                            @if (!string.IsNullOrEmpty(ViewBag.AvatarUrl))
                            {
                                <div class="mt-1 small">
                                    Current: <a href="@ViewBag.AvatarUrl" target="_blank">View Current Avatar</a>
                                </div>
                            }
                        </div>
                    </div>

                    <!-- Password Change Section -->
                    <div class="row mb-3">
                        <div class="col-md-6">
                            <label for="currentPassword" class="form-label fw-semibold">
                                <i class="ti ti-lock me-1"></i>Current Password
                            </label>
                            <input type="password" id="currentPassword" name="currentPassword" class="form-control" placeholder="Required only if changing password" />
                        </div>
                        <div class="col-md-6">
                            <label for="newPassword" class="form-label fw-semibold">
                                <i class="ti ti-lock-open me-1"></i>New Password
                            </label>
                            <input type="password" id="newPassword" name="newPassword" class="form-control" placeholder="Enter new password" />
                        </div>
                    </div>

                    <hr class="my-4">

                    <!-- Profile Info Section -->
                    <div class="mb-3">
                        <label for="specialties" class="form-label fw-semibold">
                            <i class="ti ti-certificate me-1"></i>Specialties
                        </label>
                        <input type="text" id="specialties" name="specialties" class="form-control"
                               value="@Model.Specialties"
                               placeholder="e.g. Writing, Speaking, Grammar, Pronunciation" />
                        <div class="form-text">Comma-separated list of your teaching specialties. Students see these as badges on your profile.</div>
                    </div>

                    <div class="mb-3">
                        <label for="yearsExperience" class="form-label fw-semibold">
                            <i class="ti ti-calendar me-1"></i>Years of Experience
                        </label>
                        <input type="number" id="yearsExperience" name="yearsExperience" class="form-control"
                               value="@Model.YearsExperience"
                               min="0" max="60" placeholder="e.g. 5" />
                        <div class="form-text">Total years of IELTS teaching or examining experience.</div>
                    </div>

                    <div class="mb-3">
                        <label for="bio" class="form-label fw-semibold">
                            <i class="ti ti-file-text me-1"></i>Bio (CV / About Me)
                        </label>
                        <textarea id="bio" name="bio" class="form-control" rows="5"
                                  placeholder="Tell students about your teaching background, qualifications, and approach...">@Model.Bio</textarea>
                        <div class="form-text">
                            Write about your qualifications, certifications (e.g. CELTA, DELTA), academic degrees, and teaching philosophy.
                            This is what students read to decide if they trust your grading feedback.
                        </div>
                    </div>

                    <!-- Certificates Section -->
                    <div class="mb-3">
                        <label for="certificateFiles" class="form-label fw-semibold">
                            <i class="ti ti-file-upload me-1"></i>Upload Certificates (CV Attachments)
                        </label>
                        <input type="file" id="certificateFiles" name="certificateFiles" class="form-control" accept="image/*" multiple />
                        <div class="form-text">You can upload multiple pictures of your degrees, IELTS certificates, etc.</div>
                        
                        @if (Model?.Certificates != null && Model.Certificates.Any())
                        {
                            <div class="mt-2">
                                <h6 class="fs-6 fw-semibold">Uploaded Certificates:</h6>
                                <div class="d-flex flex-wrap gap-2">
                                    @foreach (var cert in Model.Certificates)
                                    {
                                        <div class="position-relative">
                                            <img src="@cert.ImageUrl" alt="@cert.Title" class="img-thumbnail" style="width: 80px; height: 80px; object-fit: cover;" title="@cert.Title" />
                                            <a href="@cert.ImageUrl" target="_blank" class="stretched-link"></a>
                                        </div>
                                    }
                                </div>
                            </div>
                        }
                    </div>

                    <div class="mb-4">
                        <div class="form-check form-switch">
                            <input class="form-check-input" type="checkbox" role="switch"
                                   id="isPublic" name="isPublic" value="true"
                                   @(Model.IsPublic ? "checked" : "") />
                            <label class="form-check-label fw-semibold" for="isPublic">
                                Make profile publicly visible
                            </label>
                        </div>
                        <div class="form-text">
                            When enabled, students can find you in the Teacher Directory and view your credentials.
                            Disable this to hide your profile while you set it up.
                        </div>
                    </div>

                    <hr class="my-3">
                    <div class="d-flex gap-2">
                        <button type="submit" class="btn btn-primary">
                            <i class="ti ti-device-floppy me-1"></i>Save Profile
                        </button>
                        <a href="/Teachers/@Model.TeacherId" class="btn btn-light" target="_blank" title="Preview how students see your profile">
                            <i class="ti ti-external-link me-1"></i>Preview Public Profile
                        </a>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <div class="col-lg-4">
        <div class="card p-4 bg-info bg-opacity-10 border border-info border-opacity-25 rounded-2">
            <h6 class="mb-3"><i class="ti ti-info-circle me-1 text-info"></i>Why This Matters</h6>
            <ul class="mb-0 ps-3 small text-muted">
                <li class="mb-2">Students review teacher profiles when they <strong>dispute AI-graded scores</strong>.</li>
                <li class="mb-2">A well-written profile builds <strong>trust in your feedback</strong> and reduces follow-up disputes.</li>
                <li class="mb-2">Students can see your specialties, experience, and bio on the <strong>public Teacher Directory</strong>.</li>
                <li>Hiding your profile is useful while you're still setting it up — <strong>toggle it public when ready</strong>.</li>
            </ul>
        </div>
    </div>
</div>
