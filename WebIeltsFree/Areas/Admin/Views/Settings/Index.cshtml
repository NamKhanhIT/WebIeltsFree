@model Dictionary<string, string>

@{
    ViewData["Title"] = "System Settings";
}

<div class="row mb-4">
    <div class="col-12 d-flex justify-content-between align-items-center">
        <div>
            <h1 class="fs-3 fw-bold mb-1">System Settings</h1>
            <p class="text-muted mb-0">Configure AI models, storage paths, and onboarding flows.</p>
        </div>
    </div>
</div>

<div class="row g-4">
    <div class="col-lg-3">
        <!-- Settings Nav Tabs -->
        <div class="card shadow-sm border-0">
            <div class="card-body p-3">
                <div class="nav flex-column nav-pills" id="settings-tabs" role="tablist" aria-orientation="vertical">
                    <button class="nav-link active text-start px-4 py-3 mb-2 d-flex align-items-center" id="ai-tab" data-bs-toggle="pill" data-bs-target="#ai-config" type="button" role="tab" aria-controls="ai-config" aria-selected="true">
                        <i class="ti ti-brain fs-5 me-3"></i> AI Configuration
                    </button>
                    <button class="nav-link text-start px-4 py-3 mb-2 d-flex align-items-center" id="system-tab" data-bs-toggle="pill" data-bs-target="#system-config" type="button" role="tab" aria-controls="system-config" aria-selected="false">
                        <i class="ti ti-settings fs-5 me-3"></i> System Config
                    </button>
                    <button class="nav-link text-start px-4 py-3 d-flex align-items-center" id="onboarding-tab" data-bs-toggle="pill" data-bs-target="#onboarding-config" type="button" role="tab" aria-controls="onboarding-config" aria-selected="false">
                        <i class="ti ti-users fs-5 me-3"></i> Onboarding Flow
                    </button>
                </div>
            </div>
        </div>
    </div>

    <div class="col-lg-9">
        <div class="card shadow-sm border-0">
            <form asp-action="Save" method="post">
                <div class="card-body p-0">
                    <div class="tab-content" id="settings-tabContent">
                        
                        <!-- AI Config Tab -->
                        <div class="tab-pane fade show active p-5" id="ai-config" role="tabpanel" aria-labelledby="ai-tab">
                            <h4 class="fw-bold mb-4">AI Integration Settings</h4>
                            <div class="alert alert-info border-0 bg-info bg-opacity-10 text-dark mb-4">
                                <i class="ti ti-info-circle me-2 text-info"></i>
                                These settings control how the platform connects to Google Gemini for grading and roadmap generation.
                            </div>
                            
                            <div class="mb-4">
                                <label for="gemini_api_key" class="form-label fw-semibold">Gemini API Key</label>
                                <input type="password" class="form-control" id="gemini_api_key" name="settings[gemini_api_key]" value="@Model.GetValueOrDefault("gemini_api_key")" placeholder="AIzaSy..." />
                                <div class="form-text">Keep this key secure. It is used for all AI calls.</div>
                            </div>
                            
                            <div class="mb-4">
                                <label for="gemini_model_version" class="form-label fw-semibold">Gemini Model Version</label>
                                <select class="form-select" id="gemini_model_version" name="settings[gemini_model_version]">
                                    <option value="gemini-1.5-pro" selected="@(Model.GetValueOrDefault("gemini_model_version") == "gemini-1.5-pro")">Gemini 1.5 Pro (Recommended)</option>
                                    <option value="gemini-1.5-flash" selected="@(Model.GetValueOrDefault("gemini_model_version") == "gemini-1.5-flash")">Gemini 1.5 Flash (Faster)</option>
                                    <option value="gemini-pro" selected="@(Model.GetValueOrDefault("gemini_model_version") == "gemini-pro")">Gemini 1.0 Pro (Legacy)</option>
                                </select>
                            </div>
                        </div>

                        <!-- System Config Tab -->
                        <div class="tab-pane fade p-5" id="system-config" role="tabpanel" aria-labelledby="system-tab">
                            <h4 class="fw-bold mb-4">General System Configuration</h4>
                            
                            <div class="mb-4">
                                <label for="site_name" class="form-label fw-semibold">Site Name</label>
                                <input type="text" class="form-control" id="site_name" name="settings[site_name]" value="@Model.GetValueOrDefault("site_name")" placeholder="WebIeltsFree" />
                            </div>
                            
                            <div class="mb-4">
                                <label for="contact_email" class="form-label fw-semibold">Support/Contact Email</label>
                                <input type="email" class="form-control" id="contact_email" name="settings[contact_email]" value="@Model.GetValueOrDefault("contact_email")" placeholder="support@example.com" />
                            </div>
                            
                            <div class="mb-4">
                                <label for="audio_storage_path" class="form-label fw-semibold">IELTS Audio Storage Path</label>
                                <input type="text" class="form-control" id="audio_storage_path" name="settings[audio_storage_path]" value="@Model.GetValueOrDefault("audio_storage_path")" placeholder="/audio/cam20/" />
                                <div class="form-text text-muted">The base relative path in `wwwroot` where listening test audio files are stored.</div>
                            </div>
                        </div>

                        <!-- Onboarding Tab -->
                        <div class="tab-pane fade p-5" id="onboarding-config" role="tabpanel" aria-labelledby="onboarding-tab">
                            <h4 class="fw-bold mb-4">User Onboarding Experience</h4>
                            
                            <div class="mb-4 border rounded-3 p-4 bg-light">
                                <div class="form-check form-switch fs-5">
                                    <input class="form-check-input" type="checkbox" role="switch" id="teacher_review_enabled" name="settings[teacher_review_enabled]" value="true" @(Model.GetValueOrDefault("teacher_review_enabled") == "true" ? "checked" : "")>
                                    <label class="form-check-label fw-semibold" for="teacher_review_enabled">Require Teacher Review for AI Roadmaps</label>
                                </div>
                                <p class="text-muted small mt-2 mb-0 ms-1">
                                    If enabled, AI-generated learning paths will enter a "pending" state until a teacher approves them. If disabled, students get immediate access to their roadmap.
                                </p>
                            </div>
                        </div>
                        
                    </div>
                </div>
                
                <div class="card-footer bg-light border-top p-4">
                    <div class="d-flex justify-content-end gap-2">
                        <button type="reset" class="btn btn-outline-secondary">Discard Changes</button>
                        <button type="submit" class="btn btn-primary px-4">
                            <i class="ti ti-device-floppy me-2"></i>Save All Settings
                        </button>
                    </div>
                </div>
            </form>
        </div>
    </div>
</div>
