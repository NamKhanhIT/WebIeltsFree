@model WebIeltsFree.Models.Course

@{
    ViewData["Title"] = "Edit Course";
}

<div class="row mb-4">
    <div class="col-12 d-flex justify-content-between align-items-center">
        <div>
            <h1 class="fs-3 fw-bold mb-1">Edit Course</h1>
            <p class="text-muted mb-0">Update information for #@Model.CourseId: @Model.Title</p>
        </div>
        <div>
            <a asp-action="Index" class="btn btn-outline-secondary">
                <i class="ti ti-arrow-left me-2"></i>Back to List
            </a>
        </div>
    </div>
</div>

<div class="row g-4">
    <div class="col-lg-8">
        <div class="card shadow-sm border-0">
            <div class="card-body p-4">
                <form asp-action="Edit" method="post">
                    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
                    <input type="hidden" asp-for="CourseId" />
                    <input type="hidden" asp-for="Slug" />

                    <div class="row g-3">
                        <div class="col-md-12">
                            <label asp-for="Title" class="form-label fw-semibold">Course Title <span class="text-danger">*</span></label>
                            <input asp-for="Title" class="form-control" required />
                            <span asp-validation-for="Title" class="text-danger small"></span>
                        </div>

                        <div class="col-md-12">
                            <label asp-for="Description" class="form-label fw-semibold">Description</label>
                            <textarea asp-for="Description" class="form-control" rows="3"></textarea>
                            <span asp-validation-for="Description" class="text-danger small"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="SkillType" class="form-label fw-semibold">Skill Focus <span class="text-danger">*</span></label>
                            <select asp-for="SkillType" class="form-select" required>
                                <option value="mixed">Mixed (Full Test)</option>
                                <option value="listening">Listening</option>
                                <option value="reading">Reading</option>
                                <option value="writing">Writing</option>
                                <option value="speaking">Speaking</option>
                            </select>
                            <span asp-validation-for="SkillType" class="text-danger small"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="TargetBand" class="form-label fw-semibold">Target Band Score</label>
                            <input asp-for="TargetBand" class="form-control" type="number" step="0.5" min="0" max="9" />
                            <span asp-validation-for="TargetBand" class="text-danger small"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="DifficultyLevel" class="form-label fw-semibold">Difficulty Level (1-5)</label>
                            <input asp-for="DifficultyLevel" class="form-control" type="number" min="1" max="5" />
                            <span asp-validation-for="DifficultyLevel" class="text-danger small"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="EstimatedHours" class="form-label fw-semibold">Estimated Hours</label>
                            <input asp-for="EstimatedHours" class="form-control" type="number" min="0" />
                            <span asp-validation-for="EstimatedHours" class="text-danger small"></span>
                        </div>
                        
                        <div class="col-md-6">
                            <label asp-for="OrderIndex" class="form-label fw-semibold">Display Order</label>
                            <input asp-for="OrderIndex" class="form-control" type="number" />
                            <span asp-validation-for="OrderIndex" class="text-danger small"></span>
                        </div>
                        
                        <div class="col-md-6 d-flex align-items-end">
                            <div class="form-check form-switch mb-2">
                                <input asp-for="IsPublished" class="form-check-input" type="checkbox" role="switch" id="publishSwitch">
                                <label class="form-check-label ms-2" for="publishSwitch">Published (Visible to students)</label>
                            </div>
                        </div>


                        <div class="col-12 mt-4">
                            <hr class="mb-4" />
                            <div class="d-flex justify-content-end gap-2">
                                <a asp-action="Index" class="btn btn-light">Cancel</a>
                                <button type="submit" class="btn btn-primary px-4">Save Changes</button>
                            </div>
                        </div>
                    </div>
                </form>
            </div>
        </div>
    </div>
    
    <div class="col-lg-4">
        <div class="card shadow-sm border-0 mb-4">
            <div class="card-header bg-white border-bottom-0 pt-4 pb-0 px-4">
                <h5 class="fw-bold mb-0">Course Structure</h5>
            </div>
            <div class="card-body p-4">
                <p class="text-muted small mb-3">Manage the modules within this course.</p>
                <a href="#" class="btn btn-sm btn-outline-primary w-100 mb-3"><i class="ti ti-layers-linked me-1"></i> Manage Modules</a>
                
                <ul class="list-unstyled mb-0 small">
                    <li class="mb-2">
                        <span class="text-muted d-block">ID</span>
                        <span class="fw-medium">#@Model.CourseId</span>
                    </li>
                    <li>
                        <span class="text-muted d-block">URL Slug</span>
                        <span class="fw-medium text-primary">@Model.Slug</span>
                    </li>
                </ul>
            </div>
        </div>
        
        <div class="card shadow-sm border-0 border-top border-danger border-3">
            <div class="card-body p-4">
                <h5 class="fw-bold text-danger mb-2">Danger Zone</h5>
                <p class="text-muted small mb-3">Deleting this course removes it permanently from the system.</p>
                <form asp-action="Delete" method="post" onsubmit="return confirm('Are you sure you want to completely delete this course?');">
                    <input type="hidden" name="id" value="@Model.CourseId" />
                    <button type="submit" class="btn btn-outline-danger w-100">
                        <i class="ti ti-trash me-2"></i> Delete Course
                    </button>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
