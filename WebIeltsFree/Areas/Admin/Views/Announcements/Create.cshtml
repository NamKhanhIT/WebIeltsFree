@model WebIeltsFree.Models.Announcement

@{
    ViewData["Title"] = "New Announcement";
}

<div class="mb-6">
    <h1 class="fs-3 mb-1">New Announcement</h1>
    <p>Post a platform-wide announcement for all users.</p>
</div>

<div class="row">
    <div class="col-md-8">
        <div class="card p-4">
            <form asp-action="Create" method="post">
                @Html.AntiForgeryToken()

                <div class="mb-3">
                    <label for="title" class="form-label">Title</label>
                    <input type="text" id="title" name="title" class="form-control" required placeholder="e.g. System Maintenance" />
                </div>

                <div class="mb-3">
                    <label for="content" class="form-label">Content</label>
                    <textarea id="content" name="content" class="form-control" rows="5" required placeholder="Enter announcement content..."></textarea>
                </div>

                <div class="mb-3">
                    <label for="expiresAt" class="form-label">Expires At (Optional)</label>
                    <input type="datetime-local" id="expiresAt" name="expiresAt" class="form-control" />
                    <small class="text-muted">Leave empty for no expiration.</small>
                </div>

                <div class="d-flex gap-2">
                    <button type="submit" class="btn btn-primary">Post Announcement</button>
                    <a asp-action="Index" class="btn btn-light">Cancel</a>
                </div>
            </form>
        </div>
    </div>
</div>
