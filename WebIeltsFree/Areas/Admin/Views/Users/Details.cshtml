@model WebIeltsFree.Models.User
@{
    ViewData["Title"] = "User Details";
}

<div class="row">
    <div class="col-lg-4">
        <div class="card shadow-sm border-0 mb-4 text-center">
            <div class="card-body p-4">
                <div class="avatar avatar-xl rounded-circle bg-primary-subtle text-primary d-flex align-items-center justify-content-center fw-bold fs-1 mx-auto mb-3" style="width: 80px; height: 80px;">
                    @(Model.Profile?.FullName?.FirstOrDefault().ToString() ?? Model.Email.FirstOrDefault().ToString().ToUpper())
                </div>
                <h4 class="mb-1 fw-bold">@(Model.Profile?.FullName ?? "No Name Provided")</h4>
                <p class="text-muted mb-3">@Model.Email</p>
                <div class="d-flex justify-content-center gap-2 mb-4">
                    <span class="badge @(Model.Role == "admin" ? "bg-danger" : Model.Role == "teacher" ? "bg-info" : "bg-secondary") px-3 py-2 rounded-pill">@Model.Role.ToUpper()</span>
                    <span class="badge @(Model.Status == "active" ? "bg-success-subtle text-success" : Model.Status == "banned" ? "bg-danger-subtle text-danger" : "bg-warning-subtle text-warning") px-3 py-2 rounded-pill">@Model.Status.ToUpper()</span>
                </div>
                <div class="d-flex gap-2 justify-content-center">
                    <a asp-action="Edit" asp-route-id="@Model.UserId" class="btn btn-outline-primary btn-sm">Edit Role/Status</a>
                    <form asp-action="ToggleBan" asp-route-id="@Model.UserId" method="post" class="d-inline">
                        <button type="submit" class="btn @(Model.Status == "banned" ? "btn-success" : "btn-warning") btn-sm">
                            @(Model.Status == "banned" ? "Unban User" : "Ban User")
                        </button>
                    </form>
                </div>
            </div>
        </div>
    </div>
    <div class="col-lg-8">
        <div class="card shadow-sm border-0">
            <div class="card-header bg-white py-3">
                <h5 class="mb-0 fw-bold">Account Information</h5>
            </div>
            <div class="card-body p-0">
                <ul class="list-group list-group-flush">
                    <li class="list-group-item px-4 py-3 d-flex justify-content-between align-items-center">
                        <div>
                            <span class="d-block text-muted small fw-semibold text-uppercase">User ID</span>
                            <span class="fw-medium text-dark">#@Model.UserId</span>
                        </div>
                    </li>
                    <li class="list-group-item px-4 py-3 d-flex justify-content-between align-items-center">
                        <div>
                            <span class="d-block text-muted small fw-semibold text-uppercase">Email Verified</span>
                            <span class="fw-medium text-dark">
                                @if(Model.EmailVerified) { <span class="text-success"><i class="ti ti-check-circle me-1"></i>Yes</span> }
                                else { <span class="text-danger"><i class="ti ti-x-circle me-1"></i>No</span> }
                            </span>
                        </div>
                    </li>
                    <li class="list-group-item px-4 py-3 d-flex justify-content-between align-items-center">
                        <div>
                            <span class="d-block text-muted small fw-semibold text-uppercase">Joined Date</span>
                            <span class="fw-medium text-dark">@Model.CreatedAt.ToString("f")</span>
                        </div>
                    </li>
                    <li class="list-group-item px-4 py-3 d-flex justify-content-between align-items-center">
                        <div>
                            <span class="d-block text-muted small fw-semibold text-uppercase">Last Login</span>
                            <span class="fw-medium text-dark">@(Model.LastLoginAt?.ToString("f") ?? "Never")</span>
                        </div>
                    </li>
                    <li class="list-group-item px-4 py-3 d-flex justify-content-between align-items-center">
                        <div>
                            <span class="d-block text-muted small fw-semibold text-uppercase">Country / Timezone</span>
                            <span class="fw-medium text-dark">@(Model.Profile?.Country ?? "Unknown") / @(Model.Profile?.Timezone ?? "Unknown")</span>
                        </div>
                    </li>
                </ul>
            </div>
            <div class="card-footer bg-light p-3 text-end">
                <a asp-action="Index" class="btn btn-light shadow-sm px-4">Back to List</a>
            </div>
        </div>
    </div>
</div>
