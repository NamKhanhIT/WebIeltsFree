    async function loadLesson() {
        const titleEl = document.getElementById('lessonTitle');
        const metaEl = document.getElementById('lessonMeta');
        const contentEl = document.getElementById('lessonContentCommon');

        if (!lessonId || lessonId <= 0) {
            if (titleEl) titleEl.textContent = `${skillType.charAt(0).toUpperCase()}${skillType.slice(1)} Practice`;
            if (metaEl) metaEl.textContent = 'General practice mode';
            if (contentEl) contentEl.innerHTML = '<p class="mb-0 text-muted">No lesson selected. You can still practice and submit normally.</p>';
            const progressBar = document.getElementById('progressBar');
            if (progressBar) progressBar.style.width = '0%';
            const progressLabel = document.getElementById('progressLabel');
            if (progressLabel) progressLabel.textContent = '0%';
            return;
        }

        try {
            const response = await api(`/lessons/${lessonId}`, { method: 'GET' });
            const lesson = response?.data;
            if (!response?.success || !lesson) {
                if (titleEl) titleEl.textContent = 'Lesson unavailable';
                if (metaEl) metaEl.textContent = '';
                if (contentEl) contentEl.innerHTML = '<div class="alert alert-warning mb-0">Lesson not found.</div>';
                return;
            }

            if (titleEl) titleEl.textContent = lesson.title || `Lesson #${lessonId}`;
            if (metaEl) metaEl.textContent = `${lesson.estimatedMinutes || 30} minutes • Difficulty ${lesson.difficultyLevel || 1}`;
            const blocks = (lesson.contents || [])
                .map(item => `<div class="mb-3"><h6 class="mb-1">${item.contentType || 'Content'}</h6><div>${item.contentBody || ''}</div></div>`)
                .join('');
            if (contentEl) contentEl.innerHTML = blocks || '<p class="mb-0">No detailed content yet. Continue with the task format below.</p>';

            if (skillType === 'listening') {
                const lc = document.getElementById('lessonContent');
                if (lc && contentEl) lc.innerHTML = contentEl.innerHTML;
            }
            if (skillType === 'reading') {
                const lr = document.getElementById('lessonContentReading');
                if (lr && contentEl && !lr.innerHTML.includes('<h5')) lr.innerHTML = contentEl.innerHTML;
            }

            const progress = Math.max(0, Math.min(100, lesson.completionPercent || 0));
            const progressBar = document.getElementById('progressBar');
            if (progressBar) progressBar.style.width = `${progress}%`;
            const progressLabel = document.getElementById('progressLabel');
            if (progressLabel) progressLabel.textContent = `${progress}%`;
        } catch {
            if (titleEl) titleEl.textContent = 'Could not load lesson';
            if (metaEl) metaEl.textContent = '';
            if (contentEl) contentEl.innerHTML = '<div class="alert alert-danger mb-0">Failed to load lesson data.</div>';
        }
    }

    function bindCommonActions() {
        const draftKey = `practice_draft_${skillType}_${lessonId}`;
        const buttonMap = {
            listening: { save: 'saveDraftBtnListening', submit: 'submitBtnListening' },
            reading: { save: 'saveDraftBtnReading', submit: 'submitBtnReading' },
            writing: { save: 'saveDraftBtnWriting', submit: 'submitBtnWriting' },
            speaking: { save: null, submit: 'submitBtnSpeaking' }
        };
        const currentButtons = buttonMap[skillType] || { save: 'saveDraftBtn', submit: 'submitBtn' };
        const saveBtn = currentButtons.save ? document.getElementById(currentButtons.save) : document.getElementById('saveDraftBtn');
        const submitBtn = currentButtons.submit ? document.getElementById(currentButtons.submit) : document.getElementById('submitBtn');

        if (saveBtn) {
            saveBtn.addEventListener('click', () => {
                localStorage.setItem(draftKey, collectSkillAnswer());
                showToast('Draft saved', 'success');
            });
        }

        const cached = localStorage.getItem(draftKey);
        if (cached) restoreSkillAnswer(cached);

        if (!submitBtn) return;
        submitBtn.setAttribute('type', 'button');
        submitBtn.addEventListener('click', async () => {
            let answer = '';
            if (skillType === 'reading') {
                const hasAnswers = Object.values(userReadingAnswers).some(val => val && val.trim());
                if (!hasAnswers) {
                    showToast('Please answer at least one question before submitting.', 'error');
                    return;
                }
            } else {
                answer = collectSkillAnswer().trim();
                if (!answer) {
                    showToast('Please complete your task before submit', 'error');
                    return;
                }
            }

            if (!Auth.isLoggedIn()) {
                showToast('Please log in to submit practice exercises and view scoring.', 'error');
                return;
            }

            try {
                if (skillType === 'writing') {
                    // Hide any existing validation banner first
                    const errBanner = document.getElementById('writingValidationError');
                    const errMessage = document.getElementById('writingValidationMessage');
                    if (errBanner) errBanner.classList.add('hidden');

                    if (!activeWritingPrompt?.prompt) {
                        showToast('Writing prompt is not ready. Please wait and try again.', 'error');
                        return;
                    }
                    const taskType = Number(document.getElementById('writingTaskType').value || '2');
                    
                    // Frontend word count validation
                    const words = answer.trim() ? answer.trim().split(/\s+/).length : 0;
                    if (taskType === 1 && words < 150) {
                        if (errBanner && errMessage) {
                            errMessage.textContent = `Your Task 1 essay must be at least 150 words to be analyzed. Current count: ${words} words.`;
                            errBanner.classList.remove('hidden');
                            errBanner.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
                        } else {
                            showToast(`Your Task 1 essay must be at least 150 words to be analyzed. Current count: ${words} words.`, 'error');
                        }
                        return;
                    }
                    if (taskType === 2 && words < 250) {
                        if (errBanner && errMessage) {
                            errMessage.textContent = `Your Task 2 essay must be at least 250 words to be analyzed. Current count: ${words} words.`;
                            errBanner.classList.remove('hidden');
                            errBanner.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
                        } else {
                            showToast(`Your Task 2 essay must be at least 250 words to be analyzed. Current count: ${words} words.`, 'error');
                        }
                        return;
                    }

                    const result = await api('/writing/submit', {
                        method: 'POST',
                        body: JSON.stringify({
                            prompt: activeWritingPrompt.prompt,
                            essayText: answer,
                            taskType: taskType
                        })
                    });
                    if (!result?.success || !result?.data) {
                        if (errBanner && errMessage) {
                            errMessage.textContent = result?.message || 'Writing submit failed. Please try again.';
                            errBanner.classList.remove('hidden');
                            errBanner.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
                        } else {
                            showToast(result?.message || 'Writing submit failed', 'error');
                        }
                        return;
                    }
                    const band = formatIeltsBand(result.data?.bandScore);
                    showToast(`Writing submitted. Estimated band: ${band}`, 'success');
                    renderWritingFeedback(result.data, answer, activeWritingPrompt.prompt);
                    await loadWritingHistory();
                } else if (skillType === 'reading' && readingPracticeData) {
                    const questions = readingPracticeData.questions || [];
                    const submitPromises = [];
                    let unansweredCount = 0;

                    questions.forEach(q => {
                        const ans = userReadingAnswers[q.questionId] || '';
                        if (!ans) {
                            unansweredCount++;
                        }

                        submitPromises.push(
                            api('/reading/submit', {
                                method: 'POST',
                                body: JSON.stringify({
                                    questionId: q.questionId,
                                    userAnswer: ans,
                                    timeSpentSeconds: 15
                                })
                            }).then(res => res?.success ? res.data : null).catch(() => null)
                        );
                    });

                    showToast('Grading your IELTS Reading practice...', 'info');

                    const results = await Promise.all(submitPromises);
                    const validResults = results.filter(r => r !== null);

                    if (validResults.length === 0) {
                        showToast('Failed to grade reading test. Please try again.', 'error');
                        return;
                    }

                    let correctCount = 0;
                    let incorrectCount = 0;

                    validResults.forEach(r => {
                        if (r.isCorrect) {
                            correctCount++;
                        } else {
                            incorrectCount++;
                        }
                    });

                    // Estimate band target
                    const avgBandTarget = questions.reduce((sum, q) => sum + (q.bandTarget || 6.0), 0) / questions.length;
                    let estimatedBand = '5.0';
                    const pct = correctCount / questions.length;
                    if (pct >= 0.9) estimatedBand = (avgBandTarget + 0.5).toFixed(1);
                    else if (pct >= 0.75) estimatedBand = avgBandTarget.toFixed(1);
                    else if (pct >= 0.5) estimatedBand = (avgBandTarget - 0.5).toFixed(1);
                    else if (pct >= 0.3) estimatedBand = (avgBandTarget - 1.0).toFixed(1);
                    else estimatedBand = '4.0';

                    // Build detail review HTML
                    let detailHtml = '';
                    validResults.forEach(r => {
                        const matchingQ = questions.find(q => q.questionId === r.questionId);
                        const qNum = matchingQ ? matchingQ.questionNumber : r.questionNumber;
                        const qText = matchingQ ? matchingQ.questionText : 'Question';
                        const isCorrect = r.isCorrect;
                        const bg = isCorrect ? '#f0fdf4' : '#fef2f2';
                        const border = isCorrect ? '#bbf7d0' : '#fecaca';
                        const icon = isCorrect ? 'bi-check-circle-fill' : 'bi-x-circle-fill';
                        const iconColor = isCorrect ? '#059669' : '#dc2626';

                        detailHtml += `
                            <div class="p-3 rounded mb-3" style="background:${bg}; border:1px solid ${border}; font-size:.85rem;">
                                <div class="d-flex align-items-center gap-2 mb-2">
                                    <i class="bi ${icon}" style="color:${iconColor}; font-size:1.1rem;"></i>
                                    <strong>Q${qNum}. ${escapeHtml(qText)}</strong>
                                </div>
                                <div class="mb-2"><strong>Your Answer:</strong> <span class="badge ${isCorrect ? 'bg-success' : 'bg-danger'}">${escapeHtml(r.userAnswer || '[Blank]')}</span></div>
                                <div class="mb-2"><strong>Correct Answer:</strong> <span class="badge bg-success">${escapeHtml(r.correctAnswer)}</span></div>
                                <div class="pt-2 mt-2" style="border-top:1px solid ${border}; font-size:.8rem;">
                                    <strong>Explanation:</strong> ${escapeHtml(r.explanation || 'No explanation available.')}
                                </div>
                            </div>`;
                    });

                    showResultsPopup({
                        iconClass: 'graded',
                        title: 'Reading Test Results',
                        subtitle: `You scored ${correctCount} out of ${questions.length} questions`,
                        stats: [
                            { label: 'Correct', value: String(correctCount), color: 'success' },
                            { label: 'Incorrect', value: String(incorrectCount), color: 'danger' },
                            { label: 'Unanswered', value: String(unansweredCount), color: 'warning' },
                            { label: 'Band Estimate', value: estimatedBand, color: 'primary' }
                        ],
                        detailHtml: detailHtml
                    });
                } else if (skillType === 'listening') {
                    saveCurrentListeningSectionAnswers();
                    const submitPromises = [];
                    let unansweredCount = 0;
                    
                    for (let qId = 2001; qId <= 2020; qId++) {
                        const ans = userListeningAnswers[qId] || '';
                        if (!ans) {
                            unansweredCount++;
                        }
                        
                        submitPromises.push(
                            api('/listening/submit', {
                                method: 'POST',
                                body: JSON.stringify({
                                    questionId: qId,
                                    userAnswer: ans,
                                    timeSpentSeconds: 15
                                })
                            }).then(res => res?.success ? res.data : null).catch(() => null)
                        );
                    }

                    showToast('Analyzing and scoring your IELTS listening test...', 'info');

                    const results = await Promise.all(submitPromises);
                    const validResults = results.filter(r => r !== null);

                    if (validResults.length === 0) {
                        showToast('Failed to grade listening test. Please try again.', 'error');
                        return;
                    }

                    let correctCount = 0;
                    let incorrectCount = 0;
                    
                    validResults.forEach(r => {
                        if (r.isCorrect) {
                            correctCount++;
                        } else {
                            incorrectCount++;
                        }
                    });

                    const estimatedBand = estimateIeltsListeningBand(correctCount);

                    // Build detail review HTML for popup
                    let detailHtml = '';
                    validResults.sort((a, b) => a.QuestionId - b.QuestionId);
                    validResults.forEach((r, idx) => {
                        const qNum = idx + 1;
                        const isCorrect = r.isCorrect;
                        const bg = isCorrect ? '#f0fdf4' : '#fef2f2';
                        const border = isCorrect ? '#bbf7d0' : '#fecaca';
                        const icon = isCorrect ? 'bi-check-circle-fill' : 'bi-x-circle-fill';
                        const iconColor = isCorrect ? '#059669' : '#dc2626';
                        detailHtml += `
                            <div class="d-flex align-items-start gap-2 p-2 rounded mb-2" style="background:${bg}; border:1px solid ${border}; font-size:.82rem;">
                                <i class="bi ${icon}" style="color:${iconColor}; margin-top:2px;"></i>
                                <div class="flex-grow-1">
                                    <strong>Q${qNum}</strong> —
                                    Your: <span class="badge ${isCorrect ? 'bg-success' : 'bg-danger'}" style="font-size:.7rem;">${escapeHtml(r.userAnswer || '[Blank]')}</span>
                                    Correct: <span class="badge bg-success" style="font-size:.7rem;">${escapeHtml(r.correctAnswer)}</span>
                                    ${r.explanation ? `<div class="text-muted mt-1" style="font-size:.75rem;">${escapeHtml(r.explanation)}</div>` : ''}
                                </div>
                            </div>`;
                    });

                    showResultsPopup({
                        iconClass: 'graded',
                        title: 'Listening Test Results',
                        subtitle: `You scored ${correctCount} out of 20 questions`,
                        stats: [
                            { label: 'Correct', value: String(correctCount), color: 'success' },
                            { label: 'Incorrect', value: String(incorrectCount), color: 'danger' },
                            { label: 'Unanswered', value: String(unansweredCount), color: 'warning' },
                            { label: 'Band', value: estimatedBand, color: 'primary' }
                        ],
                        detailHtml: detailHtml
                    });
                } else if (skillType === 'speaking') {
                    if (!activeSpeakingSessionId) {
                        const started = await api('/speaking/start', {
                            method: 'POST',
                            body: JSON.stringify({ topic: activeSpeakingTopic?.topic || document.getElementById('speakingPrompt').textContent || 'General speaking topic' })
                        });
                        if (started?.success) activeSpeakingSessionId = started.data?.sessionId || 0;
                    }
                    if (activeSpeakingSessionId) {
                        const result = await api('/speaking/submit-audio', {
                            method: 'POST',
                            body: JSON.stringify({
                                sessionId: activeSpeakingSessionId,
                                audioData: 'web-speech-transcript',
                                transcript: answer
                            })
                        });
                        if (result?.success) {
                            const band = result.data?.overallBand ?? 'N/A';
                            const fluency = result.data?.fluencyScore ?? '-';
                            const pronunciation = result.data?.pronunciationScore ?? '-';
                            const lexical = result.data?.lexicalScore ?? '-';

                            showResultsPopup({
                                iconClass: 'graded',
                                title: 'Speaking Analysis',
                                subtitle: `Your speaking session has been analyzed`,
                                stats: [
                                    { label: 'Overall Band', value: String(band), color: 'primary' },
                                    { label: 'Fluency', value: String(fluency), color: 'success' },
                                    { label: 'Pronunciation', value: String(pronunciation), color: 'warning' },
                                    { label: 'Lexical', value: String(lexical), color: 'success' }
                                ]
                            });
                        }
                    }
                } else if (lessonId > 0) {
                    await api(`/lessons/${lessonId}/complete`, { method: 'POST' });
                }
                const pBar = document.getElementById('progressBar');
                if (pBar) pBar.style.width = '100%';
                const pLabel = document.getElementById('progressLabel');
                if (pLabel) pLabel.textContent = '100%';
                showToast('Submitted successfully', 'success');
            } catch (err) {
                console.error(err);
                if (skillType === 'writing') {
                    const errBanner = document.getElementById('writingValidationError');
                    const errMessage = document.getElementById('writingValidationMessage');
                    if (errBanner && errMessage) {
                        errMessage.textContent = err.message || 'Submit failed. Please try again.';
                        errBanner.classList.remove('hidden');
                        errBanner.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
                        return;
                    }
                }
                showToast(err.message || 'Submit failed', 'error');
            }
        });
    }

    function collectSkillAnswer() {
        if (skillType === 'reading') {
            return JSON.stringify(userReadingAnswers);
        }
        if (skillType === 'listening') {
            return JSON.stringify(userListeningAnswers);
        }
        if (skillType === 'writing') {
            const writingAnswer = document.getElementById('writingAnswer');
            return writingAnswer ? (writingAnswer.value || '') : '';
        }
        if (skillType === 'speaking') {
            const transcriptEl = document.getElementById('speakingCcText');
            const transcript = (transcriptEl ? transcriptEl.textContent : '').trim();
            const timerEl = document.getElementById('speakingCallTimer') || document.getElementById('speakingDuration');
            const timerVal = timerEl ? timerEl.textContent : '00:00';
            return transcript || `Speaking timer: ${timerVal}`;
        }
        return '';
    }

    function restoreSkillAnswer(saved) {
        if (skillType === 'writing') {
            if (document.getElementById('editor')) return;
            const writingAnswer = document.getElementById('writingAnswer');
            if (writingAnswer) {
                writingAnswer.value = saved;
                const words = (saved.trim().match(/\S+/g) || []).length;
                const wordCountEl = document.getElementById('writingWordCount');
                if (wordCountEl) wordCountEl.textContent = `${words} words`;
            }
        } else if (skillType === 'reading') {
            try {
                userReadingAnswers = JSON.parse(saved) || {};
                if (readingPracticeData && readingPracticeData.questions) {
                    renderReadingQuestions(readingPracticeData.questions);
                    renderReadingQuestionNav(readingPracticeData.questions);
                }
            } catch (e) { console.error("Error restoring reading answers:", e); }
        } else if (skillType === 'listening') {
            try {
                userListeningAnswers = JSON.parse(saved) || {};
                if (listeningPracticeData[activeListeningSection]) {
                    renderListeningQuestions(listeningPracticeData[activeListeningSection].questions);
                    renderListeningQuestionNav();
                }
            } catch (e) { console.error("Error restoring listening answers:", e); }
        }
    }

    async function startSpeakingSession() { console.log("startSpeakingSession triggered");
        if (speakingActive) return;
        const permission = await requestMicrophonePermission();
        if (!permission) return;

        // Create backend session first (so we have a sessionId for Submit)
        if (!activeSpeakingSessionId && Auth.isLoggedIn()) {
            try {
                const started = await api('/speaking/start', {
                    method: 'POST',
                    body: JSON.stringify({ topic: activeSpeakingTopic?.topic || document.getElementById('speakingPrompt')?.textContent || 'General speaking topic' })
                });
                if (started?.success) {
                    activeSpeakingSessionId = started.data?.sessionId || 0;
                }
            } catch (e) {
                console.warn('Could not create backend speaking session:', e.message);
            }
        }

        // D-ID WebRTC — fire and forget, don't block the session start
        startDidWebRtcSession().catch(e => console.warn('D-ID WebRTC not available:', e.message));

        // WebSocket realtime (Python AI) — optional
        await startSpeakingRealtimeIfNeeded();

        // Start the local timer and speech recognition
        startSpeakingTimer();
    }

    function startSpeakingTimer() {
        speakingActive = true;
        speakingSafetyTerminated = false;
        updateSpeakingButtons();
        updateCallStatusPill('active');
        startSpeechRecognition();
        if (speakingInterval) clearInterval(speakingInterval);
        speakingInterval = setInterval(() => {
            speakingSeconds += 1;
            const mm = String(Math.floor(speakingSeconds / 60)).padStart(2, '0');
            const ss = String(speakingSeconds % 60).padStart(2, '0');
            const timeStr = `${mm}:${ss}`;
            // Update all timer elements (new UI has speakingCallTimer + speakingDuration, old had speakingTimer)
            const timerEl = document.getElementById('speakingTimer');
            const callTimerEl = document.getElementById('speakingCallTimer');
            const durationEl = document.getElementById('speakingDuration');
            if (timerEl) timerEl.textContent = timeStr;
            if (callTimerEl) callTimerEl.textContent = timeStr;
            if (durationEl) durationEl.textContent = timeStr;
        }, 1000);
    }

    function stopSpeakingTimer() {
        speakingActive = false;
        updateSpeakingButtons();
        updateCallStatusPill('idle');
        clearSpeakingAutoNextTimer();
        speakingIsAwaitingExaminer = false;
        stopSpeechRecognition();
        releaseMicrophone();
        closeDidWebRtcSession();
        if (speakingInterval) clearInterval(speakingInterval);
        speakingInterval = null;
        if (window.speechSynthesis) {
            window.speechSynthesis.cancel();
        }
        speakingTtsSentenceBuffer = '';
    }

    function resetSpeakingTimer() {
        stopSpeakingTimer();
        speakingSeconds = 0;
        activeSpeakingSessionId = 0;
        // Reset all timer displays
        const timerEl = document.getElementById('speakingTimer');
        const callTimerEl = document.getElementById('speakingCallTimer');
        const durationEl = document.getElementById('speakingDuration');
        if (timerEl) timerEl.textContent = '00:00';
        if (callTimerEl) callTimerEl.textContent = '00:00';
        if (durationEl) durationEl.textContent = '00:00';
        finalTranscript = '';
        speakingQuestionCount = 0;
        const transcriptEl = document.getElementById('speakingTranscript');
        if (transcriptEl) transcriptEl.value = '';
        // Clear the closed captions
        const ccText = document.getElementById('speakingCcText');
        if (ccText) { ccText.textContent = ''; ccText.classList.remove('visible'); }
        setMicStatus('Microphone: idle');
        speakingStreamBuffer = '';
        speakingTtsSentenceBuffer = '';
        speakingWarningCount = 0;
        speakingSafetyTerminated = false;
        speakingLastModeratedLength = 0;
        speakingLastSubmittedLength = 0;
        speakingAiIsTalking = false;
        speakingIsAwaitingExaminer = false;
        clearSpeakingAutoNextTimer();
        updateSpeakingStreamText('');
        speakingCurrentPart = 1;
        updateSpeakingPartStatus();
        setSpeakingSafetyState('On-topic', false);
        updateAutoNextStatus('Auto-next is ready.');
        updateWarningCounter();
        updateQuestionCounter();
        appendSpeakingWarningLog('Safety monitor reset for a new interview.');
        renderSpeakingPrefetchQuestions([]);
        if (speakingWsConnected) {
            speakingWsManualClose = true;
            speakingWs.send(JSON.stringify({ type: 'reset' }));
        }
        updateSpeakingButtons();
        updateCallStatusPill('idle');
    }

    function initializeSpeechRecognition() {
        const SpeechRecognition = window.SpeechRecognition || window.webkitSpeechRecognition;
        if (!SpeechRecognition) {
            setMicStatus('Microphone: browser does not support speech recognition');
            return;
        }
        speechRecognition = new SpeechRecognition();
        speechRecognition.lang = 'en-US';
        speechRecognition.continuous = true;
        speechRecognition.interimResults = true;
        speechRecognition.onstart = () => setMicStatus('Microphone: listening...');
        speechRecognition.onerror = () => {
            if (speakingActive) setMicStatus('Microphone: reconnecting...');
            else setMicStatus('Microphone: error while listening');
        };
        speechRecognition.onend = () => {
            if (speakingActive) {
                setMicStatus('Microphone: reconnecting...');
                startSpeechRecognition();
            } else setMicStatus('Microphone: stopped');
        };
        speechRecognition.onresult = (event) => {
            if (!speakingActive || speakingAiIsTalking) return;
            let hasNewFinal = false;
            let interim = '';
            for (let i = event.resultIndex; i < event.results.length; i++) {
                const text = event.results[i][0].transcript;
                if (event.results[i].isFinal) {
                    const normalizedFinal = (text || '').trim();
                    if (normalizedFinal) {
                        if (isLikelyNoiseTranscript(normalizedFinal)) continue;
                        finalTranscript += `${normalizedFinal} `;
                        hasNewFinal = true;
                    }
                }
                else interim += text;
            }
            const transcriptEl = document.getElementById('speakingCcText');
            if (transcriptEl) {
                const text = `${finalTranscript}${interim}`.trim();
                transcriptEl.textContent = text;
                if (text) transcriptEl.classList.add('visible');
                else transcriptEl.classList.remove('visible');
            }
            if (hasNewFinal) {
                sendLiveTranscriptForModeration();
                scheduleAutoNextFromSpeech();
            }
        };
    }

    function startSpeechRecognition() { if (!speechRecognition) return; try { speechRecognition.start(); } catch {} }
    function stopSpeechRecognition() { if (!speechRecognition) return; try { speechRecognition.stop(); } catch {} }
    function setMicStatus(text) { const statusEl = document.getElementById('speakingMicStatus'); if (statusEl) statusEl.textContent = text; }

    async function requestMicrophonePermission() {
        if (!navigator.mediaDevices || !navigator.mediaDevices.getUserMedia) {
            setMicStatus('Microphone: browser does not support recording');
            showToast('Browser does not support microphone access', 'error');
            return false;
        }
        if (micStream) return true;
        try {
            micStream = await navigator.mediaDevices.getUserMedia({
                audio: {
                    echoCancellation: true,
                    noiseSuppression: true,
                    autoGainControl: true,
                    channelCount: 1
                }
            });
            setMicStatus('Microphone: permission granted');
            return true;
        } catch {
            setMicStatus('Microphone: permission denied');
            showToast('Please allow microphone access to start speaking', 'error');
            return false;
        }
    }

    function releaseMicrophone() {
        if (!micStream) return;
        micStream.getTracks().forEach(track => track.stop());
        micStream = null;
    }

    let speakingQuestionCount = 0;

    function updateSpeakingButtons() {
        if (skillType !== 'speaking') return;
        const startBtn = document.getElementById('startSpeakingBtn');
        const stopBtn = document.getElementById('stopSpeakingBtn');
        const nextBtn = document.getElementById('nextQuestionBtn');
        const interruptBtn = document.getElementById('interruptSpeakingBtn');
        if (startBtn) startBtn.disabled = speakingActive || speakingSafetyTerminated;
        if (stopBtn) stopBtn.disabled = !speakingActive;
        if (nextBtn) nextBtn.disabled = !speakingActive || speakingSafetyTerminated;
        if (interruptBtn) interruptBtn.disabled = !speakingActive;
    }

    function updateCallStatusPill(state) {
        const pill = document.getElementById('speakingCallStatus');
        if (!pill) return;
        pill.classList.remove('idle', 'active', 'warning');
        if (state === 'active') {
            pill.classList.add('active');
            pill.innerHTML = '<i class="bi bi-circle-fill" style="font-size:0.5rem;"></i> Live';
        } else if (state === 'warning') {
            pill.classList.add('warning');
            pill.innerHTML = '<i class="bi bi-exclamation-triangle-fill" style="font-size:0.5rem;"></i> Warning';
        } else {
            pill.classList.add('idle');
            pill.innerHTML = '<i class="bi bi-circle-fill" style="font-size:0.5rem;"></i> Offline';
        }
    }

    function updateQuestionCounter() {
        const el = document.getElementById('speakingQCount');
        if (el) el.textContent = String(speakingQuestionCount);
    }

    function initializeSpeakingRealtime() {
        if (skillType !== 'speaking') return;
        speakingWsManualClose = false;
        connectSpeakingWebSocketWithFallback(buildSpeakingWsCandidates(), 0);
    }

    function buildSpeakingWsCandidates() {
        const candidates = [];
        const protocol = window.location.protocol === 'https:' ? 'wss' : 'ws';
        const explicit = (window.localStorage.getItem('speaking_ws_url') || '').trim();
        if (explicit) candidates.push(explicit);

        // Prefer same-origin websocket proxy to avoid HTTPS mixed-content issues.
        candidates.push(`${protocol}://${window.location.host}/ws/speaking`);

        const host = (window.location.hostname || '').toLowerCase();
        if (host === 'localhost' || host === '127.0.0.1') {
            candidates.push('ws://localhost:8000/ws/speaking');
            candidates.push('ws://127.0.0.1:8000/ws/speaking');
            candidates.push('wss://localhost:8000/ws/speaking');
        }

        return [...new Set(candidates.filter(Boolean))];
    }

    function connectSpeakingWebSocketWithFallback(candidates, index) {
        if (skillType !== 'speaking') return;
        if (index >= candidates.length) {
            speakingWsConnected = false;
            setSpeakingRealtimeStatus('Disconnected: Python AI WS unavailable');
            appendSpeakingWarningLog('Could not connect to speaking websocket. Please start python_ai_service and retry.');
            updateSpeakingButtons();
            return;
        }

        const wsUrl = candidates[index];
        let opened = false;
        setSpeakingRealtimeStatus(`Connecting... (${index + 1}/${candidates.length})`);

        try {
            speakingWs = new WebSocket(wsUrl);
        } catch {
            connectSpeakingWebSocketWithFallback(candidates, index + 1);
            return;
        }

        speakingWs.onopen = () => {
            opened = true;
            speakingWsConnected = true;
            setSpeakingRealtimeStatus('Connected');
            setAvatarStatus('Waiting for first question');
            appendSpeakingWarningLog(`Connected via ${wsUrl}`);
            updateSpeakingButtons();
        };

        speakingWs.onclose = () => {
            speakingWsConnected = false;
            updateSpeakingButtons();

            if (!opened) {
                connectSpeakingWebSocketWithFallback(candidates, index + 1);
                return;
            }

            if (speakingWsManualClose || speakingSafetyTerminated) {
                setSpeakingRealtimeStatus('Disconnected');
                return;
            }

            setSpeakingRealtimeStatus('Reconnecting...');
            if (speakingWsReconnectTimer) clearTimeout(speakingWsReconnectTimer);
            speakingWsReconnectTimer = setTimeout(() => {
                connectSpeakingWebSocketWithFallback(buildSpeakingWsCandidates(), 0);
            }, 2000);
        };

        speakingWs.onerror = () => {
            if (!opened) return;
            setSpeakingRealtimeStatus('Connection error');
        };

        speakingWs.onmessage = (event) => {
            try {
                const data = JSON.parse(event.data);
                if (data.part) {
                    speakingCurrentPart = Number(data.part);
                    updateSpeakingPartStatus();
                }
                if (data.type === 'stream') {
                    speakingIsAwaitingExaminer = true;
                    const token = data.text || '';
                    speakingStreamBuffer += token;
                    updateSpeakingStreamText(speakingStreamBuffer);
                    if (!didStreamId) {
                        speakingTtsSentenceBuffer += token;
                        speakCompletedSentencesFromBuffer();
                    }
                }
                if (data.type === 'done') {
                    speakingIsAwaitingExaminer = false;
                    const promptEl = document.getElementById('speakingPrompt');
                    const textToSpeak = speakingStreamBuffer;
                    if (promptEl) promptEl.textContent = textToSpeak.trim() || promptEl.textContent;
                    setSpeakingRealtimeStatus('Question ready');
                    updateAutoNextStatus(speakingAutoNextEnabled ? 'Auto-next armed. Start answering when ready.' : 'Auto-next is off. Use Next Question manually.');
                    
                    // Increment question counter
                    speakingQuestionCount += 1;
                    updateQuestionCounter();
                    
                    // Call D-ID WebRTC to speak or use browser TTS fallback
                    if (didStreamId) {
                        sendDidTalkRequest(textToSpeak);
                    } else {
                        speakRemainingSentenceBuffer();
                    }
                    
                    speakingStreamBuffer = '';
                }
                if (data.type === 'prefetch_part3') {
                    renderSpeakingPrefetchQuestions(data.questions || []);
                }
                if (data.type === 'interrupted') {
                    setSpeakingRealtimeStatus('Interrupted');
                }
                if (data.type === 'warning') {
                    speakingIsAwaitingExaminer = false;
                    speakingWarningCount += 1;
                    updateWarningCounter();
                    updateCallStatusPill('warning');
                    setSpeakingSafetyState('Warning', true);
                    appendSpeakingWarningLog(data.message || 'You are going off-topic. Please answer the current IELTS question.');
                    showToast(data.message || 'Please stay on topic', 'error');
                }
                if (data.type === 'topic_ok') {
                    setSpeakingSafetyState('On-topic', false);
                }
                if (data.type === 'avatar') {
                    playAvatarVideo(data.video_url || '', data.status || 'Avatar updated');
                }
                if (data.type === 'terminated') {
                    speakingIsAwaitingExaminer = false;
                    clearSpeakingAutoNextTimer();
                    speakingSafetyTerminated = true;
                    setSpeakingSafetyState('Terminated', true);
                    appendSpeakingWarningLog(data.message || 'Session terminated for safety reasons.');
                    setSpeakingRealtimeStatus('Terminated');
                    stopSpeakingTimer();
                    updateSpeakingButtons();
                    if (speakingWs) {
                        speakingWsManualClose = true;
                        speakingWs.close();
                    }
                }
            } catch {
                setSpeakingRealtimeStatus('Invalid stream data');
            }
        };
    }

    async function startSpeakingRealtimeIfNeeded() {
        if (!speakingWsConnected || !speakingWs) return;
        speakingStreamBuffer = '';
        speakingTtsSentenceBuffer = '';
        speakingLastModeratedLength = 0;
        speakingLastSubmittedLength = (finalTranscript || '').trim().length;
        speakingIsAwaitingExaminer = true;
        clearSpeakingAutoNextTimer();
        const topic = activeSpeakingTopic?.topic || document.getElementById('speakingPrompt')?.textContent || 'General IELTS speaking topic';
        speakingWs.send(JSON.stringify({
            type: 'start',
            part: speakingCurrentPart,
            band_estimate: 5.5,
            topic: topic,
            avatar_fallback_url: getAvatarFallbackUrl()
        }));
    }

    function requestNextSpeakingQuestion(options = {}) {
        const silent = Boolean(options.silent);
        const source = options.source === 'auto' ? 'auto' : 'manual';

        if (!speakingWsConnected || !speakingWs) {
            if (!silent) showToast('Realtime speaking is not connected', 'error');
            return false;
        }
        if (speakingIsAwaitingExaminer) {
            return false;
        }

        const cleanFinal = (finalTranscript || '').trim();
        if (!cleanFinal || cleanFinal.length <= speakingLastSubmittedLength) {
            if (!silent) showToast('Please speak first, then request next question', 'error');
            return false;
        }

        const delta = cleanFinal.slice(speakingLastSubmittedLength).trim();
        if (!delta) {
            if (!silent) showToast('No new speech detected yet. Please continue speaking.', 'error');
            return false;
        }

        if (isLikelyNoiseTranscript(delta)) {
            if (!silent) showToast('Detected noisy audio. Please speak again in a quieter environment.', 'error');
            return false;
        }

        const deltaWords = delta.match(/[A-Za-z']+/g) || [];
        if (deltaWords.length < 2) {
            if (!silent) showToast('Please answer with at least one short sentence before continuing.', 'error');
            return false;
        }

        speakingIsAwaitingExaminer = true;
        clearSpeakingAutoNextTimer();
        speakingLastSubmittedLength = cleanFinal.length;
        speakingStreamBuffer = '';
        speakingTtsSentenceBuffer = '';
        updateSpeakingStreamText('');
        speakingWs.send(JSON.stringify({
            type: 'user_answer',
            text: delta,
            part: speakingCurrentPart,
            band_estimate: 5.5,
            topic: activeSpeakingTopic?.topic || document.getElementById('speakingPrompt')?.textContent || 'General IELTS speaking topic',
            avatar_fallback_url: getAvatarFallbackUrl()
        }));
        setSpeakingRealtimeStatus(source === 'auto' ? 'Auto-next: generating next question...' : 'Generating next question...');
        if (source === 'auto') updateAutoNextStatus('Auto-next sent your latest answer.');
        return true;
    }

    async function interruptSpeakingStream() {
        if (!speakingActive || speakingIsAwaitingExaminer) return;
        
        if (window.speechSynthesis) {
            window.speechSynthesis.cancel();
        }
        speakingTtsSentenceBuffer = '';

        const videoEl = document.getElementById('speakingAvatarVideo');
        if (videoEl) videoEl.classList.add('speaking-avatar-blur');
        
        const btn = document.getElementById('interruptSpeakingBtn');
        if (btn) btn.classList.add('interrupt-active');

        if (speakingWsConnected) {
            speakingWs.send(JSON.stringify({ type: 'interrupt' }));
            setSpeakingRealtimeStatus('Interrupting...');
        }
        
        if (didStreamId) {
            try {
                // Send an empty talk task to stop current stream through our proxy
                await fetch(`/api/speaking/did-stream/${didStreamId}/talk`, {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({
                        script: { type: 'text', input: ' ', provider: { type: 'microsoft', voice_id: 'en-US-JennyNeural' } },
                        session_id: didSessionId
                    })
                });
                speakingAiIsTalking = false;
            } catch (e) { console.error('Error interrupting D-ID stream', e); }
        }
        
        clearSpeakingAutoNextTimer();
        
        setTimeout(() => {
            if (btn) btn.classList.remove('interrupt-active');
            if (videoEl) videoEl.classList.remove('speaking-avatar-blur');
        }, 1500); // Remove blur and active state
    }

    function syncSpeakingAutoNextSettings() {
        const toggle = document.getElementById('speakingAutoNextToggle');
        const delaySelect = document.getElementById('speakingAutoNextDelay');

        speakingAutoNextEnabled = Boolean(toggle?.checked);
        const parsedDelay = Number(delaySelect?.value || '2000');
        speakingAutoNextDelayMs = Number.isFinite(parsedDelay) && parsedDelay >= 800 ? parsedDelay : 2000;

        if (!speakingAutoNextEnabled) clearSpeakingAutoNextTimer();

        updateAutoNextStatus(
            speakingAutoNextEnabled
                ? `Auto-next is enabled (${(speakingAutoNextDelayMs / 1000).toFixed(1)}s delay).`
                : 'Auto-next is off. Use Next Question manually.'
        );
    }

    function updateAutoNextStatus(text) {
        const status = document.getElementById('speakingAutoNextStatus');
        if (status) status.textContent = text;
    }

    function clearSpeakingAutoNextTimer() {
        if (!speakingAutoNextTimer) return;
        clearTimeout(speakingAutoNextTimer);
        speakingAutoNextTimer = null;
    }

    function scheduleAutoNextFromSpeech() {
        if (!speakingAutoNextEnabled || !speakingActive || speakingSafetyTerminated) return;
        if (!speakingWsConnected || !speakingWs || speakingAiIsTalking || speakingIsAwaitingExaminer) return;

        const cleanFinal = (finalTranscript || '').trim();
        if (!cleanFinal || cleanFinal.length <= speakingLastSubmittedLength) return;

        clearSpeakingAutoNextTimer();
        speakingAutoNextTimer = setTimeout(() => {
            speakingAutoNextTimer = null;
            requestNextSpeakingQuestion({ silent: true, source: 'auto' });
        }, speakingAutoNextDelayMs);

        updateAutoNextStatus(`Auto-next armed. Sending in ${(speakingAutoNextDelayMs / 1000).toFixed(1)}s if you stay silent.`);
    }

    function updateSpeakingPartStatus() {
        const partEl = document.getElementById('speakingCurrentPart');
        if (partEl) partEl.textContent = String(speakingCurrentPart);
    }

    function setSpeakingRealtimeStatus(text) {
        const el = document.getElementById('speakingRealtimeStatus');
        if (el) el.textContent = text;
    }

    function setAvatarStatus(text) {
        const el = document.getElementById('speakingAvatarStatus');
        if (el) el.textContent = text;
    }

    function getAvatarFallbackUrl() {
        const input = document.getElementById('speakingAvatarFallbackUrl');
        return normalizeGoogleDriveAvatarUrl(input?.value || '');
    }

    function normalizeGoogleDriveAvatarUrl(url) {
        const raw = (url || '').trim();
        if (!raw) return '';

        try {
            const parsed = new URL(raw);
            if (!parsed.hostname.includes('drive.google.com')) return raw;

            let fileId = '';
            const filePathMatch = parsed.pathname.match(/\/file\/d\/([^/]+)/i);
            if (filePathMatch?.[1]) fileId = filePathMatch[1];

            if (!fileId) fileId = parsed.searchParams.get('id') || '';
            if (!fileId) return raw;

            return `https://drive.google.com/uc?export=download&id=${encodeURIComponent(fileId)}`;
        } catch {
            return raw;
        }
    }

    function playAvatarVideo(videoUrl, statusText) {
        const avatar = document.getElementById('speakingAvatarVideo');
        if (!avatar) return;
        if (videoUrl) {
            avatar.src = videoUrl;
            avatar.muted = true;
            avatar.play().catch(() => {});
            setAvatarStatus(statusText || 'Playing provider stream');
            return;
        }
        const fallback = getAvatarFallbackUrl();
        if (fallback) {
            avatar.src = fallback;
            avatar.muted = true;
            avatar.play().catch(() => {});
            setAvatarStatus('Playing fallback avatar');
        } else {
            setAvatarStatus('No avatar source configured');
        }
    }

    function setSpeakingSafetyState(text, isAlert) {
        const safety = document.getElementById('speakingSafetyStatus');
        const inline = document.getElementById('speakingSafetyStateInline');
        if (safety) {
            safety.textContent = text;
            safety.style.color = isAlert ? '#ffb4b4' : '#4bfc61';
        }
        if (inline) inline.textContent = text;
    }

    function updateWarningCounter() {
        const el = document.getElementById('speakingTopicWarningCount');
        if (el) el.textContent = String(speakingWarningCount);
        // Also sync the analytics sidebar counter
        const analyticsEl = document.getElementById('speakingWarnings');
        if (analyticsEl) analyticsEl.textContent = String(speakingWarningCount);
    }

    function appendSpeakingWarningLog(message) {
        const log = document.getElementById('speakingWarningLog');
        if (!log || !message) return;
        const li = document.createElement('li');
        li.textContent = message;
        log.prepend(li);
        while (log.children.length > 6) {
            log.removeChild(log.lastElementChild);
        }
    }

    function sendLiveTranscriptForModeration() {
        if (!speakingLiveModerationEnabled) return;
        if (!speakingWsConnected || !speakingWs || speakingSafetyTerminated) return;
        if (!speakingActive) return;

        const clean = (finalTranscript || '').trim();
        if (!clean || clean.length <= speakingLastModeratedLength) return;

        if (window.speechSynthesis?.speaking) {
            speakingLastModeratedLength = clean.length;
            return;
        }

        const delta = clean.slice(speakingLastModeratedLength).trim();
        if (!delta) return;

        const deltaWords = delta.match(/[A-Za-z']+/g) || [];
        if (deltaWords.length < 4 || delta.length < 18) return;

        speakingLastModeratedLength = clean.length;
        speakingWs.send(JSON.stringify({
            type: 'candidate_live',
            text: delta,
            part: speakingCurrentPart,
            topic: activeSpeakingTopic?.topic || document.getElementById('speakingPrompt')?.textContent || 'General IELTS speaking topic'
        }));
    }

    function isLikelyNoiseTranscript(text) {
        const raw = String(text || '').trim();
        if (!raw) return true;

        const words = raw.toLowerCase().match(/[a-z']+/g) || [];
        if (!words.length) return true;
        if (words.length <= 3) return false;

        const meaningful = words.filter(w => w.length >= 2);
        if (!meaningful.length) return true;

        const vowelWords = meaningful.filter(w => /[aeiou]/.test(w));
        const vowelRatio = vowelWords.length / meaningful.length;
        if (vowelRatio < 0.35) return true;

        const uniqueRatio = new Set(meaningful).size / meaningful.length;
        if (meaningful.length >= 6 && uniqueRatio < 0.25) return true;

        return /(.)\1{4,}/.test(raw.replace(/\s+/g, ''));
    }

    function updateSpeakingStreamText(text) {
        const el = document.getElementById('speakingStreamText');
        if (el) el.textContent = text || '';
    }

    function speakCompletedSentencesFromBuffer() {
        if (!window.speechSynthesis || !speakingTtsSentenceBuffer) return;
        const sentenceRegex = /[^.!?]+[.!?]+/g;
        const matches = speakingTtsSentenceBuffer.match(sentenceRegex);
        if (!matches || !matches.length) return;

        const consumed = matches.join('');
        speakingTtsSentenceBuffer = speakingTtsSentenceBuffer.slice(consumed.length);
        for (const sentence of matches) {
            const cleaned = sentence.trim();
            if (!cleaned) continue;
            const utter = new SpeechSynthesisUtterance(cleaned);
            utter.lang = 'en-US';
            utter.onstart = () => { speakingAiIsTalking = true; };
            utter.onend = () => { speakingAiIsTalking = Boolean(window.speechSynthesis?.speaking); };
            utter.onerror = () => { speakingAiIsTalking = Boolean(window.speechSynthesis?.speaking); };
            speakingAiIsTalking = true;
            window.speechSynthesis.speak(utter);
        }
    }

    function speakRemainingSentenceBuffer() {
        if (!window.speechSynthesis) return;
        const text = (speakingTtsSentenceBuffer || '').trim();
        if (!text) return;
        const utter = new SpeechSynthesisUtterance(text);
        utter.lang = 'en-US';
        utter.onstart = () => { speakingAiIsTalking = true; };
        utter.onend = () => { speakingAiIsTalking = false; };
        utter.onerror = () => { speakingAiIsTalking = false; };
        speakingAiIsTalking = true;
        window.speechSynthesis.speak(utter);
    }

    function renderSpeakingPrefetchQuestions(questions) {
        const list = document.getElementById('speakingPrefetchList');
        if (!list) return;
        const safeList = Array.isArray(questions) ? questions.filter(Boolean).slice(0, 3) : [];
        if (!safeList.length) {
            list.innerHTML = '<li>Part 3 questions will be prepared during Part 2.</li>';
            return;
        }
        list.innerHTML = safeList.map(q => `<li>${escapeHtml(String(q))}</li>`).join('');
    }

    function escapeHtml(input) {
        return String(input ?? '')
            .replaceAll('&', '&amp;')
            .replaceAll('<', '&lt;')
            .replaceAll('>', '&gt;')
            .replaceAll('"', '&quot;')
            .replaceAll("'", '&#39;');
    }

    // --- D-ID WebRTC Integration ---
    let didPeerConnection = null;
    let didStreamId = null;
    let didSessionId = null;
    let didToken = null;

    async function fetchDidToken() {
        // [C# Backend Dev Note]: Implement GET /api/speaking/did-token in your ASP.NET Core Controller.
        // It should call D-ID API with your API key to create a session token and return it.
        // Example Response: { "token": "abc..." }
        try {
            const response = await fetch('/api/speaking/did-token');
            if (response.ok) {
                const data = await response.json();
                return data.token;
            }
            console.warn('Backend /api/speaking/did-token not ready, using fallback local mock if available.');
        } catch (e) {
            console.warn('Failed to fetch D-ID token', e);
        }
        return '';
    }

    async function startDidWebRtcSession() {
        didToken = 'proxy'; // bypass didToken since we use secure backend proxy
        try {
            const streamRes = await fetch('/api/speaking/did-stream/start', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({
                    source_url: document.getElementById('speakingAvatarFallbackUrl')?.value || 'https://images.unsplash.com/photo-1551836022-d5d88e9218df?auto=format&fit=crop&w=1600&q=80'
                })
            });

            if (!streamRes.ok) {
                let errorMsg = `HTTP Error ${streamRes.status}`;
                try {
                    const errData = await streamRes.json();
                    errorMsg = errData.message || errData.error?.message || errorMsg;
                } catch {}
                throw new Error(`D-ID server returned error: ${errorMsg}`);
            }

            const streamData = await streamRes.json();
            if (!streamData || !streamData.offer || !streamData.id) {
                throw new Error("Invalid or empty stream offer received from D-ID API.");
            }

            didStreamId = streamData.id;
            didSessionId = streamData.session_id;

            didPeerConnection = new RTCPeerConnection({ iceServers: [{ urls: 'stun:stun.l.google.com:19302' }] });
            didPeerConnection.ontrack = (event) => {
                const videoEl = document.getElementById('speakingAvatarVideo');
                if (videoEl) {
                    videoEl.srcObject = event.streams[0];
                    videoEl.classList.remove('speaking-avatar-blur');
                }
            };

            didPeerConnection.onicecandidate = async (event) => {
                if (event.candidate && didStreamId) {
                    try {
                        await fetch(`/api/speaking/did-stream/${didStreamId}/ice`, {
                            method: 'POST',
                            headers: { 'Content-Type': 'application/json' },
                            body: JSON.stringify({
                                candidate: event.candidate.candidate,
                                sdpMid: event.candidate.sdpMid,
                                sdpMLineIndex: event.candidate.sdpMLineIndex,
                                session_id: didSessionId
                            })
                        });
                    } catch (e) {
                        console.warn('Error sending ICE candidate', e);
                    }
                }
            };

            await didPeerConnection.setRemoteDescription(new RTCSessionDescription(streamData.offer));
            const answer = await didPeerConnection.createAnswer();
            await didPeerConnection.setLocalDescription(answer);

            const sdpRes = await fetch(`/api/speaking/did-stream/${didStreamId}/sdp`, {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ answer: answer, session_id: didSessionId })
            });

            if (!sdpRes.ok) {
                throw new Error("Failed to submit SDP answer to D-ID stream endpoint.");
            }

        } catch (e) {
            console.warn('D-ID WebRTC session initialization failed. Falling back to browser TTS.', e);
            // Ensure all D-ID properties are safely cleared to cleanly trigger the browser fallback speech
            didStreamId = null;
            didSessionId = null;
            if (didPeerConnection) {
                try { didPeerConnection.close(); } catch {}
                didPeerConnection = null;
            }
            const videoEl = document.getElementById('speakingAvatarVideo');
            if (videoEl) {
                videoEl.srcObject = null;
                videoEl.classList.add('speaking-avatar-blur');
            }
            setAvatarStatus('Offline (Using Browser TTS Fallback)');
        }
    }

    async function sendDidTalkRequest(text) {
        if (!text || !didStreamId) return;
        speakingAiIsTalking = true;
        try {
            await fetch(`/api/speaking/did-stream/${didStreamId}/talk`, {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({
                    script: { type: 'text', input: text, provider: { type: 'microsoft', voice_id: 'en-US-JennyNeural' } },
                    session_id: didSessionId
                })
            });
        } catch (e) { console.error('Error sending talk request', e); }
        setTimeout(() => { speakingAiIsTalking = false; }, text.split(' ').length * 400); // rough estimate
    }

    async function closeDidWebRtcSession() {
        if (didStreamId) {
            try {
                await fetch(`/api/speaking/did-stream/${didStreamId}`, {
                    method: 'DELETE',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ session_id: didSessionId })
                });
            } catch (e) {
                console.warn('Error closing D-ID stream session', e);
            }
        }
        if (didPeerConnection) {
            didPeerConnection.close();
            didPeerConnection = null;
        }
        didStreamId = null;
        didSessionId = null;
        const videoEl = document.getElementById('speakingAvatarVideo');
        if (videoEl) {
            videoEl.srcObject = null;
            videoEl.classList.add('speaking-avatar-blur');
        }
    }

    // ── Grade Dispute System ──
    window.lastWritingSubmissionId = null;

    window.openDisputeModal = function(type) {
        if (type === 'writing') {
            const modal = document.getElementById('disputeModal');
            if (!modal) return;
            const scoreEl = document.getElementById('disputeCurrentScore');
            const typeEl = document.getElementById('disputeSubmissionType');
            const idEl = document.getElementById('disputeSubmissionId');
            const reasonEl = document.getElementById('disputeReason');

            if (typeEl) typeEl.value = 'writing';
            if (reasonEl) reasonEl.value = '';

            const bandEl = document.getElementById('writingBandScore');
            if (scoreEl) scoreEl.textContent = 'Band ' + (bandEl ? bandEl.textContent : '--') + ' (Writing)';
            
            if (idEl) idEl.value = window.lastWritingSubmissionId || '';

            if (!idEl.value) {
                if (typeof showToast === 'function') {
                    showToast('No submission found to dispute. Please submit your work first.', 'error');
                } else {
                    alert('No submission found to dispute. Please submit your work first.');
                }
                return;
            }

            modal.style.display = 'flex';
        } else if (type === 'speaking') {
            const modalEl = document.getElementById('disputeSpeakingModal');
            if (!modalEl) return;
            const scoreEl = document.getElementById('disputeSpeakingCurrentScore');
            const idEl = document.getElementById('disputeSpeakingSubmissionId');
            const reasonEl = document.getElementById('disputeSpeakingReason');

            if (reasonEl) reasonEl.value = '';
            
            const sessionId = activeSpeakingSessionId || 0;
            if (idEl) idEl.value = sessionId || '';

            if (!idEl.value || idEl.value === '0') {
                if (typeof showToast === 'function') {
                    showToast('No submission found to dispute. Please submit your work first.', 'error');
                } else {
                    alert('No submission found to dispute. Please submit your work first.');
                }
                return;
            }

            const bsModal = new bootstrap.Modal(modalEl);
            bsModal.show();
        }
    };

    window.closeDisputeModal = function() {
        const modal = document.getElementById('disputeModal');
        if (modal) modal.style.display = 'none';
    };

    window.submitGradeDispute = async function() {
        const reason = document.getElementById('disputeReason').value.trim();
        const submissionId = parseInt(document.getElementById('disputeSubmissionId').value);
        const submissionType = document.getElementById('disputeSubmissionType').value;
        const submitBtn = document.getElementById('disputeSubmitBtn');

        if (!reason || reason.length < 20) {
            showToast('Please provide a detailed reason (at least 20 characters).', 'error');
            return;
        }

        if (!submissionId || !submissionType) {
            showToast('Missing submission details. Please try again.', 'error');
            return;
        }

        submitBtn.disabled = true;
        submitBtn.innerHTML = '<span class="animate-spin inline-block w-4 h-4 border-2 border-white border-t-transparent rounded-full"></span> Submitting...';

        try {
            const response = await fetch('/api/disputes/submit', {
                method: 'POST',
                credentials: 'include',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({
                    submissionType: submissionType,
                    submissionId: submissionId,
                    reason: reason
                })
            });

            const json = await response.json();

            if (response.ok && json.success) {
                closeDisputeModal();
                showToast('Dispute submitted successfully! A teacher will review your score.', 'success');
            } else {
                showToast(json.message || 'Failed to submit dispute. You may already have an open dispute for this submission.', 'error');
            }
        } catch (err) {
            console.error('Dispute submission error:', err);
            showToast('Network error. Please try again.', 'error');
        } finally {
            submitBtn.disabled = false;
            submitBtn.innerHTML = '<svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 19l9 2-9-18-9 18 9-2zm0 0v-8" /></svg> Submit Dispute';
        }
    };

    window.submitGradeDisputeSpeaking = async function() {
        const reason = document.getElementById('disputeSpeakingReason').value.trim();
        const submissionId = parseInt(document.getElementById('disputeSpeakingSubmissionId').value);
        const submitBtn = document.getElementById('disputeSpeakingSubmitBtn');

        if (!reason || reason.length < 20) {
            showToast('Please provide a detailed reason (at least 20 characters).', 'error');
            return;
        }

        if (!submissionId) {
            showToast('Missing submission details. Please try again.', 'error');
            return;
        }

        submitBtn.disabled = true;
        submitBtn.innerHTML = '<span class="spinner-border spinner-border-sm me-2" role="status" aria-hidden="true"></span>Submitting...';

        try {
            const response = await fetch('/api/disputes/submit', {
                method: 'POST',
                credentials: 'include',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({
                    submissionType: 'speaking',
                    submissionId: submissionId,
                    reason: reason
                })
            });

            const json = await response.json();

            if (response.ok && json.success) {
                const modalEl = document.getElementById('disputeSpeakingModal');
                if (window.jQuery && typeof window.jQuery(modalEl).modal === 'function') {
                    window.jQuery(modalEl).modal('hide');
                } else {
                    const bsModal = bootstrap.Modal.getInstance(modalEl) || new bootstrap.Modal(modalEl);
                    bsModal.hide();
                }
                showToast('Dispute submitted successfully! A teacher will review your score.', 'success');
            } else {
                showToast(json.message || 'Failed to submit dispute. You may already have an open dispute for this submission.', 'error');
            }
        } catch (err) {
            console.error('Dispute submission error:', err);
            showToast('Network error. Please try again.', 'error');
        } finally {
            submitBtn.disabled = false;
            submitBtn.innerHTML = '<i class="bi bi-send-fill me-2"></i>Submit Dispute';
        }
    };
</script>
