@{
    var skillType = (ViewData["SkillType"]?.ToString() ?? "reading").ToLower();
    var lessonId = ViewData["LessonId"]?.ToString() ?? "0";
}
<script>
    const lessonId = Number('@lessonId');
    const skillType = '@skillType';

    // ─── Pure CSS Toast Notification (no Tailwind) ───
    window.showToast = function(message, type = 'info') {
        let container = document.getElementById('examToastContainer');
        if (!container) {
            container = document.createElement('div');
            container.id = 'examToastContainer';
            container.className = 'exam-toast-container';
            document.body.appendChild(container);
        }

        const iconMap = {
            info:    'bi-info-circle-fill',
            success: 'bi-check-circle-fill',
            error:   'bi-exclamation-triangle-fill',
            warning: 'bi-exclamation-triangle-fill'
        };
        const titleMap = { info: 'Info', success: 'Success', error: 'Error', warning: 'Warning' };

        const toast = document.createElement('div');
        toast.className = 'exam-toast';
        toast.innerHTML = `
            <div class="exam-toast-icon ${type}"><i class="bi ${iconMap[type] || iconMap.info}"></i></div>
            <div class="exam-toast-body">
                <div class="exam-toast-title">${titleMap[type] || 'Info'}</div>
                <p class="exam-toast-msg">${message}</p>
            </div>
            <button class="exam-toast-close" aria-label="Close"><i class="bi bi-x-lg"></i></button>
        `;

        toast.querySelector('.exam-toast-close').addEventListener('click', () => {
            toast.classList.remove('show');
            toast.classList.add('hide');
            setTimeout(() => toast.remove(), 350);
        });

        container.appendChild(toast);
        requestAnimationFrame(() => toast.classList.add('show'));

        setTimeout(() => {
            if (toast.parentNode) {
                toast.classList.remove('show');
                toast.classList.add('hide');
                setTimeout(() => { if (toast.parentNode) toast.remove(); }, 350);
            }
        }, 4000);
    };

    // ─── Results Popup Modal Helper ───
    window.showResultsPopup = function({ iconClass = 'graded', title = 'Results', subtitle = '', stats = [], detailHtml = '', onClose = null }) {
        // Remove any existing popup
        document.getElementById('examResultsOverlay')?.remove();

        const overlay = document.createElement('div');
        overlay.id = 'examResultsOverlay';
        overlay.className = 'exam-results-overlay active';

        const statsHtml = stats.map(s =>
            `<div class="exam-stat-item">
                <div class="stat-value ${s.color || ''}">${s.value}</div>
                <div class="stat-label">${s.label}</div>
            </div>`
        ).join('');

        overlay.innerHTML = `
            <div class="exam-results-card">
                <div class="exam-results-header">
                    <div class="result-icon ${iconClass}">
                        <i class="bi ${iconClass === 'correct' ? 'bi-check-lg' : iconClass === 'incorrect' ? 'bi-x-lg' : 'bi-bar-chart-fill'}"></i>
                    </div>
                    <h3>${title}</h3>
                    ${subtitle ? `<p>${subtitle}</p>` : ''}
                </div>
                ${statsHtml ? `<div class="exam-results-stats">${statsHtml}</div>` : ''}
                ${detailHtml ? `<div class="exam-results-detail">${detailHtml}</div>` : ''}
                <div class="exam-results-footer">
                    <button class="exam-btn exam-btn-primary" id="closeResultsPopupBtn">
                        <i class="bi bi-arrow-right me-1"></i>Continue
                    </button>
                </div>
            </div>
        `;

        document.body.appendChild(overlay);

        // Close on button click
        document.getElementById('closeResultsPopupBtn').addEventListener('click', () => {
            overlay.classList.remove('active');
            setTimeout(() => overlay.remove(), 350);
            if (typeof onClose === 'function') onClose();
        });

        // Close on backdrop click
        overlay.addEventListener('click', (e) => {
            if (e.target === overlay) {
                overlay.classList.remove('active');
                setTimeout(() => overlay.remove(), 350);
                if (typeof onClose === 'function') onClose();
            }
        });
    };

    let speakingSeconds = 0;
    let speakingInterval = null;
    let speechRecognition = null;
    let finalTranscript = '';
    let micStream = null;
    let speakingActive = false;
    let currentReadingQuestion = null;
    let readingPracticeData = null; // Store current reading practice set
    let userReadingAnswers = {};     // Store reading answers
    let currentListeningQuestion = null;
    let listeningPracticeData = {};
    let userListeningAnswers = {};
    let activeListeningSection = 1;
    let writingPrompts = [];
    let speakingTopicsByPart = { "1": [], "2": [], "3": [] };
    let activeWritingPrompt = null;
    let activeSpeakingTopic = null;
    let activeSpeakingSessionId = 0;
    let writingHistoryCache = [];
    let speakingWs = null;
    let speakingWsConnected = false;
    let speakingCurrentPart = 1;
    let speakingStreamBuffer = '';
    let speakingTtsSentenceBuffer = '';
    let speakingWarningCount = 0;
    let speakingSafetyTerminated = false;
    let speakingLastModeratedLength = 0;
    let speakingLastSubmittedLength = 0;
    let speakingAiIsTalking = false;
    let speakingIsAwaitingExaminer = false;
    let speakingAutoNextEnabled = true;
    let speakingAutoNextDelayMs = 2000;
    let speakingAutoNextTimer = null;
    let speakingWsReconnectTimer = null;
    let speakingWsManualClose = false;
    const speakingLiveModerationEnabled = false;

    document.addEventListener('DOMContentLoaded', async () => {
        setupSkillLayout();
        await loadLesson();
        bindCommonActions();
    });

    function setupSkillLayout() { console.log("skillType is:", skillType);
        const listeningHub = document.getElementById('listeningHub');
        if (listeningHub) listeningHub.classList.toggle('d-none', skillType !== 'listening');
        const readingHub = document.getElementById('readingHub');
        if (readingHub) readingHub.classList.toggle('d-none', skillType !== 'reading');
        const writingHub = document.getElementById('writingHub');
        if (writingHub) writingHub.classList.toggle('d-none', skillType !== 'writing');
        const speakingHub = document.getElementById('speakingHub');
        if (speakingHub) speakingHub.classList.toggle('d-none', skillType !== 'speaking');

        if (skillType === 'reading') {
            loadReadingPassageList().then(() => {
                loadReadingPractice();
            });
            document.getElementById('readingPassageSelect')?.addEventListener('change', function() {
                loadReadingPractice(this.value);
            });
        }
        if (skillType === 'listening') loadListeningPractice();

        if (skillType === 'writing') {
            if (document.getElementById('editor')) {
                const refreshHistoryBtn = document.getElementById('refreshWritingHistoryBtn');
                if (refreshHistoryBtn) refreshHistoryBtn.addEventListener('click', loadWritingHistory);
                loadWritingPrompts();
                loadWritingHistory();
                return;
            }
            const textArea = document.getElementById('writingAnswer');
            const taskTypeSelect = document.getElementById('writingTaskType');
            taskTypeSelect.addEventListener('change', () => bindWritingPromptByTaskType(taskTypeSelect.value));
            textArea.addEventListener('input', () => {
                const words = (textArea.value.trim().match(/\S+/g) || []).length;
                document.getElementById('writingWordCount').textContent = `${words} words`;
                
                const errBanner = document.getElementById('writingValidationError');
                if (errBanner && !errBanner.classList.contains('hidden')) {
                    errBanner.classList.add('hidden');
                }
            });
            const refreshHistoryBtn = document.getElementById('refreshWritingHistoryBtn');
            if (refreshHistoryBtn) refreshHistoryBtn.addEventListener('click', loadWritingHistory);
            loadWritingPrompts();
            loadWritingHistory();
        }

        if (skillType === 'speaking') {
            console.log("Binding start btn:", document.getElementById("startSpeakingBtn")); document.getElementById("startSpeakingBtn")?.addEventListener("click", startSpeakingSession);
            document.getElementById('stopSpeakingBtn')?.addEventListener('click', stopSpeakingTimer);
            document.getElementById('nextQuestionBtn')?.addEventListener('click', requestNextSpeakingQuestion);
            document.getElementById('interruptSpeakingBtn')?.addEventListener('click', interruptSpeakingStream);
            document.getElementById('speakingPart')?.addEventListener('change', onSpeakingPartChanged);
            document.getElementById('speakingAutoNextToggle')?.addEventListener('change', syncSpeakingAutoNextSettings);
            document.getElementById('speakingAutoNextDelay')?.addEventListener('change', syncSpeakingAutoNextSettings);
            
            const avatarInput = document.getElementById('speakingAvatarFallbackUrl');
            const previewContainer = document.getElementById('avatarPreviewContainer');
            const previewImg = document.getElementById('speakingAvatarPreviewImg');
            if (avatarInput && previewContainer && previewImg) {
                const updatePreview = () => {
                    const val = (avatarInput.value || '').trim();
                    if (val) {
                        previewImg.src = normalizeGoogleDriveAvatarUrl(val);
                        previewContainer.style.display = 'block';
                    } else {
                        previewContainer.style.display = 'none';
                    }
                };
                avatarInput.addEventListener('input', updatePreview);
                avatarInput.addEventListener('change', updatePreview);
                updatePreview(); // initial bind
            }

            document.getElementById('toggleCameraBtn')?.addEventListener('click', async () => {
                const video = document.getElementById('speakingCameraPreview');
                const placeholder = document.getElementById('speakingCameraPlaceholder');
                const btn = document.getElementById('toggleCameraBtn');
                if (video && video.style.display === 'none') {
                    try {
                        const stream = await navigator.mediaDevices.getUserMedia({ video: true });
                        video.srcObject = stream;
                        video.style.display = 'block';
                        if (placeholder) placeholder.style.display = 'none';
                        if (btn) btn.innerHTML = '<i class="bi bi-camera-video-fill"></i>';
                    } catch { console.warn('Camera not available'); }
                } else if (video) {
                    const tracks = video.srcObject?.getTracks();
                    tracks?.forEach(t => t.stop());
                    video.srcObject = null;
                    video.style.display = 'none';
                    if (placeholder) placeholder.style.display = 'flex';
                    if (btn) btn.innerHTML = '<i class="bi bi-camera-video-off-fill"></i>';
                }
            });

            document.getElementById('toggleMicBtn')?.addEventListener('click', () => {
                const btn = document.getElementById('toggleMicBtn');
                if (micStream) {
                    const audioTracks = micStream.getAudioTracks();
                    if (audioTracks.length > 0) {
                        const isEnabled = audioTracks[0].enabled;
                        audioTracks[0].enabled = !isEnabled;
                        if (btn) {
                            btn.innerHTML = !isEnabled ? '<i class="bi bi-mic-fill"></i>' : '<i class="bi bi-mic-mute-fill"></i>';
                            btn.classList.toggle('danger', isEnabled);
                        }
                    }
                }
            });

            initializeSpeechRecognition();
            syncSpeakingAutoNextSettings();
            updateSpeakingButtons();
            loadSpeakingTopics();
            initializeSpeakingRealtime();
        }
    }

    async function loadReadingPractice(passageId = null) {
        const target = document.getElementById('readingDynamic');
        target.innerHTML = '<p class="text-muted mb-0">Loading reading set...</p>';
        try {
            userReadingAnswers = {};
            const url = passageId ? `/reading/passage/${passageId}` : '/reading/practice/band_5_6';
            const response = await api(url, { method: 'GET' });
            const set = response?.data;
            if (!response?.success || !set || !set.questions || set.questions.length === 0) {
                target.innerHTML = '<div class="alert alert-warning mb-0">No reading practice item available.</div>';
                return;
            }
            
            readingPracticeData = set;
            
            // Sync dropdown value to reflect selection
            const selectEl = document.getElementById('readingPassageSelect');
            if (selectEl && !passageId) {
                selectEl.value = set.passage?.passageId || '';
            }
            
            // Set passage details
            const content = document.getElementById('lessonContentReading');
            if (set.passage?.passageTitle || set.passage?.passageText) {
                content.innerHTML = `<h5 class="fw-bold">${set.passage.passageTitle || 'Reading passage'}</h5><div>${set.passage.passageText || ''}</div>`;
            }
            
            // Handle image rendering
            const imageWrap = document.getElementById('readingPassageImageWrap');
            const imgEl = document.getElementById('readingPassageImage');
            const captionEl = document.getElementById('readingPassageImageCaption');
            if (imageWrap && imgEl) {
                if (set.passage?.imageUrl) {
                    imgEl.src = set.passage.imageUrl;
                    if (captionEl) {
                        captionEl.textContent = set.passage.passageTitle || 'Passage Illustration';
                    }
                    imageWrap.style.display = 'block';
                } else {
                    imageWrap.style.display = 'none';
                    imgEl.src = '';
                }
            }

            // Render all questions and navigation
            renderReadingQuestions(set.questions);
            renderReadingQuestionNav(set.questions);
        } catch (err) {
            console.error(err);
            target.innerHTML = '<div class="alert alert-danger mb-0">Failed to load reading set.</div>';
        }
    }

    async function loadReadingPassageList() {
        const selectEl = document.getElementById('readingPassageSelect');
        if (!selectEl) return;
        try {
            const response = await api('/reading/passages', { method: 'GET' });
            if (response?.success && Array.isArray(response.data)) {
                selectEl.innerHTML = '';
                response.data.forEach(p => {
                    const opt = document.createElement('option');
                    opt.value = p.passageId;
                    opt.textContent = `[${p.difficultyLevel?.toUpperCase()?.replace('BAND_', 'Band ') || 'Practice'}] ${p.passageTitle}`;
                    selectEl.appendChild(opt);
                });
            } else {
                selectEl.innerHTML = '<option value="">-- No tests found --</option>';
            }
        } catch (e) {
            console.error("Failed to load reading passages list:", e);
            selectEl.innerHTML = '<option value="">-- Failed to load tests --</option>';
        }
    }



    function renderReadingQuestions(questions) {
        const target = document.getElementById('readingDynamic');
        if (!questions || questions.length === 0) {
            target.innerHTML = '<p class="text-muted">No questions found.</p>';
            return;
        }

        let html = '<div class="d-flex flex-column gap-4">';
        questions.forEach(question => {
            const options = Array.isArray(question.options) ? question.options : [];
            const savedAnswer = userReadingAnswers[question.questionId] || '';

            let optionGroup = '';
            if (options.length > 0) {
                optionGroup = `
                    <div class="d-flex flex-column gap-2 mt-3">
                        ${options.map((opt, idx) => {
                            const optionLetter = String.fromCharCode(65 + idx);
                            const isChecked = savedAnswer === optionLetter ? 'checked' : '';
                            const isSelectedClass = savedAnswer === optionLetter ? 'selected' : '';
                            return `
                                <label class="exam-option w-100 mb-0 ${isSelectedClass}" data-q-id="${question.questionId}">
                                    <input class="d-none" type="radio" name="reading_ans_${question.questionId}" value="${optionLetter}" ${isChecked}>
                                    <div class="exam-option-label">${optionLetter}</div>
                                    <div style="padding-top:2px;">${opt}</div>
                                </label>`;
                        }).join('')}
                    </div>`;
            } else {
                optionGroup = `
                    <div class="mt-3">
                        <input id="reading_ans_${question.questionId}" 
                               class="form-control exam-input reading-text-input" 
                               type="text"
                               placeholder="Type your answer here..." 
                               value="${escapeHtml(savedAnswer)}"
                               data-q-id="${question.questionId}">
                    </div>`;
            }

            html += `
                <div class="reading-question-card exam-card p-4" id="reading_q_card_${question.questionId}">
                    <div class="d-flex align-items-start gap-2">
                        <span class="badge bg-secondary me-2">Q${question.questionNumber}</span>
                        <div class="flex-grow-1">
                            <label class="form-label fw-bold mb-1" style="font-size:1.05rem;">${question.questionText || ''}</label>
                            ${optionGroup}
                            <div class="mt-2 text-muted" style="font-size: 0.75rem;">
                                <i class="bi bi-tag me-1"></i>Type: ${question.questionType || 'reading'}
                            </div>
                        </div>
                    </div>
                </div>`;
        });
        html += '</div>';

        target.innerHTML = html;

        // Bind radio change event
        target.querySelectorAll('.exam-option input').forEach((input) => {
            input.addEventListener('change', function() {
                const qId = this.getAttribute('name').replace('reading_ans_', '');
                target.querySelectorAll(`.exam-option[data-q-id="${qId}"]`).forEach(el => el.classList.remove('selected'));
                const selected = this.closest('.exam-option');
                if (selected) selected.classList.add('selected');
                userReadingAnswers[qId] = this.value;
                updateReadingQuestionNav();
            });
        });

        // Bind text input event
        target.querySelectorAll('.reading-text-input').forEach((input) => {
            input.addEventListener('input', function() {
                const qId = this.getAttribute('data-q-id');
                userReadingAnswers[qId] = this.value.trim();
                updateReadingQuestionNav();
            });
        });
    }

    function renderReadingQuestionNav(questions) {
        const navEl = document.getElementById('readingQuestionNav');
        if (!navEl) return;

        let btnHtml = '';
        questions.forEach(question => {
            const qId = question.questionId;
            const isAnswered = !!userReadingAnswers[qId];
            
            let btnClass = 'btn btn-sm m-1 rounded-circle ';
            if (isAnswered) {
                btnClass += 'btn-success text-white';
            } else {
                btnClass += 'btn-outline-secondary';
            }
            
            btnHtml += `
                <button class="${btnClass}" style="width:36px;height:36px;font-size:0.75rem;" 
                        onclick="scrollToReadingQuestion(${qId})">
                    ${question.questionNumber}
                </button>`;
        });

        navEl.innerHTML = `
            <div class="d-flex align-items-center gap-3 border-bottom pb-2 mb-3">
                <span class="small fw-bold text-primary" style="min-width:75px;">Questions</span>
                <div class="d-flex flex-wrap flex-grow-1">
                    ${btnHtml}
                </div>
            </div>`;
    }

    function updateReadingQuestionNav() {
        if (!readingPracticeData || !readingPracticeData.questions) return;
        renderReadingQuestionNav(readingPracticeData.questions);
    }

    window.scrollToReadingQuestion = function(qId) {
        const targetCard = document.getElementById(`reading_q_card_${qId}`);
        if (targetCard) {
            targetCard.scrollIntoView({ behavior: 'smooth', block: 'center' });
            targetCard.classList.add('highlight-flash');
            setTimeout(() => {
                targetCard.classList.remove('highlight-flash');
            }, 1500);
        }
    };

    async function loadListeningPractice(sectionNum = 1) {
        saveCurrentListeningSectionAnswers();
        activeListeningSection = sectionNum;

        // Ensure section buttons reflect active state
        document.querySelectorAll('.listening-section-btn').forEach(btn => {
            const sec = Number(btn.getAttribute('data-section'));
            if (sec === sectionNum) {
                btn.classList.add('active', 'exam-btn-primary');
                btn.classList.remove('exam-btn-outline');
            } else {
                btn.classList.remove('active', 'exam-btn-primary');
                btn.classList.add('exam-btn-outline');
            }
        });

        const target = document.getElementById('listeningDynamic');
        target.innerHTML = '<p class="text-muted mb-0">Loading Section ' + sectionNum + ' questions...</p>';

        try {
            let set;
            if (listeningPracticeData[sectionNum]) {
                set = listeningPracticeData[sectionNum];
            } else {
                const response = await api(`/listening/material/${2000 + sectionNum}`, { method: 'GET' });
                if (!response?.success || !response.data) {
                    target.innerHTML = '<div class="alert alert-warning mb-0">No listening practice item available for Section ' + sectionNum + '.</div>';
                    return;
                }
                set = response.data;
                listeningPracticeData[sectionNum] = set;
            }

            const audioEl = document.getElementById('listeningAudio');
            if (audioEl) {
                if (set.material?.audioUrl) {
                    audioEl.src = set.material.audioUrl;
                    audioEl.load();
                } else {
                    audioEl.removeAttribute('src');
                }
                const speedEl = document.getElementById('audioSpeed');
                if (speedEl && audioEl.src) {
                    audioEl.playbackRate = parseFloat(speedEl.value || '1');
                }
            }

            renderListeningQuestions(set.questions);
            renderListeningQuestionNav();
        } catch (err) {
            console.error(err);
            target.innerHTML = '<div class="alert alert-danger mb-0">Failed to load listening set for Section ' + sectionNum + '.</div>';
        }
    }

    function saveCurrentListeningSectionAnswers() {
        if (!listeningPracticeData[activeListeningSection]) return;
        const questions = listeningPracticeData[activeListeningSection].questions || [];
        questions.forEach(q => {
            if (q.options && q.options.length > 0) {
                const checkedRadio = document.querySelector(`input[name="listening_ans_${q.questionId}"]:checked`);
                if (checkedRadio) {
                    userListeningAnswers[q.questionId] = checkedRadio.value;
                }
            } else {
                const textInput = document.getElementById(`listening_ans_${q.questionId}`);
                if (textInput) {
                    userListeningAnswers[q.questionId] = textInput.value.trim();
                }
            }
        });
    }

    function renderListeningQuestions(questions) {
        const target = document.getElementById('listeningDynamic');
        if (!questions || questions.length === 0) {
            target.innerHTML = '<p class="text-muted">No questions found in this section.</p>';
            return;
        }

        let html = '<div class="d-flex flex-column gap-4">';
        questions.forEach(question => {
            const options = Array.isArray(question.options) ? question.options : [];
            const savedAnswer = userListeningAnswers[question.questionId] || '';

            let optionGroup = '';
            if (options.length > 0) {
                optionGroup = `
                    <div class="d-flex flex-column gap-2 mt-3">
                        ${options.map((opt, idx) => {
                            const optionLetter = String.fromCharCode(65 + idx);
                            const isChecked = savedAnswer === optionLetter ? 'checked' : '';
                            const isSelectedClass = savedAnswer === optionLetter ? 'selected' : '';
                            return `
                                <label class="exam-option w-100 mb-0 ${isSelectedClass}" data-q-id="${question.questionId}">
                                    <input class="d-none" type="radio" name="listening_ans_${question.questionId}" value="${optionLetter}" ${isChecked}>
                                    <div class="exam-option-label">${optionLetter}</div>
                                    <div style="padding-top:2px;">${opt}</div>
                                </label>`;
                        }).join('')}
                    </div>`;
            } else {
                optionGroup = `
                    <div class="mt-3">
                        <input id="listening_ans_${question.questionId}" 
                               class="form-control exam-input listening-text-input" 
                               type="text"
                               placeholder="Type your answer here..." 
                               value="${escapeHtml(savedAnswer)}"
                               data-q-id="${question.questionId}">
                    </div>`;
            }

            html += `
                <div class="listening-question-card border-bottom pb-4 mb-2" id="q_card_${question.questionId}">
                    <div class="d-flex align-items-start gap-2">
                        <span class="badge bg-secondary me-2">Q${question.questionOrder}</span>
                        <div class="flex-grow-1">
                            <label class="form-label fw-bold mb-1" style="font-size:1.05rem;">${question.questionText || ''}</label>
                            ${optionGroup}
                        </div>
                    </div>
                </div>`;
        });
        html += '</div>';

        target.innerHTML = html;

        target.querySelectorAll('.exam-option input').forEach((input) => {
            input.addEventListener('change', function() {
                const qId = this.getAttribute('name').replace('listening_ans_', '');
                target.querySelectorAll(`.exam-option[data-q-id="${qId}"]`).forEach(el => el.classList.remove('selected'));
                const selected = this.closest('.exam-option');
                if (selected) selected.classList.add('selected');
                userListeningAnswers[qId] = this.value;
                renderListeningQuestionNav();
            });
        });

        target.querySelectorAll('.listening-text-input').forEach((input) => {
            input.addEventListener('input', function() {
                const qId = this.getAttribute('data-q-id');
                userListeningAnswers[qId] = this.value.trim();
                renderListeningQuestionNav();
            });
        });
    }

    function renderListeningQuestionNav() {
        const navEl = document.getElementById('listeningQuestionNav');
        if (!navEl) return;

        let html = '<div class="d-flex flex-column gap-3 w-100">';
        for (let sec = 1; sec <= 4; sec++) {
            const startQ = (sec - 1) * 5 + 1;
            const endQ = sec * 5;
            
            let btnHtml = '';
            for (let q = startQ; q <= endQ; q++) {
                const qId = 2000 + q;
                const isAnswered = !!userListeningAnswers[qId];
                const isActiveSection = sec === activeListeningSection;
                
                let btnClass = 'btn btn-sm m-1 rounded-circle ';
                if (isAnswered) {
                    btnClass += 'btn-success text-white';
                } else if (isActiveSection) {
                    btnClass += 'btn-outline-primary';
                } else {
                    btnClass += 'btn-outline-secondary';
                }
                
                btnHtml += `
                    <button class="${btnClass}" style="width:36px;height:36px;font-size:0.75rem;" 
                            onclick="switchListeningSectionAndFocus(${sec}, ${qId})">
                        ${q}
                    </button>`;
            }
            
            const isSecActive = sec === activeListeningSection;
            html += `
                <div class="d-flex align-items-center gap-3 border-bottom pb-2">
                    <span class="small fw-bold ${isSecActive ? 'text-primary' : 'text-muted'}" style="min-width:75px;">Section ${sec}</span>
                    <div class="d-flex flex-wrap flex-grow-1">
                        ${btnHtml}
                    </div>
                </div>`;
        }
        
        html += '</div>';
        navEl.innerHTML = html;
    }

    window.switchListeningSectionAndFocus = function(sec, qId) {
        if (sec !== activeListeningSection) {
            loadListeningPractice(sec).then(() => {
                setTimeout(() => {
                    const card = document.getElementById(`q_card_${qId}`);
                    if (card) {
                        card.scrollIntoView({ behavior: 'smooth', block: 'center' });
                        card.classList.add('bg-primary-light');
                        setTimeout(() => card.classList.remove('bg-primary-light'), 1500);
                    }
                }, 100);
            });
        } else {
            const card = document.getElementById(`q_card_${qId}`);
            if (card) {
                card.scrollIntoView({ behavior: 'smooth', block: 'center' });
                card.classList.add('bg-primary-light');
                setTimeout(() => card.classList.remove('bg-primary-light'), 1500);
            }
        }
    };

    function estimateIeltsListeningBand(correctCount) {
        if (correctCount >= 19) return "9.0";
        if (correctCount >= 17) return "8.5";
        if (correctCount >= 15) return "8.0";
        if (correctCount >= 14) return "7.5";
        if (correctCount >= 12) return "7.0";
        if (correctCount >= 10) return "6.5";
        if (correctCount >= 8) return "6.0";
        if (correctCount >= 6) return "5.5";
        if (correctCount >= 5) return "5.0";
        if (correctCount >= 4) return "4.5";
        if (correctCount >= 3) return "4.0";
        if (correctCount >= 1) return "3.5";
        return "1.0";
    }

    async function loadWritingPrompts() {
        const select = document.getElementById('writingTaskType');
        const promptBox = document.getElementById('writingPromptBox');
        select.innerHTML = '<option value="">Loading...</option>';
        try {
            const response = await api('/writing/prompts', { method: 'GET' });
            writingPrompts = response?.success ? (response.data || []) : [];
            if (!writingPrompts.length) {
                select.innerHTML = '<option value="">No prompts</option>';
                promptBox.textContent = 'No writing prompt available.';
                return;
            }
            select.innerHTML = `
                <option value="1">Task 1 - Describe visual information (>=150 words)</option>
                <option value="2">Task 2 - Essay (>=250 words)</option>
            `;
            bindWritingPromptByTaskType('1');
        } catch {
            select.innerHTML = '<option value="">Load failed</option>';
            promptBox.textContent = 'Failed to load writing prompts.';
