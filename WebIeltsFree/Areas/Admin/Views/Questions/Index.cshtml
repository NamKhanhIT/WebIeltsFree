@model IEnumerable<WebIeltsFree.Models.Question>

@{
    ViewData["Title"] = "Question Bank";
    var searchString = ViewBag.SearchString as string;
    var sectionFilter = ViewBag.SectionFilter as string;
}

<div class="row mb-4">
    <div class="col-12 d-flex justify-content-between align-items-center">
        <div>
            <h1 class="fs-3 fw-bold mb-1">Question Bank</h1>
            <p class="text-muted mb-0">Manage individual test questions and answers.</p>
        </div>
        <div class="d-flex gap-2">
            <a asp-action="BulkImport" class="btn btn-outline-primary">
                <i class="ti ti-upload me-2"></i>Bulk Import
            </a>
            <a asp-action="Create" class="btn btn-primary">
                <i class="ti ti-plus me-2"></i>New Question
            </a>
        </div>
    </div>
</div>

<div class="card shadow-sm border-0">
    <div class="card-header bg-white border-bottom-0 pt-4 pb-0 px-4">
        <form method="get" class="row g-3 align-items-center">
            <div class="col-md-4">
                <div class="input-group">
                    <span class="input-group-text bg-light border-end-0"><i class="ti ti-search text-muted"></i></span>
                    <input type="text" name="searchString" class="form-control border-start-0" placeholder="Search questions..." value="@searchString">
                </div>
            </div>
            <div class="col-md-3">
                <select name="sectionFilter" class="form-select" onchange="this.form.submit()">
                    <option value="">All Sections</option>
                    <option value="listening" selected="@(sectionFilter == "listening")">Listening</option>
                    <option value="reading" selected="@(sectionFilter == "reading")">Reading</option>
                </select>
            </div>
            <div class="col-md-2">
                <button type="submit" class="btn btn-outline-secondary w-100">Filter</button>
            </div>
        </form>
    </div>
    <div class="card-body p-0 mt-3">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light text-muted small">
                    <tr>
                        <th class="px-4 py-3 fw-semibold">ID</th>
                        <th class="py-3 fw-semibold">Section ID</th>
                        <th class="py-3 fw-semibold">Difficulty</th>
                        <th class="py-3 fw-semibold" style="width: 40%;">Question Text</th>
                        <th class="py-3 fw-semibold">Correct Answer</th>
                        <th class="px-4 py-3 fw-semibold text-end">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!Model.Any())
                    {
                        <tr>
                            <td colspan="6" class="text-center py-5 text-muted">
                                <i class="ti ti-help-circle fs-1 mb-2 d-block"></i>
                                No questions found matching your criteria.
                            </td>
                        </tr>
                    }
                    else
                    {
                        foreach (var item in Model)
                        {
                            <tr>
                                <td class="px-4 text-muted small">#@item.QuestionId</td>
                                <td>
                                    <span class="badge bg-light text-dark border px-2 py-1 text-uppercase">Section @item.SectionId</span>
                                </td>
                                <td><span class="text-muted small">@item.Difficulty</span></td>
                                <td>
                                    <div class="text-truncate" style="max-width: 350px;">
                                        @item.QuestionText
                                    </div>
                                </td>
                                <td>
                                    <span class="fw-medium text-success">@(item.Answer?.CorrectAnswer ?? "-")</span>
                                </td>
                                <td class="px-4 text-end">
                                    <div class="btn-group">
                                        <a asp-action="Edit" asp-route-id="@item.QuestionId" class="btn btn-sm btn-light btn-icon text-primary" title="Edit question">
                                            <i class="ti ti-edit"></i>
                                        </a>
                                        <form asp-action="Delete" method="post" onsubmit="return confirm('Are you sure you want to delete this question?');" class="d-inline">
                                            <input type="hidden" name="id" value="@item.QuestionId" />
                                            <button type="submit" class="btn btn-sm btn-light btn-icon text-danger rounded-start-0" title="Delete question">
                                                <i class="ti ti-trash"></i>
                                            </button>
                                        </form>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
        
        @if (ViewBag.TotalPages > 1)
        {
            <div class="px-4 py-3 border-top d-flex justify-content-between align-items-center">
                <span class="text-muted small">Page @ViewBag.CurrentPage of @ViewBag.TotalPages</span>
                <nav aria-label="Page navigation">
                    <ul class="pagination pagination-sm mb-0">
                        @for (int i = 1; i <= ViewBag.TotalPages; i++)
                        {
                            <li class="page-item @(i == ViewBag.CurrentPage ? "active" : "")">
                                <a class="page-link" asp-action="Index" asp-route-pageNumber="@i" asp-route-searchString="@searchString" asp-route-sectionFilter="@sectionFilter">@i</a>
                            </li>
                        }
                    </ul>
                </nav>
            </div>
        }
    </div>
</div>
