@model WebIeltsFree.Models.SpeakingTopic
@{
    ViewData["Title"] = "Edit Speaking Topic";
}

<div class="row justify-content-center">
    <div class="col-md-10 col-lg-8">
        <div class="card shadow-sm border-0 mb-4">
            <div class="card-header bg-white py-3 d-flex justify-content-between align-items-center">
                <h4 class="mb-0 h5 fw-bold">Edit Speaking Topic</h4>
                <span class="badge @(Model.Status == "published" ? "bg-success" : Model.Status == "pending_review" ? "bg-warning text-dark" : "bg-secondary")">
                    @Model.Status.Replace("_", " ").ToUpper()
                </span>
            </div>
            <div class="card-body p-4">
                <form asp-action="Edit" method="post">
                    <input type="hidden" asp-for="TopicId" />
                    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                    @if (Model.Status == "published" || Model.Status == "rejected")
                    {
                        <div class="alert alert-warning border-0 shadow-sm mb-4">
                            <i class="ti ti-alert-triangle me-2"></i> Editing this topic will reset its status to <strong>Draft</strong> and it will require peer review again.
                        </div>
                    }

                    <div class="row mb-4">
                        <div class="col-md-6">
                            <label class="form-label fw-semibold">Speaking Part</label>
                            <select name="partNumber" class="form-select shadow-none">
                                <option value="1" selected="@(Model.PartNumber == 1)">Part 1 (Introduction &amp; Interview)</option>
                                <option value="2" selected="@(Model.PartNumber == 2)">Part 2 (Long Turn / Cue Card)</option>
                                <option value="3" selected="@(Model.PartNumber == 3)">Part 3 (Two-way Discussion)</option>
                            </select>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-semibold">Target Band <span class="text-danger">*</span></label>
                            <input type="number" name="targetBand" class="form-control shadow-none" value="@Model.TargetBand" min="0" max="9" step="0.5" required />
                        </div>
                    </div>

                    <div class="mb-4">
                        <label class="form-label fw-semibold">Topic Name <span class="text-danger">*</span></label>
                        <textarea name="topicName" class="form-control shadow-none" rows="4" required>@Model.TopicName</textarea>
                    </div>

                    <div class="d-flex flex-wrap gap-2 mt-5">
                        <button type="submit" name="action" value="save_draft" class="btn btn-info text-white px-4 fw-bold">Save Changes (Draft)</button>
                        <button type="submit" name="action" value="submit_review" class="btn btn-warning px-4 fw-bold text-dark">Submit for Peer Review</button>
                        <a asp-action="Index" class="btn btn-light px-4 ms-auto">Cancel</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
