@model WebIeltsFree.Models.GradeDispute
@{
    ViewData["Title"] = "Dispute Details";
    var currentUserId = User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value;
    bool canResolve = Model.Status == "under_review" && (User.IsInRole("admin") || Model.ReviewedBy.ToString() == currentUserId);
}

<div class="row mb-4">
    <div class="col-12 d-flex justify-content-between align-items-center">
        <h4 class="mb-0 fw-bold">Dispute #@Model.DisputeId</h4>
        <a asp-action="Index" class="btn btn-outline-secondary btn-sm"><i class="ti ti-arrow-left me-1"></i> Back to List</a>
    </div>
</div>

<div class="row">
    <div class="col-lg-4">
        <div class="card shadow-sm border-0 mb-4">
            <div class="card-header bg-white py-3">
                <h5 class="mb-0 fw-bold">Dispute Info</h5>
            </div>
            <div class="card-body p-0">
                <ul class="list-group list-group-flush">
                    <li class="list-group-item p-4">
                        <div class="d-flex align-items-center gap-3 mb-3">
                            <div class="avatar avatar-md rounded-circle bg-primary-subtle text-primary d-flex align-items-center justify-content-center fw-bold">
                                @(Model.User?.Profile?.FullName?.FirstOrDefault().ToString() ?? Model.User?.Email.FirstOrDefault().ToString().ToUpper() ?? "?")
                            </div>
                            <div>
                                <h6 class="mb-0 fw-bold">@(Model.User?.Profile?.FullName ?? "Unknown")</h6>
                                <small class="text-muted">Student</small>
                            </div>
                        </div>
                        
                        <div class="mb-3">
                            <span class="d-block text-muted small fw-semibold text-uppercase mb-1">Status</span>
                            <span class="badge @(Model.Status == "pending" ? "bg-primary" : Model.Status == "under_review" ? "bg-warning text-dark" : Model.Status == "resolved" ? "bg-success" : "bg-danger") px-3 py-2 rounded-pill">
                                @Model.Status.ToUpper().Replace("_", " ")
                            </span>
                        </div>
                        
                        <div class="mb-3">
                            <span class="d-block text-muted small fw-semibold text-uppercase mb-1">Reason for Dispute</span>
                            <blockquote class="border-start border-3 border-primary ps-3 py-1 bg-light text-dark fst-italic small mb-0 rounded-end">
                                @Model.Reason
                            </blockquote>
                        </div>
                        
                        <div>
                            <span class="d-block text-muted small fw-semibold text-uppercase mb-1">Timeline</span>
                            <div class="small text-muted">
                                <div><i class="ti ti-calendar me-1"></i> Submitted: @Model.CreatedAt.ToString("g")</div>
                                @if (Model.ResolvedAt.HasValue)
                                {
                                    <div class="mt-1"><i class="ti ti-check me-1"></i> Resolved: @Model.ResolvedAt.Value.ToString("g")</div>
                                }
                            </div>
                        </div>
                    </li>
                </ul>
            </div>
            <div class="card-footer bg-light p-3 text-center">
                @if (Model.Status == "pending")
                {
                    <form asp-action="Claim" asp-route-id="@Model.DisputeId" method="post">
                        <button type="submit" class="btn btn-primary w-100">Claim This Dispute</button>
                    </form>
                }
                else if (canResolve)
                {
                    <a asp-action="Edit" asp-route-id="@Model.DisputeId" class="btn btn-warning w-100 fw-bold">Review &amp; Resolve</a>
                }
                else if (Model.ReviewedBy.HasValue)
                {
                    <div class="text-muted small">
                        <i class="ti ti-lock me-1"></i> Claimed by @(Model.Reviewer?.Profile?.FullName ?? "another teacher")
                    </div>
                }
            </div>
        </div>
        
        @if (Model.Status == "resolved" || Model.Status == "rejected")
        {
            <div class="card shadow-sm border-0 mb-4 border-start border-success border-4">
                <div class="card-header bg-white py-3">
                    <h5 class="mb-0 fw-bold">Resolution Notes</h5>
                </div>
                <div class="card-body">
                    @if (Model.RevisedScore.HasValue)
                    {
                        <div class="mb-3">
                            <span class="badge bg-success-subtle text-success fs-6 px-3 py-2">Score changed to: @Model.RevisedScore</span>
                        </div>
                    }
                    else if (Model.Status == "resolved")
                    {
                        <div class="mb-3">
                            <span class="badge bg-secondary-subtle text-secondary fs-6 px-3 py-2">Original score upheld</span>
                        </div>
                    }
                    <p class="text-dark small lh-lg">@Model.TeacherNotes</p>
                </div>
            </div>
        }
    </div>
    
    <div class="col-lg-8">
        <div class="card shadow-sm border-0 mb-4">
            <div class="card-header bg-white py-3 d-flex justify-content-between align-items-center">
                <h5 class="mb-0 fw-bold">Original Submission</h5>
                <span class="badge @(Model.SubmissionType == "writing" ? "bg-info-subtle text-info" : "bg-primary-subtle text-primary") rounded-pill px-3 py-2">
                    <i class="ti @(Model.SubmissionType == "writing" ? "ti-pencil" : "ti-microphone") me-1"></i>
                    @Model.SubmissionType.ToUpper()
                </span>
            </div>
            <div class="card-body">
                <div class="d-flex align-items-center justify-content-center mb-4 p-4 bg-light rounded">
                    <div class="text-center">
                        <h6 class="text-muted fw-bold text-uppercase mb-1">AI Band Score</h6>
                        <h1 class="display-4 fw-bold text-dark mb-0">@Model.OriginalScore</h1>
                    </div>
                </div>
                
                @if (Model.SubmissionType == "writing")
                {
                    var w = ViewBag.WritingSubmission as WebIeltsFree.Models.WritingSubmission;
                    if (w != null)
                    {
                        <div class="row text-center mb-4">
                            <div class="col-3 border-end">
                                <h4 class="mb-0 fw-bold text-primary">@w.TaScore</h4>
                                <small class="text-muted">Task Achv.</small>
                            </div>
                            <div class="col-3 border-end">
                                <h4 class="mb-0 fw-bold text-primary">@w.CcScore</h4>
                                <small class="text-muted">Coh. &amp; Coh.</small>
                            </div>
                            <div class="col-3 border-end">
                                <h4 class="mb-0 fw-bold text-primary">@w.LrScore</h4>
                                <small class="text-muted">Lex. Rsrc.</small>
                            </div>
                            <div class="col-3">
                                <h4 class="mb-0 fw-bold text-primary">@w.GraScore</h4>
                                <small class="text-muted">Grammar</small>
                            </div>
                        </div>
                        
                        <h6 class="fw-bold mb-2">Essay Text</h6>
                        <pre class="bg-light p-3 rounded text-dark fs-6" style="white-space: pre-wrap; font-family: inherit;">@w.EssayText</pre>
                        
                        <h6 class="fw-bold mb-2 mt-4 text-primary">AI Feedback</h6>
                        <div class="bg-primary-subtle p-3 rounded small text-dark">
                            @w.AiFeedback
                        </div>
                    }
                }
                else if (Model.SubmissionType == "speaking")
                {
                    var s = ViewBag.SpeakingSession as WebIeltsFree.Models.SpeakingSession;
                    if (s != null)
                    {
                        <div class="row text-center mb-4">
                            <div class="col-4 border-end">
                                <h4 class="mb-0 fw-bold text-primary">@s.FluencyScore</h4>
                                <small class="text-muted">Fluency</small>
                            </div>
                            <div class="col-4 border-end">
                                <h4 class="mb-0 fw-bold text-primary">@s.PronunciationScore</h4>
                                <small class="text-muted">Pronunciation</small>
                            </div>
                            <div class="col-4">
                                <h4 class="mb-0 fw-bold text-primary">@s.GrammarScore</h4>
                                <small class="text-muted">Grammar</small>
                            </div>
                        </div>
                        
                        @if (!string.IsNullOrEmpty(s.Topic))
                        {
                            <h6 class="fw-bold mb-2">Topic</h6>
                            <p class="bg-light p-3 rounded text-dark fst-italic">@s.Topic</p>
                        }
                        
                        <h6 class="fw-bold mb-2 mt-4">Transcript</h6>
                        <pre class="bg-light p-3 rounded text-dark fs-6" style="white-space: pre-wrap; font-family: inherit;">@s.Transcript</pre>
                        
                        <h6 class="fw-bold mb-2 mt-4 text-primary">AI Feedback</h6>
                        <div class="bg-primary-subtle p-3 rounded small text-dark">
                            @s.AiFeedback
                        </div>
                    }
                }
            </div>
        </div>
    </div>
</div>
