@model IEnumerable<WebIeltsFree.Models.RoadmapSuggestion>

@{
    ViewData["Title"] = "Roadmap Suggestions";
}

<div class="mb-6">
    <h1 class="fs-3 mb-1">Roadmap Suggestions</h1>
    <p>Manage suggestions you made to students' learning roadmaps.</p>
</div>

<div class="mb-4 d-flex justify-content-between align-items-center">
    <div>
        <a asp-action="Suggest" class="btn btn-primary">
            <i class="ti ti-plus me-1"></i>New Suggestion
        </a>
    </div>
</div>

<div class="card">
    <div class="card-header d-flex justify-content-between align-items-center bg-transparent px-4 py-3">
        <h5 class="mb-0">Your Suggestions</h5>
    </div>
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th>Student</th>
                    <th>Title</th>
                    <th>Message</th>
                    <th>Created At</th>
                    <th>Status</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td>
                            <div class="d-flex align-items-center gap-3">
                                <div class="avatar avatar-sm rounded-circle bg-light text-primary d-flex align-items-center justify-content-center">
                                    <i class="ti ti-user"></i>
                                </div>
                                <div>
                                    <h6 class="mb-0">@(item.Student?.Profile?.FullName ?? "Unknown Student")</h6>
                                    <small class="text-muted">@item.Student?.Email</small>
                                </div>
                            </div>
                        </td>
                        <td>@item.SuggestionTitle</td>
                        <td>@item.Message</td>
                        <td>@item.CreatedAt.ToString("yyyy-MM-dd HH:mm")</td>
                        <td>
                            @if (item.Status == "pending")
                            {
                                <span class="badge bg-warning-subtle text-warning">Pending</span>
                            }
                            else if (item.Status == "accepted")
                            {
                                <span class="badge bg-success-subtle text-success">Accepted</span>
                            }
                            else if (item.Status == "rejected")
                            {
                                <span class="badge bg-danger-subtle text-danger">Rejected</span>
                            }
                        </td>
                    </tr>
                }
                @if (!Model.Any())
                {
                    <tr>
                        <td colspan="5" class="text-center py-4 text-muted">
                            <i class="ti ti-map fs-1 d-block mb-2"></i>
                            No suggestions found.
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
