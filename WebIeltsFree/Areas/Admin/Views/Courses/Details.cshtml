@model WebIeltsFree.Models.Course

@{
    ViewData["Title"] = "Course Details";
}

<div class="row mb-4">
    <div class="col-12 d-flex justify-content-between align-items-center">
        <div>
            <h1 class="fs-3 fw-bold mb-1">Course Details</h1>
            <p class="text-muted mb-0">Overview of course #@Model.CourseId</p>
        </div>
        <div>
            <a asp-action="Index" class="btn btn-outline-secondary me-2">
                <i class="ti ti-arrow-left me-2"></i>Back to List
            </a>
            <a asp-action="Edit" asp-route-id="@Model.CourseId" class="btn btn-primary">
                <i class="ti ti-edit me-2"></i>Edit Course
            </a>
        </div>
    </div>
</div>

<div class="row g-4">
    <div class="col-lg-4">
        <div class="card shadow-sm border-0 mb-4 h-100">
            <div class="card-body p-4 text-center">
                <div class="avatar avatar-xl bg-primary bg-opacity-10 text-primary rounded-circle mb-3 d-inline-flex align-items-center justify-content-center" style="width: 80px; height: 80px;">
                    <i class="ti ti-books fs-1"></i>
                </div>
                <h4 class="fw-bold mb-1">@Model.Title</h4>
                <p class="text-muted small mb-3">@Model.Slug</p>
                
                <div class="d-flex justify-content-center gap-2 mb-4">
                    <span class="badge bg-light text-dark border px-3 py-2 text-uppercase">@Model.SkillType</span>
                    @if (Model.IsPublished)
                    {
                        <span class="badge bg-success bg-opacity-10 text-success px-3 py-2">Published</span>
                    }
                    else
                    {
                        <span class="badge bg-warning bg-opacity-10 text-warning px-3 py-2">Draft</span>
                    }
                </div>

                <hr class="text-muted opacity-25" />
                
                <div class="text-start mt-4">
                    <h6 class="fw-semibold mb-3">Course Metadata</h6>
                    <ul class="list-unstyled mb-0">
                        <li class="d-flex justify-content-between mb-2">
                            <span class="text-muted">Target Band</span>
                            <span class="fw-medium">@Model.TargetBand</span>
                        </li>
                        <li class="d-flex justify-content-between mb-2">
                            <span class="text-muted">Difficulty (1-5)</span>
                            <span class="fw-medium">@Model.DifficultyLevel</span>
                        </li>
                        <li class="d-flex justify-content-between mb-2">
                            <span class="text-muted">Est. Hours</span>
                            <span class="fw-medium">@Model.EstimatedHours</span>
                        </li>
                        <li class="d-flex justify-content-between mb-2">
                            <span class="text-muted">Display Order</span>
                            <span class="fw-medium">@Model.OrderIndex</span>
                        </li>
                    </ul>
                </div>
            </div>
        </div>
    </div>

    <div class="col-lg-8">
        <div class="card shadow-sm border-0 mb-4">
            <div class="card-header bg-white border-bottom-0 pt-4 pb-0 px-4">
                <h5 class="fw-bold mb-0">Description</h5>
            </div>
            <div class="card-body p-4">
                @if (!string.IsNullOrEmpty(Model.Description))
                {
                    <p class="mb-0">@Model.Description</p>
                }
                else
                {
                    <p class="text-muted fst-italic mb-0">No description provided.</p>
                }
            </div>
        </div>

        <div class="card shadow-sm border-0">
            <div class="card-header bg-white border-bottom-0 pt-4 pb-0 px-4 d-flex justify-content-between align-items-center">
                <h5 class="fw-bold mb-0">Modules Structure</h5>
                <button class="btn btn-sm btn-outline-primary"><i class="ti ti-plus me-1"></i> Add Module</button>
            </div>
            <div class="card-body p-4">
                @if (Model.Modules != null && Model.Modules.Any())
                {
                    <div class="accordion" id="modulesAccordion">
                        @foreach (var module in Model.Modules.OrderBy(m => m.OrderIndex))
                        {
                            <div class="accordion-item border-0 mb-3 bg-light rounded-3 shadow-sm">
                                <h2 class="accordion-header" id="heading-@module.ModuleId">
                                    <button class="accordion-button bg-transparent fw-semibold collapsed rounded-3" type="button" data-bs-toggle="collapse" data-bs-target="#collapse-@module.ModuleId" aria-expanded="false" aria-controls="collapse-@module.ModuleId">
                                        <i class="ti ti-folder text-warning me-2 fs-5"></i>
                                        Module @module.OrderIndex: @module.Title
                                        <span class="badge bg-secondary ms-auto me-2">@(module.Lessons?.Count ?? 0) Lessons</span>
                                    </button>
                                </h2>
                                <div id="collapse-@module.ModuleId" class="accordion-collapse collapse" aria-labelledby="heading-@module.ModuleId" data-bs-parent="#modulesAccordion">
                                    <div class="accordion-body bg-white border-top rounded-bottom-3 p-0">
                                        @if (module.Lessons != null && module.Lessons.Any())
                                        {
                                            <ul class="list-group list-group-flush rounded-bottom-3">
                                                @foreach (var lesson in module.Lessons.OrderBy(l => l.LessonId))
                                                {
                                                    <li class="list-group-item d-flex justify-content-between align-items-center p-3">
                                                        <div>
                                                            <i class="ti ti-file-text text-primary me-2"></i>
                                                            @lesson.Title
                                                        </div>
                                                        <span class="badge bg-light text-dark border">@lesson.SkillType</span>
                                                    </li>
                                                }
                                            </ul>
                                        }
                                        else
                                        {
                                            <div class="p-3 text-center text-muted small">No lessons in this module yet.</div>
                                        }
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                }
                else
                {
                    <div class="text-center py-5 text-muted bg-light rounded-3">
                        <i class="ti ti-folder-off fs-1 mb-2 d-block"></i>
                        No modules have been added to this course.
                    </div>
                }
            </div>
        </div>
    </div>
</div>
