@{
    ViewData["Title"] = "Practice Gym";
}

<style>
    /* ─── Practice Gym Design Tokens ─── */
    :root {
        --gym-bg: #f0f4f8;
        --gym-surface: #e8edf3;
        --gym-card: #ffffff;
        --gym-primary: #0057c2;
        --gym-primary-dark: #003d8a;
        --gym-primary-light: #e6f0ff;
        --gym-accent: #e64a19;
        --gym-ink: #0a1628;
        --gym-muted: #6b7a8f;
        --gym-hairline: #d0d8e4;
        --gym-success: #0d8050;
        --gym-warning: #c27800;
        --gym-radius: 16px;
        --gym-radius-sm: 10px;
        --gym-shadow: 0 2px 16px rgba(10,22,40,0.06);
        --gym-shadow-hover: 0 8px 32px rgba(10,22,40,0.12);
    }

    /* ─── Shell ─── */
    .gym-shell {
        background: var(--gym-bg);
        min-height: calc(100vh - 60px);
        padding: 0 0 80px;
        color: var(--gym-ink);
        font-family: 'Inter', -apple-system, BlinkMacSystemFont, sans-serif;
    }

    /* ─── Hero ─── */
    .gym-hero {
        background: linear-gradient(135deg, #0a1628 0%, #0d2952 40%, var(--gym-primary) 100%);
        padding: 48px 0 44px;
        color: #fff;
        position: relative;
        overflow: hidden;
    }
    .gym-hero::before {
        content: '';
        position: absolute;
        top: -40%;
        right: -5%;
        width: 400px;
        height: 400px;
        border-radius: 50%;
        background: radial-gradient(circle, rgba(0,87,194,0.25) 0%, transparent 70%);
        pointer-events: none;
    }
    .gym-hero::after {
        content: '';
        position: absolute;
        bottom: -30%;
        left: 10%;
        width: 300px;
        height: 300px;
        border-radius: 50%;
        background: radial-gradient(circle, rgba(230,74,25,0.1) 0%, transparent 70%);
        pointer-events: none;
    }
    .gym-hero h1 {
        font-size: 2.5rem;
        font-weight: 800;
        letter-spacing: -0.03em;
        line-height: 1.1;
        margin: 0 0 8px;
    }
    .gym-hero p {
        font-size: 1rem;
        opacity: 0.8;
        max-width: 550px;
        line-height: 1.5;
    }
    .gym-hero-chip {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        background: rgba(0,87,194,0.3);
        border: 1px solid rgba(0,87,194,0.4);
        border-radius: 999px;
        padding: 5px 14px;
        font-size: 0.7rem;
        font-weight: 800;
        text-transform: uppercase;
        letter-spacing: 0.08em;
        color: #b8d4ff;
        margin-bottom: 14px;
    }

    /* ─── Skill Cards ─── */
    .gym-skill-grid {
        display: grid;
        grid-template-columns: repeat(2, 1fr);
        gap: 20px;
    }
    .gym-skill-card {
        background: var(--gym-card);
        border: 1px solid var(--gym-hairline);
        border-radius: var(--gym-radius);
        box-shadow: var(--gym-shadow);
        padding: 0;
        overflow: hidden;
        transition: box-shadow 0.25s ease, transform 0.25s ease;
        position: relative;
        text-decoration: none;
        color: inherit;
        display: block;
    }
    .gym-skill-card:hover {
        box-shadow: var(--gym-shadow-hover);
        transform: translateY(-3px);
        color: inherit;
        text-decoration: none;
    }
    .gym-skill-card .card-accent {
        height: 5px;
        width: 100%;
    }
    .gym-skill-card .card-body-gym {
        padding: 28px 28px 24px;
    }
    .gym-skill-card .skill-icon-wrap {
        width: 56px;
        height: 56px;
        border-radius: 14px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.5rem;
        margin-bottom: 16px;
    }
    .gym-skill-card h3 {
        font-size: 1.2rem;
        font-weight: 700;
        margin: 0 0 6px;
        letter-spacing: -0.01em;
    }
    .gym-skill-card .card-desc {
        font-size: 0.84rem;
        color: var(--gym-muted);
        line-height: 1.5;
        margin: 0 0 18px;
    }
    .gym-skill-card .card-footer-gym {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 14px 28px;
        background: var(--gym-surface);
        border-top: 1px solid var(--gym-hairline);
    }
    .gym-skill-card .card-footer-gym .gym-stat {
        font-size: 0.75rem;
        color: var(--gym-muted);
        font-weight: 600;
    }
    .gym-skill-card .start-label {
        font-size: 0.82rem;
        font-weight: 700;
        color: var(--gym-primary);
        display: flex;
        align-items: center;
        gap: 4px;
    }

    /* Skill accent colors */
    .gym-skill-card.listening .card-accent { background: linear-gradient(90deg, #c49a6c, #e0bb8e); }
    .gym-skill-card.listening .skill-icon-wrap { background: rgba(196,154,108,0.12); color: #c49a6c; }
    .gym-skill-card.reading .card-accent { background: linear-gradient(90deg, var(--gym-primary), #3d8ef7); }
    .gym-skill-card.reading .skill-icon-wrap { background: var(--gym-primary-light); color: var(--gym-primary); }
    .gym-skill-card.writing .card-accent { background: linear-gradient(90deg, #5C7C75, #7a9e96); }
    .gym-skill-card.writing .skill-icon-wrap { background: rgba(92,124,117,0.12); color: #5C7C75; }
    .gym-skill-card.speaking .card-accent { background: linear-gradient(90deg, var(--gym-accent), #ff7043); }
    .gym-skill-card.speaking .skill-icon-wrap { background: rgba(230,74,25,0.08); color: var(--gym-accent); }

    /* ─── Quick Actions Bar ─── */
    .gym-actions {
        display: flex;
        gap: 12px;
        flex-wrap: wrap;
    }
    .gym-action-btn {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        background: var(--gym-card);
        border: 1px solid var(--gym-hairline);
        border-radius: var(--gym-radius-sm);
        padding: 12px 20px;
        font-size: 0.84rem;
        font-weight: 600;
        color: var(--gym-ink);
        text-decoration: none;
        transition: all 0.2s ease;
        box-shadow: var(--gym-shadow);
    }
    .gym-action-btn:hover {
        border-color: var(--gym-primary);
        color: var(--gym-primary);
        transform: translateY(-1px);
        text-decoration: none;
    }
    .gym-action-btn i { font-size: 1.1rem; }

    /* ─── Info Bar ─── */
    .gym-info-bar {
        background: var(--gym-primary-light);
        border: 1px solid rgba(0,87,194,0.15);
        border-radius: var(--gym-radius-sm);
        padding: 14px 20px;
        font-size: 0.84rem;
        color: var(--gym-ink);
        display: flex;
        align-items: center;
        gap: 10px;
    }
    .gym-info-bar i { color: var(--gym-primary); font-size: 1.1rem; }

    /* ─── Section Title ─── */
    .gym-section-title {
        font-size: 1.1rem;
        font-weight: 700;
        color: var(--gym-ink);
        letter-spacing: -0.01em;
        margin: 0;
    }

    /* ─── Animations ─── */
    @@keyframes gymSlideIn {
        from { opacity: 0; transform: translateY(12px); }
        to { opacity: 1; transform: translateY(0); }
    }
    .gym-fade-in {
        animation: gymSlideIn 0.4s ease;
    }

    /* ─── Responsive ─── */
    @@media (max-width: 767.98px) {
        .gym-hero h1 { font-size: 1.8rem; }
        .gym-hero { padding: 36px 0 30px; }
        .gym-skill-grid { grid-template-columns: 1fr; }
        .gym-skill-card .card-body-gym { padding: 20px; }
        .gym-skill-card .card-footer-gym { padding: 12px 20px; }
    }
</style>

<div class="gym-shell">
    <!-- Hero -->
    <div class="gym-hero">
        <div class="container">
            <span class="gym-hero-chip">
                <i class="bi bi-lightning-charge-fill"></i> Skill Gymnasium
            </span>
            <h1>Practice Gym</h1>
            <p>Timed exercises, AI-powered grading, and exam simulation across all four IELTS skills. Choose a skill to begin.</p>
        </div>
    </div>

    <div class="container">
        <!-- Quick Actions -->
        <div class="mt-4 mb-4">
            <div class="gym-actions">
                <a href="@Url.Action("Courses", "Home")" class="gym-action-btn">
                    <i class="bi bi-mortarboard"></i> Back to Study Library
                </a>
                <a href="@Url.Action("Tests", "Home")" class="gym-action-btn">
                    <i class="bi bi-clipboard-check"></i> Full Practice Tests
                </a>
                <a href="@Url.Action("AiRoadmap", "Home")" class="gym-action-btn">
                    <i class="bi bi-map"></i> AI Roadmap
                </a>
            </div>
        </div>

        <!-- Section Header -->
        <div class="d-flex justify-content-between align-items-center mb-3">
            <h2 class="gym-section-title">Choose Your Skill</h2>
        </div>

        <!-- Skill Cards Grid -->
        <div class="gym-skill-grid">
            <!-- Listening -->
            <a href="@Url.Action("Practice", "Home", new { type = "listening", lessonId = 0 })" class="gym-skill-card listening gym-fade-in" style="animation-delay: 0.05s">
                <div class="card-accent"></div>
                <div class="card-body-gym">
                    <div class="skill-icon-wrap">
                        <i class="bi bi-headphones"></i>
                    </div>
                    <h3>Listening Lab</h3>
                    <p class="card-desc">Audio comprehension exercises. Practice form completion, map labeling, note-taking, and matching across 4 exam sections.</p>
                    <div class="d-flex flex-wrap gap-2">
                        <span style="display:inline-flex;align-items:center;gap:4px;padding:3px 10px;border-radius:999px;font-size:0.7rem;font-weight:700;background:rgba(196,154,108,0.1);color:#8a6740;">Fill-in-Blank</span>
                        <span style="display:inline-flex;align-items:center;gap:4px;padding:3px 10px;border-radius:999px;font-size:0.7rem;font-weight:700;background:rgba(196,154,108,0.1);color:#8a6740;">Multiple Choice</span>
                        <span style="display:inline-flex;align-items:center;gap:4px;padding:3px 10px;border-radius:999px;font-size:0.7rem;font-weight:700;background:rgba(196,154,108,0.1);color:#8a6740;">Map/Note</span>
                    </div>
                </div>
                <div class="card-footer-gym">
                    <span class="gym-stat">~30 min per session</span>
                    <span class="start-label">Start <i class="bi bi-arrow-right"></i></span>
                </div>
            </a>

            <!-- Reading -->
            <a href="@Url.Action("Practice", "Home", new { type = "reading", lessonId = 0 })" class="gym-skill-card reading gym-fade-in" style="animation-delay: 0.1s">
                <div class="card-accent"></div>
                <div class="card-body-gym">
                    <div class="skill-icon-wrap">
                        <i class="bi bi-book"></i>
                    </div>
                    <h3>Reading Center</h3>
                    <p class="card-desc">Passage analysis with timed questions. Practice TFNG, matching headings, sentence completion, and summary completion exercises.</p>
                    <div class="d-flex flex-wrap gap-2">
                        <span style="display:inline-flex;align-items:center;gap:4px;padding:3px 10px;border-radius:999px;font-size:0.7rem;font-weight:700;background:var(--gym-primary-light);color:var(--gym-primary);">True/False/NG</span>
                        <span style="display:inline-flex;align-items:center;gap:4px;padding:3px 10px;border-radius:999px;font-size:0.7rem;font-weight:700;background:var(--gym-primary-light);color:var(--gym-primary);">Matching</span>
                        <span style="display:inline-flex;align-items:center;gap:4px;padding:3px 10px;border-radius:999px;font-size:0.7rem;font-weight:700;background:var(--gym-primary-light);color:var(--gym-primary);">Completion</span>
                    </div>
                </div>
                <div class="card-footer-gym">
                    <span class="gym-stat">~60 min per session</span>
                    <span class="start-label">Start <i class="bi bi-arrow-right"></i></span>
                </div>
            </a>

            <!-- Writing -->
            <a href="@Url.Action("Practice", "Home", new { type = "writing", lessonId = 0 })" class="gym-skill-card writing gym-fade-in" style="animation-delay: 0.15s">
                <div class="card-accent"></div>
                <div class="card-body-gym">
                    <div class="skill-icon-wrap">
                        <i class="bi bi-pencil"></i>
                    </div>
                    <h3>Writing Studio</h3>
                    <p class="card-desc">Task 1 visual descriptions and Task 2 argument essays. Submit for AI scoring across 4 criteria: TR, CC, LR, GRA.</p>
                    <div class="d-flex flex-wrap gap-2">
                        <span style="display:inline-flex;align-items:center;gap:4px;padding:3px 10px;border-radius:999px;font-size:0.7rem;font-weight:700;background:rgba(92,124,117,0.1);color:#5C7C75;">Task 1 ≥150 words</span>
                        <span style="display:inline-flex;align-items:center;gap:4px;padding:3px 10px;border-radius:999px;font-size:0.7rem;font-weight:700;background:rgba(92,124,117,0.1);color:#5C7C75;">Task 2 ≥250 words</span>
                    </div>
                </div>
                <div class="card-footer-gym">
                    <span class="gym-stat">~60 min per session</span>
                    <span class="start-label">Start <i class="bi bi-arrow-right"></i></span>
                </div>
            </a>

            <!-- Speaking -->
            <a href="@Url.Action("Practice", "Home", new { type = "speaking", lessonId = 0 })" class="gym-skill-card speaking gym-fade-in" style="animation-delay: 0.2s">
                <div class="card-accent"></div>
                <div class="card-body-gym">
                    <div class="skill-icon-wrap">
                        <i class="bi bi-mic"></i>
                    </div>
                    <h3>Speaking Suite</h3>
                    <p class="card-desc">1:1 AI examiner simulation with real-time question streaming, safety monitoring, and transcript analysis across Parts 1–3.</p>
                    <div class="d-flex flex-wrap gap-2">
                        <span style="display:inline-flex;align-items:center;gap:4px;padding:3px 10px;border-radius:999px;font-size:0.7rem;font-weight:700;background:rgba(230,74,25,0.08);color:var(--gym-accent);">Part 1 Interview</span>
                        <span style="display:inline-flex;align-items:center;gap:4px;padding:3px 10px;border-radius:999px;font-size:0.7rem;font-weight:700;background:rgba(230,74,25,0.08);color:var(--gym-accent);">Part 2 Cue Card</span>
                        <span style="display:inline-flex;align-items:center;gap:4px;padding:3px 10px;border-radius:999px;font-size:0.7rem;font-weight:700;background:rgba(230,74,25,0.08);color:var(--gym-accent);">Part 3 Discussion</span>
                    </div>
                </div>
                <div class="card-footer-gym">
                    <span class="gym-stat">~15 min per session</span>
                    <span class="start-label">Start <i class="bi bi-arrow-right"></i></span>
                </div>
            </a>
        </div>

        <!-- Bottom Info -->
        <div class="gym-info-bar mt-4 gym-fade-in">
            <i class="bi bi-info-circle"></i>
            <span>Practice exercises pull from <strong>tb_reading_passages</strong>, <strong>tb_listening_materials</strong>, <strong>tb_writing_prompts</strong>, and <strong>tb_speaking_topics</strong>. Your attempts are tracked in the progress system.</span>
        </div>
    </div>
</div>
