    function bindWritingPromptByTaskType(taskType) {
        const promptBox = document.getElementById('writingPromptBox');
        const task = Number(taskType || 1);
        const pool = writingPrompts.filter(p => p.taskType === task);
        activeWritingPrompt = pool.length ? pool[Math.floor(Math.random() * pool.length)] : null;
        promptBox.textContent = activeWritingPrompt?.prompt || 'No prompt available for this task.';

        const chartContainer = document.getElementById('writingChartContainer');
        if (chartContainer) {
            if (task === 1) {
                chartContainer.style.display = 'block';
                const chartImg = document.getElementById('writingChartImg');
                const chartOverlay = document.getElementById('writingChartOverlay');
                const chartFallback = document.getElementById('writingChartFallback');
                
                if (activeWritingPrompt && activeWritingPrompt.promptImageUrl) {
                    if (chartImg) {
                        chartImg.src = activeWritingPrompt.promptImageUrl;
                        chartImg.style.display = 'block';
                    }
                    if (chartOverlay) {
                        chartOverlay.style.display = '';
                    }
                    if (chartFallback) {
                        chartFallback.style.display = 'none';
                    }
                } else {
                    if (chartImg) {
                        chartImg.src = '';
                        chartImg.style.display = 'none';
                    }
                    if (chartOverlay) {
                        chartOverlay.style.display = 'none';
                    }
                    if (chartFallback) {
                        chartFallback.style.display = 'flex';
                    }
                }
            } else {
                chartContainer.style.display = 'none';
            }
        }
    }

    async function loadWritingHistory() {
        if (skillType !== 'writing' || !Auth.isLoggedIn()) return;
        const listEl = document.getElementById('writingHistoryList');
        const emptyEl = document.getElementById('writingHistoryEmpty');
        if (!listEl || !emptyEl) return;

        listEl.innerHTML = '<div class="small text-muted">Loading history...</div>';
        try {
            const response = await api('/writing/history', { method: 'GET' });
            writingHistoryCache = response?.success ? (response.data || []) : [];
            if (!writingHistoryCache.length) {
                listEl.innerHTML = '';
                emptyEl.classList.remove('d-none');
                return;
            }

            emptyEl.classList.add('d-none');
            listEl.innerHTML = writingHistoryCache.map(item => {
                const subId = item.submissionId ?? item.SubmissionId ?? 0;
                const promptVal = item.prompt ?? item.Prompt ?? 'Writing submission';
                const bandVal = item.bandScore ?? item.BandScore ?? 0;
                const createdVal = item.createdAt ?? item.CreatedAt ?? '';
                return `
                    <button class="btn btn-sm text-start writing-history-item w-100"
                        data-id="${subId}">
                        <div class="fw-semibold text-truncate">${escapeHtml(promptVal.slice(0, 80))}</div>
                        <div class="small text-muted d-flex justify-content-between mt-1">
                            <span>Band ${formatIeltsBand(bandVal)}</span>
                            <span>${formatDate(createdVal)}</span>
                        </div>
                    </button>
                `;
            }).join('');

            listEl.querySelectorAll('.writing-history-item').forEach(btn => {
                btn.addEventListener('click', async () => {
                    const id = Number(btn.getAttribute('data-id'));
                    if (id) await loadWritingHistoryItem(id);
                });
            });
        } catch {
            listEl.innerHTML = '<div class="small text-danger">Failed to load history.</div>';
        }
    }

    async function loadWritingHistoryItem(id) {
        try {
            const response = await api(`/writing/history/${id}`, { method: 'GET' });
            if (!response?.success || !response.data) return;
            const promptText = response.data.prompt ?? response.data.Prompt ?? '';
            renderWritingFeedback(response.data, null, promptText);
        } catch {
            showToast('Cannot load writing history detail', 'error');
        }
    }

    function renderWritingFeedback(result, essayText, promptText) {
        if (result && result.submissionId) {
            window.lastWritingSubmissionId = result.submissionId;
        } else if (result && result.SubmissionId) {
            window.lastWritingSubmissionId = result.SubmissionId;
        }

        const feedbackPanel = document.getElementById('writingFeedbackPanel');
        const modelPanel = document.getElementById('writingModelPanel');
        if (!feedbackPanel || !modelPanel) return;

        feedbackPanel.style.display = 'flex';
        modelPanel.style.display = 'block';

        const band = Number(result?.bandScore ?? result?.BandScore ?? 0);
        const targetBand = Math.min(9, Math.max(7, Math.ceil((band || 6) * 2) / 2 + 0.5));

        document.getElementById('writingBandScore').textContent = formatIeltsBand(result?.bandScore ?? result?.BandScore);
        document.getElementById('writingScoreTA').textContent = formatIeltsBand(result?.taskAchievementScore ?? result?.TaskAchievementScore);
        document.getElementById('writingScoreCC').textContent = formatIeltsBand(result?.coherenceCohesionScore ?? result?.CoherenceCohesionScore);
        document.getElementById('writingScoreLR').textContent = formatIeltsBand(result?.lexicalResourceScore ?? result?.LexicalResourceScore);
        document.getElementById('writingScoreGA').textContent = formatIeltsBand(result?.grammarAccuracyScore ?? result?.GrammarAccuracyScore);
        
        const feedbackVal = result?.aiFeedback ?? result?.AiFeedback ?? 'No detailed AI feedback available.';
        document.getElementById('writingFeedbackText').textContent = feedbackVal;

        const tips = extractTipsFromFeedback(feedbackVal);
        const tipsEl = document.getElementById('writingTipsList');
        tipsEl.innerHTML = tips.map(t => `<li>${escapeHtml(t)}</li>`).join('');

        document.getElementById('writingModelBand').textContent = targetBand.toFixed(1);
        document.getElementById('writingModelAnswerPrompt').textContent = promptText ? `Prompt: ${promptText}` : 'Prompt unavailable';
        document.getElementById('writingModelAnswerText').textContent = buildModelAnswer(promptText, targetBand, essayText);
    }

    function extractTipsFromFeedback(feedback) {
        const lines = String(feedback || '')
            .split('\n')
            .map(x => x.trim())
            .filter(x => x.length > 0);

        const candidates = lines.filter(x =>
            x.includes('⚠') ||
            x.toLowerCase().includes('improvement') ||
            x.toLowerCase().includes('try ') ||
            x.toLowerCase().includes('ensure ')
        );

        const result = candidates.length ? candidates.slice(0, 5) : [
            'Use a clear thesis statement in the introduction.',
            'Develop each body paragraph with one main idea and concrete support.',
            'Use topic-specific vocabulary and vary sentence structures.'
        ];
        return result;
    }

    function buildModelAnswer(promptText, targetBand, essayText) {
        const styleHint = essayText && essayText.length > 0
            ? 'Based on your submission, this version strengthens coherence and lexical range while keeping ideas balanced.'
            : 'This sample demonstrates stronger coherence, lexical resource, and grammatical range.';

        return [
            `Target band ${targetBand.toFixed(1)} sample`,
            '',
            styleHint,
            '',
            'It is often argued that modern technology is transforming education in ways that may either weaken or improve learning outcomes. While some people fear that digital tools reduce meaningful classroom interaction, I believe that, when used appropriately, technology can significantly enhance both academic performance and learner autonomy.',
            '',
            'On the one hand, critics point out that excessive dependence on devices can discourage direct communication between students and teachers. In highly digital classrooms, learners may focus more on screens than on collaborative discussion, which can limit the development of social confidence and interpersonal skills. Furthermore, unrestricted access to online content may distract students from core learning objectives.',
            '',
            'On the other hand, educational technology offers substantial benefits. Interactive platforms provide immediate feedback, allowing learners to identify weaknesses and improve faster than with traditional methods alone. In addition, digital resources such as simulations, recorded lectures, and adaptive exercises make complex concepts easier to understand, especially for students with different learning speeds. These tools can also increase motivation by making lessons more engaging and personalized.',
            '',
            'In my view, technology should be regarded as a complement rather than a substitute for teaching. If schools combine digital innovation with strong pedagogical guidance, students can enjoy the advantages of both efficient knowledge acquisition and meaningful human interaction. Therefore, the key issue is not whether technology should be used, but how it should be integrated responsibly into the learning process.'
        ].join('\n');
    }

    function formatDate(input) {
        const date = new Date(input);
        if (Number.isNaN(date.getTime())) return '';
        return date.toLocaleDateString();
    }

