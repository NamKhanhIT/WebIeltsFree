@{
    ViewData["Title"] = "Teacher Dashboard";
}

<div class="row">
    <div class="col-12">
        <div class="mb-6">
            <h1 class="fs-3 mb-1 fw-bold">Teacher Dashboard</h1>
            <p class="text-muted">Welcome to the WebIeltsFree Teacher Area.</p>
        </div>
    </div>
</div>

<div class="row g-3 mb-3">
    <div class="col-lg-3 col-md-6">
        <div class="card p-4 bg-success bg-opacity-10 border border-success border-opacity-25 rounded-2 h-100">
            <div class="d-flex gap-3 align-items-center">
                <div class="icon-shape icon-md bg-success text-white rounded-2 d-flex align-items-center justify-content-center" style="width: 48px; height: 48px;">
                    <i class="ti ti-scale fs-4"></i>
                </div>
                <div>
                    <h2 class="mb-1 fs-6 fw-semibold text-dark">Grade Disputes</h2>
                    <a asp-controller="GradeDisputes" asp-action="Index" class="text-success small text-decoration-none fw-medium">View Disputes &rarr;</a>
                </div>
            </div>
        </div>
    </div>
    
    <div class="col-lg-3 col-md-6">
        <div class="card p-4 bg-primary bg-opacity-10 border border-primary border-opacity-25 rounded-2 h-100">
            <div class="d-flex gap-3 align-items-center">
                <div class="icon-shape icon-md bg-primary text-white rounded-2 d-flex align-items-center justify-content-center" style="width: 48px; height: 48px;">
                    <i class="ti ti-pencil fs-4"></i>
                </div>
                <div>
                    <h2 class="mb-1 fs-6 fw-semibold text-dark">Writing Prompts</h2>
                    <a asp-controller="WritingPrompts" asp-action="Index" class="text-primary small text-decoration-none fw-medium">Manage Content &rarr;</a>
                </div>
            </div>
        </div>
    </div>
    
    <div class="col-lg-3 col-md-6">
        <div class="card p-4 bg-info bg-opacity-10 border border-info border-opacity-25 rounded-2 h-100">
            <div class="d-flex gap-3 align-items-center">
                <div class="icon-shape icon-md bg-info text-white rounded-2 d-flex align-items-center justify-content-center" style="width: 48px; height: 48px;">
                    <i class="ti ti-microphone fs-4"></i>
                </div>
                <div>
                    <h2 class="mb-1 fs-6 fw-semibold text-dark">Speaking Topics</h2>
                    <a asp-controller="SpeakingTopics" asp-action="Index" class="text-info small text-decoration-none fw-medium">Manage Content &rarr;</a>
                </div>
            </div>
        </div>
    </div>
    
    <div class="col-lg-3 col-md-6">
        <div class="card p-4 bg-warning bg-opacity-10 border border-warning border-opacity-25 rounded-2 h-100">
            <div class="d-flex gap-3 align-items-center">
                <div class="icon-shape icon-md bg-warning text-white rounded-2 d-flex align-items-center justify-content-center" style="width: 48px; height: 48px;">
                    <i class="ti ti-messages fs-4"></i>
                </div>
                <div>
                    <h2 class="mb-1 fs-6 fw-semibold text-dark">Conversations</h2>
                    <a asp-controller="Conversations" asp-action="Index" class="text-warning small text-decoration-none fw-medium">View Messages &rarr;</a>
                </div>
            </div>
        </div>
    </div>
</div>
