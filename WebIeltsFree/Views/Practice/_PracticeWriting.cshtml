<!-- Load Quill JS -->
<script src="https://cdn.quilljs.com/1.3.7/quill.min.js"></script>

<!-- Interactive Logic -->
<script>
    let quill; 
    let updateEditorState; 

    const VOCAB_UPGRADES = [
        { pattern: /\bwent\s+up\s+very\s+fast\b/gi, replacement: "experienced a sharp increase", label: "went up very fast" },
        { pattern: /\brose\s+very\s+fast\b/gi, replacement: "surged dramatically", label: "rose very fast" },
        { pattern: /\bwent\s+up\s+fast\b/gi, replacement: "increased rapidly", label: "went up fast" },
        { pattern: /\brose\s+fast\b/gi, replacement: "increased rapidly", label: "rose fast" },
        { pattern: /\bwent\s+down\s+very\s+fast\b/gi, replacement: "plummeted dramatically", label: "went down very fast" },
        { pattern: /\bwent\s+down\b/gi, replacement: "decreased significantly", label: "went down" },
        { pattern: /\bdropped\s+fast\b/gi, replacement: "slumped rapidly", label: "dropped fast" },
        { pattern: /\bshows\b/gi, replacement: "illustrates", label: "shows" },
        { pattern: /\bshow\b/gi, replacement: "illustrate", label: "show" },
        { pattern: /\bbig\b/gi, replacement: "substantial", label: "big" },
        { pattern: /\bsmall\b/gi, replacement: "negligible", label: "small" },
        { pattern: /\bmany\b/gi, replacement: "numerous", label: "many" },
        { pattern: /\ba\s+lot\s+of\b/gi, replacement: "a multitude of", label: "a lot of" },
        { pattern: /\bgood\b/gi, replacement: "beneficial", label: "good" },
        { pattern: /\bbad\b/gi, replacement: "detrimental", label: "bad" },
        { pattern: /\bimportant\b/gi, replacement: "crucial", label: "important" },
        { pattern: /\babout\b/gi, replacement: "approximately", label: "about" },
        { pattern: /\baround\b/gi, replacement: "approximately", label: "around" },
        { pattern: /\bget\b/gi, replacement: "acquire", label: "get" },
        { pattern: /\blike\b/gi, replacement: "such as", label: "like" },
        { pattern: /\bso\b/gi, replacement: "consequently", label: "so" },
        { pattern: /\bbut\b/gi, replacement: "however", label: "but" },
        { pattern: /\bthink\b/gi, replacement: "believe", label: "think" },
        { pattern: /\bpeople\b/gi, replacement: "individuals", label: "people" },
        { pattern: /\bvery\b/gi, replacement: "exceedingly", label: "very" },
        { pattern: /\bmake\b/gi, replacement: "generate", label: "make" },
        { pattern: /\bhelp\b/gi, replacement: "assist", label: "help" },
        { pattern: /\bchange\b/gi, replacement: "modify", label: "change" },
        { pattern: /\bnew\b/gi, replacement: "modern", label: "new" },
        { pattern: /\bold\b/gi, replacement: "traditional", label: "old" },
        { pattern: /\bevery\s+year\b/gi, replacement: "annually", label: "every year" },
        { pattern: /\byearly\b/gi, replacement: "annual", label: "yearly" },
        { pattern: /\bevery\s+day\b/gi, replacement: "daily", label: "every day" },
        { pattern: /\bsolve\b/gi, replacement: "resolve", label: "solve" },
        { pattern: /\bclear\b/gi, replacement: "evident", label: "clear" },
        { pattern: /\benough\b/gi, replacement: "sufficient", label: "enough" },
        { pattern: /\buse\b/gi, replacement: "utilize", label: "use" },
        { pattern: /\bnice\b/gi, replacement: "pleasant", label: "nice" },
        { pattern: /\bpoor\b/gi, replacement: "impoverished", label: "poor" },
        { pattern: /\brich\b/gi, replacement: "affluent", label: "rich" }
    ];

    const GRAMMAR_WARNINGS = [
        { pattern: /\bpeople\s+is\b/gi, replacement: "people are", label: "people is" },
        { pattern: /\b(he|she|it)\s+have\b/gi, replacement: "has", label: "have (after he/she/it)", customReplace: true },
        { pattern: /\bthere\s+is\s+(many|some|numerous|several)\b/gi, replacement: "there are", label: "there is (before plural)", customReplace: true },
        { pattern: /\baffect\s+on\b/gi, replacement: "affect", label: "affect on" },
        { pattern: /\bdiscuss\s+about\b/gi, replacement: "discuss", label: "discuss about" },
        { pattern: /\bexplain\s+about\b/gi, replacement: "explain", label: "explain about" },
        { pattern: /\binformations\b/gi, replacement: "information", label: "informations" },
        { pattern: /\badvices\b/gi, replacement: "advice", label: "advices" },
        { pattern: /\bequipments\b/gi, replacement: "equipment", label: "equipments" },
        { pattern: /\bresearchs\b/gi, replacement: "research", label: "researchs" },
        { pattern: /\bknowledges\b/gi, replacement: "knowledge", label: "knowledges" },
        { pattern: /\bevery\s+students\b/gi, replacement: "every student", label: "every students" },
        { pattern: /\beach\s+students\b/gi, replacement: "each student", label: "each students" },
        { pattern: /\bmore\s+better\b/gi, replacement: "better", label: "more better" },
        { pattern: /\bmore\s+easier\b/gi, replacement: "easier", label: "more easier" },
        { pattern: /\bcope\s+up\s+with\b/gi, replacement: "cope with", label: "cope up with" },
        { pattern: /\bcan\s+be\s+able\s+to\b/gi, replacement: "can", label: "can be able to" },
        { pattern: /\bin\s+my\s+opinion,\s+i\s+think\b/gi, replacement: "in my opinion,", label: "in my opinion, I think" },
        { pattern: /\bshould\s+to\s+([a-z]+)\b/gi, replacement: "should", label: "should to + verb", customReplace: true },
        { pattern: /\bmust\s+to\s+([a-z]+)\b/gi, replacement: "must", label: "must to + verb", customReplace: true }
    ];

    const LINKING_WORDS = [
        "however", "furthermore", "moreover", "in contrast", "consequently", 
        "on the other hand", "in addition", "nevertheless", "therefore", 
        "subsequently", "specifically", "as a result", "on the contrary"
    ];

    function preserveCapitalization(original, replacement) {
        if (!original || !replacement) return replacement;
        if (original[0] === original[0].toUpperCase() && original[0] !== original[0].toLowerCase()) {
            return replacement.charAt(0).toUpperCase() + replacement.slice(1);
        }
        return replacement;
    }

    function analyzeText(text) {
        const suggestions = [];
        if (!text || text.trim().length === 0) return suggestions;

        const normalizedText = text;

        // E. Ignore Code Blocks and Numbers: Mask them with spaces to preserve Quill matching offsets
        const textForScanning = normalizedText
            .replace(/```[\s\S]*?```/g, (m) => ' '.repeat(m.length))
            .replace(/`[^`]+`/g, (m) => ' '.repeat(m.length))
            .replace(/\b\d+(?:\.\d+)?%?\b/g, (m) => ' '.repeat(m.length));

        // A. Scan Lexical Upgrades
        VOCAB_UPGRADES.forEach(rule => {
            let match;
            rule.pattern.lastIndex = 0;
            // C. Regex patterns strictly use \bword\b boundary markers as defined in VOCAB_UPGRADES
            while ((match = rule.pattern.exec(textForScanning)) !== null) {
                const originalMatched = match[0];
                // D. Preserve Capitalization
                const resolvedReplacement = preserveCapitalization(originalMatched, rule.replacement);
                suggestions.push({
                    type: 'vocab',
                    severity: 'low',
                    priority: 1,
                    category: 'Vocabulary',
                    label: 'Lexical Upgrade',
                    original: originalMatched,
                    replacement: resolvedReplacement,
                    index: match.index,
                    length: originalMatched.length,
                    icon: `<svg xmlns="http://www.w3.org/2000/svg" class="h-3.5 w-3.5" viewBox="0 0 20 20" fill="currentColor"><path d="M13.586 3.586a2 2 0 112.828 2.828l-.793.793-2.828-2.828.793-.793zM11.379 5.793L3 14.172V17h2.828l8.38-8.379-2.83-2.828z" /></svg>`
                });
            }
        });

        // B. Scan Grammar Warnings
        GRAMMAR_WARNINGS.forEach(rule => {
            let match;
            rule.pattern.lastIndex = 0;
            // C. Regex patterns strictly use \bword\b boundary markers as defined in GRAMMAR_WARNINGS
            while ((match = rule.pattern.exec(textForScanning)) !== null) {
                const originalMatched = match[0];
                let actualReplacement = rule.replacement;
                
                if (rule.customReplace) {
                    if (rule.label.includes("have")) {
                        const pronoun = match[1];
                        actualReplacement = pronoun + " has";
                    } else if (rule.label.includes("there is")) {
                        const pluralInd = match[1];
                        actualReplacement = "there are " + pluralInd;
                    } else if (rule.label.includes("should to")) {
                        const verb = match[1];
                        actualReplacement = "should " + verb;
                    } else if (rule.label.includes("must to")) {
                        const verb = match[1];
                        actualReplacement = "must " + verb;
                    }
                }

                // D. Preserve Capitalization
                const resolvedReplacement = preserveCapitalization(originalMatched, actualReplacement);

                suggestions.push({
                    type: 'grammar',
                    severity: 'high',
                    priority: 3,
                    category: 'Grammar',
                    label: 'Grammar Warning',
                    original: originalMatched,
                    replacement: resolvedReplacement,
                    index: match.index,
                    length: originalMatched.length,
                    icon: `<svg xmlns="http://www.w3.org/2000/svg" class="h-3.5 w-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" /></svg>`
                });
            }
        });

        // C. Scan Cohesion consecutive starts
        const sentences = [];
        const sentenceRegex = /([^.!?]+([.!?]+|$))/g;
        let sMatch;
        while ((sMatch = sentenceRegex.exec(textForScanning)) !== null) {
            const sText = sMatch[1].trim();
            if (sText.length > 0) {
                sentences.push({
                    text: sText,
                    index: sMatch.index,
                    length: sMatch[1].length
                });
            }
        }

        for (let i = 0; i < sentences.length - 1; i++) {
            const s1 = sentences[i].text;
            const s2 = sentences[i + 1].text;
            
            const words1 = s1.split(/\s+/);
            const words2 = s2.split(/\s+/);
            
            if (words1.length > 0 && words2.length > 0) {
                const w1 = words1[0].replace(/[^a-zA-Z]/g, '').toLowerCase();
                const w2 = words2[0].replace(/[^a-zA-Z]/g, '').toLowerCase();
                
                if (w1 === w2 && (w1.length > 2 || w1 === 'the' || w1 === 'it' || w1 === 'this')) {
                    const matchStartWord = words2[0];
                    suggestions.push({
                        type: 'cohesion',
                        severity: 'medium',
                        priority: 2,
                        category: 'Cohesion',
                        label: 'Cohesion Hint',
                        message: `You started two consecutive sentences with "${matchStartWord}". Use linking words like <span class="font-medium text-amber-700 bg-amber-50 px-1 rounded">Furthermore</span> or <span class="font-medium text-amber-700 bg-amber-50 px-1 rounded">In contrast</span> to improve flow.`,
                        index: sentences[i+1].index,
                        length: matchStartWord.length
                    });
                }
            }
        }

        // D. Linking Word density check
        let linkingWordsFound = 0;
        const essayLower = textForScanning.toLowerCase();
        LINKING_WORDS.forEach(lw => {
            const lwRegex = new RegExp('\\b' + lw + '\\b', 'gi');
            const matches = essayLower.match(lwRegex);
            if (matches) {
                linkingWordsFound += matches.length;
            }
        });

        const wordsCount = textForScanning.trim().split(/\s+/).length;
        if (wordsCount > 80 && linkingWordsFound === 0) {
            suggestions.push({
                type: 'cohesion',
                severity: 'medium',
                priority: 2,
                category: 'Cohesion',
                label: 'Cohesion Hint',
                message: `Your essay has over 80 words but doesn't use standard transition words. Try adding connectors like <span class="font-medium text-amber-700 bg-amber-50 px-1 rounded">However</span> or <span class="font-medium text-amber-700 bg-amber-50 px-1 rounded">In addition</span> to group your points.`,
                index: normalizedText.length - 1,
                length: 1
            });
        }

        // B. Duplicate Suggestion Prevention: Deduplicate by original and replacement text keys
        const seen = new Set();
        const uniqueSuggestions = [];
        for (const s of suggestions) {
            const key = `${s.type}::${s.original || ''}::${s.replacement || s.message || ''}`;
            if (!seen.has(key)) {
                seen.add(key);
                uniqueSuggestions.push(s);
            }
        }

        // A. Sort by priority score (high severity first)
        uniqueSuggestions.sort((a, b) => b.priority - a.priority);

        return uniqueSuggestions;
    }

    // Dynamic rendering of cards
    function runLiveSuggestions(text, words) {
        const suggestions = analyzeText(text);
        const container = document.getElementById('aiSuggestions');
        if (!container) return;

        // Clear previous cards, keep the header
        container.innerHTML = `
            <div class="flex items-center gap-2">
                <span class="w-1.5 h-1.5 rounded-full bg-brand-500 animate-pulse"></span>
                <h3 class="text-xs font-bold text-slate-400 uppercase tracking-wider">Live Suggestions</h3>
            </div>
        `;

        const statGrammar = document.getElementById('stat-grammar');
        const statVocab = document.getElementById('stat-vocab');
        const statCoh = document.getElementById('stat-coh');
        const dotGrammar = document.getElementById('stat-grammar-dot');
        const dotVocab = document.getElementById('stat-vocab-dot');
        const dotCoh = document.getElementById('stat-coh-dot');

        if (suggestions.length === 0) {
            container.innerHTML += `
                <div class="bg-gradient-to-r from-brand-50/60 to-emerald-50/60 p-4 rounded-xl border border-brand-100/40 text-xs text-brand-700 flex flex-col gap-1 shadow-sm mt-2">
                    <span class="font-bold flex items-center gap-1">🎉 Academic Tone Achieved!</span>
                    <span>Keep writing. No lexical upgrades, grammar warnings, or cohesion traps found.</span>
                </div>
            `;
        } else {
            suggestions.forEach(s => {
                let cardHtml = '';
                if (s.type === 'vocab') {
                    cardHtml = `
                        <div onclick="window.applySuggestion(${s.index}, ${s.length}, '${s.replacement.replace(/'/g, "\\'")}')" class="bg-white border border-brand-200 rounded-xl p-4 shadow-sm relative overflow-hidden group hover:shadow-md hover:border-brand-300 transition-all cursor-pointer transform hover:-translate-y-0.5 mt-2">
                            <div class="absolute top-0 left-0 w-1 h-full bg-brand-500 group-hover:w-1.5 transition-all"></div>
                            <div class="flex justify-between items-start mb-3">
                                <span class="text-xs font-bold text-brand-600 flex items-center gap-1.5">
                                    ${s.icon} ${s.label}
                                    <span class="px-1.5 py-0.5 text-[8px] font-extrabold tracking-wider uppercase rounded bg-brand-50 text-brand-600 border border-brand-100/50">Word Upgrade</span>
                                </span>
                                <span class="bg-brand-50 text-brand-600 p-1.5 rounded-md hover:bg-brand-100 transition-colors" title="Apply suggestion">
                                    <svg xmlns="http://www.w3.org/2000/svg" class="h-3.5 w-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4" /></svg>
                                </span>
                            </div>
                            <p class="text-xs text-slate-500 mb-2">Instead of <span class="line-through text-rose-400 font-medium">${s.original}</span>, try:</p>
                            <div class="text-sm font-semibold text-slate-800 bg-brand-50/50 p-2.5 rounded-lg border border-brand-100/50 flex items-center gap-2">
                                <span class="text-brand-500">✨</span> ${s.replacement}
                            </div>
                        </div>
                    `;
                } else if (s.type === 'grammar') {
                    cardHtml = `
                        <div onclick="window.applySuggestion(${s.index}, ${s.length}, '${s.replacement.replace(/'/g, "\\'")}')" class="bg-white border border-emerald-200 rounded-xl p-4 shadow-sm relative overflow-hidden group hover:shadow-md hover:border-emerald-300 transition-all cursor-pointer transform hover:-translate-y-0.5 mt-2">
                            <div class="absolute top-0 left-0 w-1 h-full bg-emerald-500 group-hover:w-1.5 transition-all"></div>
                            <div class="flex justify-between items-start mb-3">
                                <span class="text-xs font-bold text-emerald-600 flex items-center gap-1.5">
                                    ${s.icon} ${s.label}
                                    <span class="px-1.5 py-0.5 text-[8px] font-extrabold tracking-wider uppercase rounded bg-rose-50 text-rose-600 border border-rose-100/40">Critical Fix</span>
                                </span>
                                <span class="bg-emerald-50 text-emerald-600 p-1.5 rounded-md hover:bg-emerald-100 transition-colors" title="Apply suggestion">
                                    <svg xmlns="http://www.w3.org/2000/svg" class="h-3.5 w-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4" /></svg>
                                </span>
                            </div>
                            <p class="text-xs text-slate-500 mb-2">Instead of <span class="line-through text-rose-400 font-medium">${s.original}</span>, try:</p>
                            <div class="text-sm font-semibold text-slate-800 bg-emerald-50/50 p-2.5 rounded-lg border border-emerald-100/50 flex items-center gap-2">
                                <span class="text-brand-500">✨</span> ${s.replacement}
                            </div>
                        </div>
                    `;
                } else if (s.type === 'cohesion') {
                    cardHtml = `
                        <div class="bg-white border border-amber-200 rounded-xl p-4 shadow-sm relative overflow-hidden group hover:shadow-md hover:border-amber-300 transition-all transform hover:-translate-y-0.5 mt-2">
                            <div class="absolute top-0 left-0 w-1 h-full bg-amber-400 group-hover:w-1.5 transition-all"></div>
                            <div class="flex justify-between items-start mb-2">
                                <span class="text-xs font-bold text-amber-600 flex items-center gap-1.5">
                                    <svg xmlns="http://www.w3.org/2000/svg" class="h-3.5 w-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13.828 10.172a4 4 0 00-5.656 0l-4 4a4 4 0 105.656 5.656l1.102-1.101m-.758-4.899a4 4 0 005.656 0l4-4a4 4 0 00-5.656-5.656l-1.1 1.1" /></svg>
                                    ${s.label}
                                    <span class="px-1.5 py-0.5 text-[8px] font-extrabold tracking-wider uppercase rounded bg-amber-50 text-amber-600 border border-amber-100">Structure Hint</span>
                                </span>
                            </div>
                            <p class="text-[13px] text-slate-600 leading-relaxed">${s.message}</p>
                        </div>
                    `;
                }
                container.innerHTML += cardHtml;
            });
        }

        // Compute Dynamic Band Scores
        const vocabCards = suggestions.filter(x => x.type === 'vocab').length;
        const grammarCards = suggestions.filter(x => x.type === 'grammar').length;
        const cohesionCards = suggestions.filter(x => x.type === 'cohesion').length;

        const baseVocabBand = Math.max(5.0, 9.0 - (vocabCards * 0.5));
        const baseGrammarBand = Math.max(5.0, 9.0 - (grammarCards * 0.5));

        if (statGrammar) {
            statGrammar.innerText = `Band ${baseGrammarBand.toFixed(1)}`;
            dotGrammar.className = `w-1.5 h-1.5 rounded-full transition-colors ${baseGrammarBand >= 7.5 ? 'bg-emerald-400' : baseGrammarBand >= 6.0 ? 'bg-amber-400' : 'bg-rose-400'}`;
        }
        if (statVocab) {
            statVocab.innerText = `Band ${baseVocabBand.toFixed(1)}`;
            dotVocab.className = `w-1.5 h-1.5 rounded-full transition-colors ${baseVocabBand >= 7.5 ? 'bg-emerald-400' : baseVocabBand >= 6.0 ? 'bg-amber-400' : 'bg-rose-400'}`;
        }
        if (statCoh) {
            if (cohesionCards > 0) {
                statCoh.innerText = 'Needs linkers';
                dotCoh.className = 'w-1.5 h-1.5 rounded-full bg-amber-400 transition-colors';
            } else {
                statCoh.innerText = 'Good flow';
                dotCoh.className = 'w-1.5 h-1.5 rounded-full bg-emerald-400 transition-colors';
            }
        }
    }

    // Expose interactive replacement function
    window.applySuggestion = function(startIdx, length, replacement) {
        if (!quill) return;

        // Perform Quill text deletion & replacement
        quill.deleteText(startIdx, length);
        quill.insertText(startIdx, replacement);

        // Put focus immediately following the replacement
        quill.setSelection(startIdx + replacement.length);

        // Force dynamic scan update immediately
        updateEditorState(true);
    };

    document.addEventListener('DOMContentLoaded', function() {
        
        // 1. Initialize Quill Editor
        quill = new Quill('#editor', {
            theme: 'snow',
            placeholder: 'Start your essay here... Your AI mentor is ready.',
            modules: {
                toolbar: [
                    [{ 'header': [1, 2, false] }],
                    ['bold', 'italic', 'underline'],
                    [{ 'list': 'ordered'}, { 'list': 'bullet' }],
                    ['clean']
                ]
            }
        });

        // 2. DOM Elements
        const wordCountEl = document.getElementById('wordCount');
        const editorGuide = document.getElementById('editorEmptyGuide');
        const aiFloatingHelper = document.getElementById('aiFloatingHelper');
        const aiSuggestions = document.getElementById('aiSuggestions');
        const aiStatusPill = document.getElementById('aiStatusPill');
        
        const statGrammar = document.getElementById('stat-grammar');
        const statVocab = document.getElementById('stat-vocab');
        const statCoh = document.getElementById('stat-coh');
        const dotGrammar = document.getElementById('stat-grammar-dot');
        const dotVocab = document.getElementById('stat-vocab-dot');
        const dotCoh = document.getElementById('stat-coh-dot');

        let liveSuggestionsTimeout;
        
        // 3. Editor Interaction & Text Sync Logic with robust updates

        updateEditorState = function(immediate) {
            var text = quill.getText().trim();
            var words = text.length > 0 ? text.split(/\s+/).length : 0;
            
            // Clear writing validation error if user is typing
            const errBanner = document.getElementById('writingValidationError');
            if (errBanner && !errBanner.classList.contains('hidden')) {
                errBanner.classList.add('hidden');
            }

            // Sync to hidden original textarea
            const hiddenTextarea = document.getElementById('writingAnswer');
            if (hiddenTextarea) {
                hiddenTextarea.value = text;
            }

            // Update Top Word Count and target requirement
            if (wordCountEl) {
                wordCountEl.innerText = words;
                const taskTypeSelect = document.getElementById('writingTaskType');
                const targetWords = taskTypeSelect && taskTypeSelect.value === '2' ? 250 : 150;
                
                const topbarWordsLabel = document.querySelector('#wordCount + span');
                if (topbarWordsLabel) {
                    topbarWordsLabel.innerText = `/ ${targetWords} words`;
                }

                if(words >= targetWords) {
                    wordCountEl.classList.remove('text-slate-700');
                    wordCountEl.classList.add('text-emerald-600');
                } else {
                    wordCountEl.classList.add('text-slate-700');
                    wordCountEl.classList.remove('text-emerald-600');
                }
            }
            
            // Handle Empty State Guide & Live suggestions instantly
            if (words > 0) {
                if (editorGuide) editorGuide.style.display = 'none';
                if (aiFloatingHelper) aiFloatingHelper.style.display = 'none';
                
                if (words > 2) {
                    if (aiSuggestions) aiSuggestions.style.display = 'flex';
                    
                    if (immediate) {
                        if (liveSuggestionsTimeout) clearTimeout(liveSuggestionsTimeout);
                        runLiveSuggestions(text, words);
                    } else {
                        // Debounce the live suggestion engine to guarantee high performance
                        if (liveSuggestionsTimeout) clearTimeout(liveSuggestionsTimeout);
                        liveSuggestionsTimeout = setTimeout(() => {
                            runLiveSuggestions(text, words);
                        }, 300);
                    }
                } else {
                    if (aiSuggestions) aiSuggestions.style.display = 'none';
                }
            } else {
                if (editorGuide) editorGuide.style.display = 'block';
                if (aiFloatingHelper) aiFloatingHelper.style.display = 'flex';
                if (aiSuggestions) aiSuggestions.style.display = 'none';
                
                // Reset stats
                if (statGrammar) {
                    statGrammar.innerText = 'Waiting...';
                    dotGrammar.className = 'w-1.5 h-1.5 rounded-full bg-slate-300 transition-colors';
                }
                if (statVocab) {
                    statVocab.innerText = 'Waiting...';
                    dotVocab.className = 'w-1.5 h-1.5 rounded-full bg-slate-300 transition-colors';
                }
                if (statCoh) {
                    statCoh.innerText = 'Waiting...';
                    dotCoh.className = 'w-1.5 h-1.5 rounded-full bg-slate-300 transition-colors';
                }
            }
        }

        quill.on('text-change', function() {
            updateEditorState();
        });

        // Initial trigger on load
        updateEditorState();
        
        // 4. Tab Switching Logic for Right Sidebar
        const tabBtnAi = document.getElementById('tabBtnAi');
        const tabBtnHistory = document.getElementById('tabBtnHistory');
        const tabContentAi = document.getElementById('tabContentAi');
        const tabContentHistory = document.getElementById('tabContentHistory');
        
        tabBtnAi.addEventListener('click', () => {
            tabBtnAi.className = 'flex-1 py-2 text-sm font-semibold rounded-lg bg-white text-brand-600 shadow-sm border border-slate-200 flex items-center justify-center gap-2 transition-all';
            tabBtnHistory.className = 'flex-1 py-2 text-sm font-medium rounded-lg text-slate-500 hover:text-slate-800 hover:bg-slate-100 transition-all flex items-center justify-center gap-2 border border-transparent';
            tabContentAi.classList.remove('hidden');
            tabContentAi.classList.add('flex');
            tabContentHistory.classList.add('hidden');
            tabContentHistory.classList.remove('flex');
        });
        
        tabBtnHistory.addEventListener('click', () => {
            tabBtnHistory.className = 'flex-1 py-2 text-sm font-semibold rounded-lg bg-white text-brand-600 shadow-sm border border-slate-200 flex items-center justify-center gap-2 transition-all';
            tabBtnAi.className = 'flex-1 py-2 text-sm font-medium rounded-lg text-slate-500 hover:text-slate-800 hover:bg-slate-100 transition-all flex items-center justify-center gap-2 border border-transparent';
            tabContentHistory.classList.remove('hidden');
            tabContentHistory.classList.add('flex');
            tabContentAi.classList.add('hidden');
            tabContentAi.classList.remove('flex');
        });
        
        // 5. Connect initial loading and local storage recovery without triggering loop events
        setTimeout(() => {
            const hiddenTextarea = document.getElementById('writingAnswer');
            if (hiddenTextarea && hiddenTextarea.value) {
                quill.clipboard.dangerouslyPasteHTML(hiddenTextarea.value);
            } else {
                const lId = typeof lessonId !== 'undefined' ? lessonId : '0';
                const draftKey = `practice_draft_writing_${lId}`;
                const cached = localStorage.getItem(draftKey);
                if (cached) {
                    quill.clipboard.dangerouslyPasteHTML(cached);
                    if (hiddenTextarea) {
                        hiddenTextarea.value = cached;
                    }
                }
            }
            updateEditorState();

            const closeBtn = document.getElementById('closeFeedbackModalBtn');
            if (closeBtn) {
                closeBtn.addEventListener('click', function(e) {
                    e.preventDefault();
                    e.stopPropagation();
                    window.closeFeedbackModal();
                });
            }
        }, 300);
    });

    // Modal Close Trigger via style display
    window.closeFeedbackModal = function() {
        const feedbackModal = document.getElementById('writingFeedbackPanel');
        if (feedbackModal) {
            feedbackModal.style.display = 'none';
        }
    };
</script>

