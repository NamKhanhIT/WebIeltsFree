@model WebIeltsFree.Models.User
@{
    ViewData["Title"] = "Edit User";
}

<div class="row justify-content-center">
    <div class="col-md-8 col-lg-6">
        <div class="card shadow-sm border-0">
            <div class="card-header bg-white py-3 d-flex align-items-center gap-3">
                <div class="avatar avatar-sm rounded-circle bg-primary-subtle text-primary d-flex align-items-center justify-content-center fw-bold">
                    @(Model.Profile?.FullName?.FirstOrDefault().ToString() ?? Model.Email.FirstOrDefault().ToString().ToUpper())
                </div>
                <div>
                    <h4 class="mb-0 h5 fw-bold">Edit User</h4>
                    <p class="text-muted mb-0 small">@Model.Email</p>
                </div>
            </div>
            <div class="card-body p-4">
                <form asp-action="Edit" method="post">
                    <input type="hidden" asp-for="UserId" />
                    
                    <div class="row">
                        <div class="col-md-6 mb-4">
                            <label class="form-label fw-semibold">Role</label>
                            <select name="role" class="form-select shadow-none">
                                <option value="student" selected="@(Model.Role == "student")">Student</option>
                                <option value="teacher" selected="@(Model.Role == "teacher")">Teacher</option>
                                <option value="admin" selected="@(Model.Role == "admin")">Admin</option>
                                <option value="moderator" selected="@(Model.Role == "moderator")">Moderator</option>
                            </select>
                        </div>
                        <div class="col-md-6 mb-4">
                            <label class="form-label fw-semibold">Status</label>
                            <select name="status" class="form-select shadow-none">
                                <option value="active" selected="@(Model.Status == "active")">Active</option>
                                <option value="inactive" selected="@(Model.Status == "inactive")">Inactive</option>
                                <option value="banned" selected="@(Model.Status == "banned")">Banned</option>
                            </select>
                        </div>
                    </div>

                    <div class="alert bg-light border text-muted small">
                        <i class="ti ti-info-circle me-1"></i> Only Role and Status can be modified by an Admin. Other profile fields are managed by the user.
                    </div>

                    <div class="d-flex gap-2">
                        <button type="submit" class="btn btn-primary px-4">Save Changes</button>
                        <a asp-action="Index" class="btn btn-light px-4">Cancel</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
