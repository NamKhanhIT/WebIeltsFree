@model WebIeltsFree.Models.SpeakingTopic
@{
    ViewData["Title"] = "Archive Topic";
}

<div class="row justify-content-center">
    <div class="col-md-8 col-lg-6">
        <div class="card shadow-sm border-danger border-top border-3">
            <div class="card-body p-5 text-center">
                <div class="icon-shape icon-xl bg-danger-subtle text-danger rounded-circle mx-auto mb-4" style="width: 80px; height: 80px;">
                    <i class="ti ti-archive fs-1"></i>
                </div>
                
                <h3 class="fw-bold mb-3">Archive Content</h3>
                <p class="text-muted mb-4">
                    You are about to archive this speaking topic. It will be marked as <strong class="text-danger">Rejected</strong> and hidden from students. Admins or teachers can restore it later by editing its status.
                </p>

                <div class="bg-light p-3 rounded text-start mb-4 border">
                    <span class="badge bg-info-subtle text-info mb-2">PART @Model.PartNumber</span>
                    <p class="mb-0 text-dark small text-truncate" style="max-height: 60px;">@Model.TopicName</p>
                </div>

                <form asp-action="Delete" method="post">
                    <input type="hidden" asp-for="TopicId" />
                    <div class="d-flex justify-content-center gap-3">
                        <button type="submit" class="btn btn-danger px-4 fw-bold">Yes, Archive It</button>
                        <a asp-action="Index" class="btn btn-light px-4">Cancel</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
