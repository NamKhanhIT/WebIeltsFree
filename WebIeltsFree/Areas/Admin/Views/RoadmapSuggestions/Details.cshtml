@model WebIeltsFree.Models.RoadmapSuggestion
@using System.Text.Json

@{
    ViewData["Title"] = "Suggestion Details";
}

<div class="row mb-4">
    <div class="col-12 d-flex justify-content-between align-items-center">
        <div>
            <h1 class="fs-3 fw-bold mb-1">Suggestion Details</h1>
            <p class="text-muted mb-0">Review and manage this roadmap suggestion.</p>
        </div>
        <div>
            <a asp-action="Index" class="btn btn-outline-secondary">
                <i class="ti ti-arrow-left me-2"></i>Back to List
            </a>
        </div>
    </div>
</div>

<div class="row g-4">
    <div class="col-lg-8">
        <div class="card shadow-sm border-0 mb-4">
            <div class="card-header bg-white border-bottom-0 pt-4 pb-0 px-4">
                <div class="d-flex justify-content-between align-items-center">
                    <h5 class="fw-bold mb-0">@Model.SuggestionTitle</h5>
                    @switch (Model.Status)
                    {
                        case "pending":
                            <span class="badge bg-warning bg-opacity-10 text-warning border border-warning border-opacity-25 px-2 py-1">Pending</span>
                            break;
                        case "approved":
                            <span class="badge bg-success bg-opacity-10 text-success border border-success border-opacity-25 px-2 py-1">Approved</span>
                            break;
                        case "rejected":
                            <span class="badge bg-danger bg-opacity-10 text-danger border border-danger border-opacity-25 px-2 py-1">Rejected</span>
                            break;
                        case "applied":
                            <span class="badge bg-primary bg-opacity-10 text-primary border border-primary border-opacity-25 px-2 py-1">Applied</span>
                            break;
                    }
                </div>
            </div>
            <div class="card-body p-4">
                <div class="row mb-4">
                    <div class="col-md-6">
                        <small class="text-muted d-block text-uppercase fw-semibold mb-1">Suggested By Teacher</small>
                        <div class="d-flex align-items-center">
                            <div class="avatar avatar-sm bg-success text-white rounded-circle me-2 d-flex align-items-center justify-content-center">
                                @Model.Teacher?.Profile?.FullName?.FirstOrDefault()
                            </div>
                            <span class="fw-medium">@Model.Teacher?.Profile?.FullName</span>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <small class="text-muted d-block text-uppercase fw-semibold mb-1">For Student</small>
                        <div class="d-flex align-items-center">
                            <div class="avatar avatar-sm bg-primary text-white rounded-circle me-2 d-flex align-items-center justify-content-center">
                                @Model.Student?.Profile?.FullName?.FirstOrDefault()
                            </div>
                            <span class="fw-medium">@Model.Student?.Profile?.FullName</span>
                        </div>
                    </div>
                </div>

                <div class="mb-4">
                    <small class="text-muted d-block text-uppercase fw-semibold mb-2">Message to Student</small>
                    <div class="p-3 bg-light rounded-3 border">
                        @Model.Message
                    </div>
                </div>

                <div>
                    <small class="text-muted d-block text-uppercase fw-semibold mb-2">Suggested Changes Data</small>
                    <pre class="bg-dark text-light p-3 rounded-3" style="max-height: 300px; overflow-y: auto;"><code>@{
                        try {
                            var parsedJson = JsonDocument.Parse(Model.SuggestedChanges);
                            @Html.Raw(JsonSerializer.Serialize(parsedJson, new JsonSerializerOptions { WriteIndented = true }))
                        } catch {
                            @Model.SuggestedChanges
                        }
                    }</code></pre>
                </div>
            </div>
        </div>
    </div>

    <div class="col-lg-4">
        <div class="card shadow-sm border-0 mb-4">
            <div class="card-header bg-white border-bottom-0 pt-4 pb-0 px-4">
                <h5 class="fw-bold mb-0">Metadata</h5>
            </div>
            <div class="card-body p-4">
                <ul class="list-unstyled mb-0">
                    <li class="mb-3">
                        <span class="text-muted small d-block">Created At</span>
                        <span class="fw-medium">@Model.CreatedAt.ToString("MMM dd, yyyy HH:mm")</span>
                    </li>
                    <li class="mb-3">
                        <span class="text-muted small d-block">Resolved At</span>
                        <span class="fw-medium">@(Model.ResolvedAt?.ToString("MMM dd, yyyy HH:mm") ?? "Not resolved yet")</span>
                    </li>
                    <li>
                        <span class="text-muted small d-block">Target Roadmap ID</span>
                        <span class="fw-medium">#@Model.RoadmapId</span>
                    </li>
                </ul>
            </div>
        </div>

        <div class="card shadow-sm border-0 border-top border-primary border-3">
            <div class="card-header bg-white border-bottom-0 pt-4 pb-0 px-4">
                <h5 class="fw-bold mb-0">Admin Actions</h5>
            </div>
            <div class="card-body p-4">
                <form asp-action="UpdateStatus" method="post" class="mb-3">
                    <input type="hidden" name="id" value="@Model.SuggestionId" />
                    <div class="input-group">
                        <select name="newStatus" class="form-select">
                            <option value="pending" selected="@(Model.Status == "pending")">Pending</option>
                            <option value="approved" selected="@(Model.Status == "approved")">Approved</option>
                            <option value="rejected" selected="@(Model.Status == "rejected")">Rejected</option>
                            <option value="applied" selected="@(Model.Status == "applied")">Applied</option>
                        </select>
                        <button type="submit" class="btn btn-primary">Update Status</button>
                    </div>
                </form>

                <hr class="my-4" />

                <div class="d-grid gap-2">
                    @if (Model.Status != "applied")
                    {
                        <form asp-action="ForceApply" method="post" onsubmit="return confirm('Are you sure you want to force apply these changes to the student\'s roadmap?');">
                            <input type="hidden" name="id" value="@Model.SuggestionId" />
                            <button type="submit" class="btn btn-outline-success w-100">
                                <i class="ti ti-check me-2"></i> Force Apply Suggestion
                            </button>
                        </form>
                    }

                    <form asp-action="Delete" method="post" onsubmit="return confirm('WARNING: This will permanently delete this suggestion. Are you sure?');">
                        <input type="hidden" name="id" value="@Model.SuggestionId" />
                        <button type="submit" class="btn btn-outline-danger w-100">
                            <i class="ti ti-trash me-2"></i> Delete Suggestion
                        </button>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>
