@model IEnumerable<WebIeltsFree.Models.User>
@{
    ViewData["Title"] = "User Management";
}

<div class="row">
    <div class="col-12">
        <div class="card shadow-sm border-0 mb-4">
            <div class="card-header bg-white d-flex justify-content-between align-items-center py-3">
                <h4 class="mb-0 h5 text-dark fw-bold">Users</h4>
                <a asp-action="Create" class="btn btn-primary btn-sm px-3 rounded-pill">
                    <i class="ti ti-plus me-1"></i> New User
                </a>
            </div>
            <div class="card-body p-0">
                <div class="p-3 bg-light border-bottom">
                    <form method="get" class="row g-2 align-items-center">
                        <div class="col-md-4">
                            <input type="text" name="searchString" value="@ViewBag.SearchString" class="form-control form-control-sm shadow-none" placeholder="Search by email or name..." />
                        </div>
                        <div class="col-md-2">
                            <select name="roleFilter" class="form-select form-select-sm shadow-none">
                                <option value="">All Roles</option>
                                <option value="student" selected="@(ViewBag.RoleFilter == "student")">Student</option>
                                <option value="teacher" selected="@(ViewBag.RoleFilter == "teacher")">Teacher</option>
                                <option value="admin" selected="@(ViewBag.RoleFilter == "admin")">Admin</option>
                            </select>
                        </div>
                        <div class="col-md-2">
                            <select name="statusFilter" class="form-select form-select-sm shadow-none">
                                <option value="">All Statuses</option>
                                <option value="active" selected="@(ViewBag.StatusFilter == "active")">Active</option>
                                <option value="inactive" selected="@(ViewBag.StatusFilter == "inactive")">Inactive</option>
                                <option value="banned" selected="@(ViewBag.StatusFilter == "banned")">Banned</option>
                            </select>
                        </div>
                        <div class="col-md-2">
                            <button type="submit" class="btn btn-dark btn-sm w-100">Filter</button>
                        </div>
                        <div class="col-md-2">
                            <a asp-action="Index" class="btn btn-outline-secondary btn-sm w-100">Reset</a>
                        </div>
                    </form>
                </div>
                
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-light text-secondary">
                            <tr>
                                <th class="ps-4">User</th>
                                <th>Role</th>
                                <th>Status</th>
                                <th>Created</th>
                                <th class="text-end pe-4">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in Model)
                            {
                                <tr>
                                    <td class="ps-4">
                                        <div class="d-flex align-items-center gap-3">
                                            @{
                                                var initial = item.Profile?.FullName?.FirstOrDefault().ToString() ?? item.Email.FirstOrDefault().ToString();
                                            }
                                            <div class="avatar avatar-md rounded-circle bg-primary-subtle text-primary d-flex align-items-center justify-content-center fw-bold">
                                                @initial.ToUpper()
                                            </div>
                                            <div>
                                                <h6 class="mb-0 text-dark fw-semibold">@(item.Profile?.FullName ?? "No Name")</h6>
                                                <small class="text-muted">@item.Email</small>
                                            </div>
                                        </div>
                                    </td>
                                    <td>
                                        <span class="badge @(item.Role == "admin" ? "bg-danger" : item.Role == "teacher" ? "bg-info" : "bg-secondary") rounded-pill">@item.Role</span>
                                    </td>
                                    <td>
                                        <span class="badge @(item.Status == "active" ? "bg-success-subtle text-success" : item.Status == "banned" ? "bg-danger-subtle text-danger" : "bg-warning-subtle text-warning")">@item.Status</span>
                                    </td>
                                    <td class="text-muted small">@item.CreatedAt.ToString("MMM dd, yyyy")</td>
                                    <td class="text-end pe-4">
                                        <div class="d-flex justify-content-end gap-1">
                                            <a asp-action="Details" asp-route-id="@item.UserId" class="btn btn-sm btn-light btn-icon" title="View Details">
                                                <i class="ti ti-eye text-primary"></i>
                                            </a>
                                            <a asp-action="Edit" asp-route-id="@item.UserId" class="btn btn-sm btn-light btn-icon" title="Edit">
                                                <i class="ti ti-edit text-warning"></i>
                                            </a>
                                            <form asp-action="ToggleBan" asp-route-id="@item.UserId" method="post" class="d-inline">
                                                <button type="submit" class="btn btn-sm btn-light btn-icon" title="@(item.Status == "banned" ? "Unban" : "Ban")">
                                                    <i class="ti @(item.Status == "banned" ? "ti-user-check text-success" : "ti-user-off text-danger")"></i>
                                                </button>
                                            </form>
                                            <a asp-action="Delete" asp-route-id="@item.UserId" class="btn btn-sm btn-light btn-icon" title="Delete">
                                                <i class="ti ti-trash text-danger"></i>
                                            </a>
                                        </div>
                                    </td>
                                </tr>
                            }
                            @if (!Model.Any())
                            {
                                <tr>
                                    <td colspan="5" class="text-center py-4 text-muted">No users found.</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
                
                @if (ViewBag.TotalPages > 1)
                {
                    <div class="p-3 border-top d-flex justify-content-between align-items-center">
                        <small class="text-muted">Page @ViewBag.CurrentPage of @ViewBag.TotalPages</small>
                        <nav>
                            <ul class="pagination pagination-sm mb-0">
                                @for (int i = 1; i <= ViewBag.TotalPages; i++)
                                {
                                    <li class="page-item @(i == ViewBag.CurrentPage ? "active" : "")">
                                        <a class="page-link" href="?pageNumber=@i&searchString=@ViewBag.SearchString&roleFilter=@ViewBag.RoleFilter&statusFilter=@ViewBag.StatusFilter">@i</a>
                                    </li>
                                }
                            </ul>
                        </nav>
                    </div>
                }
            </div>
        </div>
    </div>
</div>
