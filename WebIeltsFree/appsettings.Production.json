{
  "Logging": {
    "LogLevel": {
      "Default": "Warning",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Information"
    }
  },

  "ConnectionStrings": {
    "DefaultConnection": "${DB_CONNECTION_STRING}"
  },
  
  "Jwt": {
    "Key": "${JWT_SECRET_KEY}",
    "Issuer": "WebIeltsFree",
    "Audience": "WebIeltsFreeUsers",
    "ExpiryMinutes": 60,
    "RefreshTokenExpiryDays": 7
  },

  "Gemini": {
    "ApiKey": "${GEMINI_API_KEY}",
    "Model": "gemini-2.5-flash",
    "MaxTokens": 2048
  },

  "PythonAI": {
    "BaseUrl": "${PYTHON_AI_BASE_URL}",
    "ApiKey": "${PYTHON_AI_API_KEY}",
    "TimeoutSeconds": 30
  },

  "MongoDB": {
    "ConnectionString": "${MONGODB_CONNECTION_STRING}",
    "DatabaseName": "${MONGODB_DATABASE_NAME}"
  },

  "Pinecone": {
    "ApiKey": "${PINECONE_API_KEY}",
    "IndexName": "${PINECONE_INDEX_NAME}",
    "Environment": "${PINECONE_ENVIRONMENT}"
  },

  "Redis": {
    "ConnectionString": "${REDIS_CONNECTION_STRING}",
    "InstanceName": "IELTSCache_"
  },

  "Email": {
    "SmtpHost": "${SMTP_HOST}",
    "SmtpPort": 587,
    "SmtpUsername": "${SMTP_USERNAME}",
    "SmtpPassword": "${SMTP_PASSWORD}",
    "FromEmail": "${MAIL_FROM_ADDRESS}",
    "FromName": "IELTS Learning Platform"
  },

  "Security": {
    "MaxLoginAttempts": 5,
    "LockoutMinutes": 15,
    "RequireEmailConfirmation": true,
    "AllowedOrigins": [
      "https://webieltsfree.com",
      "https://www.webieltsfree.com",
      "https://api.webieltsfree.com"
    ]
  },

  "RateLimiting": {
    "RequestsPerMinute": 60,
    "RequestsPerHour": 500,
    "AiRequestsPerHour": 50
  },

  "AllowedHosts": "webieltsfree.com;www.webieltsfree.com;api.webieltsfree.com"
}
