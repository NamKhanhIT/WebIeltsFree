@model IEnumerable<WebIeltsFree.Models.Course>

@{
    ViewData["Title"] = "IELTS Vault";
    var searchString = ViewBag.SearchString as string;
    var skillFilter = ViewBag.SkillFilter as string;
}

<div class="row mb-4">
    <div class="col-12 d-flex justify-content-between align-items-center">
        <div>
            <h1 class="fs-3 fw-bold mb-1">IELTS Vault</h1>
            <p class="text-muted mb-0">Manage test materials, courses, and modules.</p>
        </div>
        <div>
            <a asp-action="Create" class="btn btn-primary">
                <i class="ti ti-plus me-2"></i>Add New Course
            </a>
        </div>
    </div>
</div>

<div class="card shadow-sm border-0">
    <div class="card-header bg-white border-bottom-0 pt-4 pb-0 px-4">
        <form method="get" class="row g-3 align-items-center">
            <div class="col-md-4">
                <div class="input-group">
                    <span class="input-group-text bg-light border-end-0"><i class="ti ti-search text-muted"></i></span>
                    <input type="text" name="searchString" class="form-control border-start-0" placeholder="Search courses..." value="@searchString">
                </div>
            </div>
            <div class="col-md-3">
                <select name="skillFilter" class="form-select" onchange="this.form.submit()">
                    <option value="">All Skills</option>
                    <option value="listening" selected="@(skillFilter == "listening")">Listening</option>
                    <option value="reading" selected="@(skillFilter == "reading")">Reading</option>
                    <option value="writing" selected="@(skillFilter == "writing")">Writing</option>
                    <option value="speaking" selected="@(skillFilter == "speaking")">Speaking</option>
                    <option value="mixed" selected="@(skillFilter == "mixed")">Mixed (Full Test)</option>
                </select>
            </div>
            <div class="col-md-2">
                <button type="submit" class="btn btn-outline-secondary w-100">Filter</button>
            </div>
        </form>
    </div>
    <div class="card-body p-0 mt-3">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light text-muted small">
                    <tr>
                        <th class="px-4 py-3 fw-semibold">ID</th>
                        <th class="py-3 fw-semibold">Title</th>
                        <th class="py-3 fw-semibold">Skill</th>
                        <th class="py-3 fw-semibold">Level</th>
                        <th class="py-3 fw-semibold">Modules</th>
                        <th class="py-3 fw-semibold">Status</th>
                        <th class="px-4 py-3 fw-semibold text-end">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!Model.Any())
                    {
                        <tr>
                            <td colspan="7" class="text-center py-5 text-muted">
                                <i class="ti ti-books fs-1 mb-2 d-block"></i>
                                No courses found matching your criteria.
                            </td>
                        </tr>
                    }
                    else
                    {
                        foreach (var item in Model)
                        {
                            <tr>
                                <td class="px-4 text-muted small">#@item.CourseId</td>
                                <td class="fw-medium">@item.Title</td>
                                <td>
                                    <span class="badge bg-light text-dark border px-2 py-1 text-uppercase">@item.SkillType</span>
                                </td>
                                <td>Band @item.TargetBand</td>
                                <td>@item.Modules?.Count modules</td>
                                <td>
                                    @if (item.IsPublished)
                                    {
                                        <span class="badge bg-success bg-opacity-10 text-success px-2 py-1">Published</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-warning bg-opacity-10 text-warning px-2 py-1">Draft</span>
                                    }
                                </td>
                                <td class="px-4 text-end">
                                    <div class="btn-group">
                                        <a asp-action="Details" asp-route-id="@item.CourseId" class="btn btn-sm btn-light btn-icon text-primary" title="View details">
                                            <i class="ti ti-eye"></i>
                                        </a>
                                        <a asp-action="Edit" asp-route-id="@item.CourseId" class="btn btn-sm btn-light btn-icon text-secondary" title="Edit course">
                                            <i class="ti ti-edit"></i>
                                        </a>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
