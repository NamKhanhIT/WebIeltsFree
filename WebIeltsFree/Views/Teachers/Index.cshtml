@model IEnumerable<WebIeltsFree.Models.TeacherProfile>

@{
    ViewData["Title"] = "Our Teachers";
    ViewData["Page"] = "teachers";
}

<div class="text-center mb-5">
    <h1 class="fw-bold mb-2"><i class="bi bi-people-fill text-primary me-2"></i>Our Teachers</h1>
    <p class="lead text-muted mx-auto" style="max-width: 700px;">
        Meet our qualified IELTS teachers. They review grade disputes, provide human feedback on your writing and speaking, and bring years of real exam experience.
    </p>
</div>

@if (!Model.Any())
{
    <div class="text-center py-5 text-muted">
        <i class="bi bi-person-x fs-1 d-block mb-3"></i>
        <p>No public teacher profiles are available at the moment.</p>
    </div>
}
else
{
    <div class="row g-4">
        @foreach (var teacher in Model)
        {
            var fullName = teacher.User?.Profile?.FullName ?? "IELTS Teacher";
            var avatarUrl = teacher.User?.Profile?.AvatarUrl;
            var specialtiesList = (teacher.Specialties ?? "")
                .Split(',', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries);
            var bioSnippet = teacher.Bio ?? "";
            if (bioSnippet.Length > 120) bioSnippet = bioSnippet.Substring(0, 120) + "…";

            <div class="col-sm-6 col-lg-4 col-xl-3">
                <div class="card h-100 shadow-sm border-0">
                    <div class="card-body d-flex flex-column align-items-center text-center p-4">
                        @if (!string.IsNullOrEmpty(avatarUrl))
                        {
                            <img src="@avatarUrl" alt="@fullName"
                                 class="rounded-circle mb-3 border border-2 border-primary-subtle"
                                 style="width: 80px; height: 80px; object-fit: cover;" />
                        }
                        else
                        {
                            <div class="rounded-circle mb-3 bg-primary bg-opacity-10 text-primary d-flex align-items-center justify-content-center border border-2 border-primary-subtle"
                                 style="width: 80px; height: 80px; font-size: 2rem; font-weight: 600;">
                                @fullName[0]
                            </div>
                        }

                        <h5 class="card-title mb-1 fw-bold">@fullName</h5>

                        @if (teacher.YearsExperience.HasValue)
                        {
                            <small class="text-muted mb-2">
                                <i class="bi bi-briefcase me-1"></i>@teacher.YearsExperience yr@(teacher.YearsExperience > 1 ? "s" : "") experience
                            </small>
                        }

                        @if (specialtiesList.Length > 0)
                        {
                            <div class="d-flex flex-wrap justify-content-center gap-1 mb-3">
                                @foreach (var skill in specialtiesList.Take(4))
                                {
                                    <span class="badge bg-primary bg-opacity-10 text-primary fw-normal">@skill</span>
                                }
                                @if (specialtiesList.Length > 4)
                                {
                                    <span class="badge bg-secondary bg-opacity-10 text-secondary fw-normal">+@(specialtiesList.Length - 4) more</span>
                                }
                            </div>
                        }

                        @if (!string.IsNullOrEmpty(bioSnippet))
                        {
                            <p class="card-text text-muted small mb-3" style="min-height: 40px;">@bioSnippet</p>
                        }

                        <a asp-action="Details" asp-route-id="@teacher.TeacherId"
                           class="btn btn-outline-primary btn-sm mt-auto">
                            <i class="bi bi-person-lines-fill me-1"></i>View Full Profile
                        </a>
                    </div>
                </div>
            </div>
        }
    </div>
}
