@model IEnumerable<WebIeltsFree.Models.Report>

@{
    ViewData["Title"] = "User Reports & Complaints";
    var statusFilter = ViewBag.StatusFilter as string;
    var typeFilter = ViewBag.TypeFilter as string;
}

<div class="row mb-4">
    <div class="col-12 d-flex justify-content-between align-items-center">
        <div>
            <h1 class="fs-3 fw-bold mb-1">User Reports & Complaints</h1>
            <p class="text-muted mb-0">Manage feedback, bugs, and user complaints.</p>
        </div>
    </div>
</div>

<div class="row g-3 mb-4">
    <!-- Quick Stats -->
    <div class="col-md-3">
        <div class="card bg-danger bg-opacity-10 border-danger border-opacity-25 shadow-sm border-0 h-100">
            <div class="card-body p-3 d-flex align-items-center">
                <div class="avatar avatar-md bg-danger text-white rounded-circle me-3 d-flex align-items-center justify-content-center">
                    <i class="ti ti-alert-triangle fs-4"></i>
                </div>
                <div>
                    <h6 class="mb-0 text-danger fw-bold">@Model.Count(r => r.Priority == "critical" && r.Status != "closed")</h6>
                    <span class="text-danger small">Critical Open</span>
                </div>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card bg-warning bg-opacity-10 border-warning border-opacity-25 shadow-sm border-0 h-100">
            <div class="card-body p-3 d-flex align-items-center">
                <div class="avatar avatar-md bg-warning text-white rounded-circle me-3 d-flex align-items-center justify-content-center">
                    <i class="ti ti-clock fs-4"></i>
                </div>
                <div>
                    <h6 class="mb-0 text-warning fw-bold">@Model.Count(r => r.Status == "open")</h6>
                    <span class="text-warning small">New/Open</span>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="card shadow-sm border-0">
    <div class="card-header bg-white border-bottom-0 pt-4 pb-0 px-4">
        <form method="get" class="row g-3 align-items-center">
            <div class="col-md-3">
                <select name="statusFilter" class="form-select" onchange="this.form.submit()">
                    <option value="">All Statuses</option>
                    <option value="open" selected="@(statusFilter == "open")">Open</option>
                    <option value="in_progress" selected="@(statusFilter == "in_progress")">In Progress</option>
                    <option value="resolved" selected="@(statusFilter == "resolved")">Resolved</option>
                    <option value="closed" selected="@(statusFilter == "closed")">Closed</option>
                </select>
            </div>
            <div class="col-md-3">
                <select name="typeFilter" class="form-select" onchange="this.form.submit()">
                    <option value="">All Types</option>
                    <option value="bug" selected="@(typeFilter == "bug")">Bug Report</option>
                    <option value="feature_request" selected="@(typeFilter == "feature_request")">Feature Request</option>
                    <option value="complaint" selected="@(typeFilter == "complaint")">Complaint</option>
                    <option value="other" selected="@(typeFilter == "other")">Other</option>
                </select>
            </div>
        </form>
    </div>
    <div class="card-body p-0 mt-3">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light text-muted small">
                    <tr>
                        <th class="px-4 py-3 fw-semibold">ID</th>
                        <th class="py-3 fw-semibold">User</th>
                        <th class="py-3 fw-semibold">Type</th>
                        <th class="py-3 fw-semibold" style="width: 30%;">Title</th>
                        <th class="py-3 fw-semibold">Priority</th>
                        <th class="py-3 fw-semibold">Date</th>
                        <th class="py-3 fw-semibold">Status</th>
                        <th class="px-4 py-3 fw-semibold text-end">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!Model.Any())
                    {
                        <tr>
                            <td colspan="8" class="text-center py-5 text-muted">
                                <i class="ti ti-flag fs-1 mb-2 d-block"></i>
                                No reports found matching your criteria.
                            </td>
                        </tr>
                    }
                    else
                    {
                        foreach (var item in Model)
                        {
                            <tr>
                                <td class="px-4 text-muted small">#@item.ReportId</td>
                                <td>
                                    <div class="d-flex align-items-center">
                                        <div class="avatar avatar-sm bg-primary text-white rounded-circle me-2 d-flex align-items-center justify-content-center">
                                            @item.User?.Email?.FirstOrDefault()
                                        </div>
                                        <div class="d-flex flex-column">
                                            <span class="fw-medium small">@item.User?.Profile?.FullName</span>
                                            <span class="text-muted" style="font-size: 0.75rem;">@item.User?.Email</span>
                                        </div>
                                    </div>
                                </td>
                                <td>
                                    <span class="badge bg-light text-dark border px-2 py-1 text-uppercase" style="font-size: 0.7rem;">@item.ReportType.Replace("_", " ")</span>
                                </td>
                                <td>
                                    <div class="text-truncate fw-medium" style="max-width: 250px;">
                                        @item.Title
                                    </div>
                                </td>
                                <td>
                                    @switch (item.Priority)
                                    {
                                        case "low":
                                            <span class="text-success small fw-semibold"><i class="ti ti-arrow-down me-1"></i>Low</span>
                                            break;
                                        case "medium":
                                            <span class="text-warning small fw-semibold"><i class="ti ti-minus me-1"></i>Medium</span>
                                            break;
                                        case "high":
                                            <span class="text-danger small fw-semibold"><i class="ti ti-arrow-up me-1"></i>High</span>
                                            break;
                                        case "critical":
                                            <span class="badge bg-danger">Critical</span>
                                            break;
                                    }
                                </td>
                                <td class="text-muted small">@item.CreatedAt.ToString("MMM dd, yyyy")</td>
                                <td>
                                    @switch (item.Status)
                                    {
                                        case "open":
                                            <span class="badge bg-warning bg-opacity-10 text-warning px-2 py-1">Open</span>
                                            break;
                                        case "in_progress":
                                            <span class="badge bg-info bg-opacity-10 text-info px-2 py-1">In Progress</span>
                                            break;
                                        case "resolved":
                                            <span class="badge bg-success bg-opacity-10 text-success px-2 py-1">Resolved</span>
                                            break;
                                        case "closed":
                                            <span class="badge bg-secondary bg-opacity-10 text-secondary px-2 py-1">Closed</span>
                                            break;
                                    }
                                </td>
                                <td class="px-4 text-end">
                                    <a asp-action="Details" asp-route-id="@item.ReportId" class="btn btn-sm btn-light btn-icon text-primary">
                                        <i class="ti ti-eye"></i>
                                    </a>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
        
        @if (ViewBag.TotalPages > 1)
        {
            <div class="px-4 py-3 border-top d-flex justify-content-between align-items-center">
                <span class="text-muted small">Page @ViewBag.CurrentPage of @ViewBag.TotalPages</span>
                <nav aria-label="Page navigation">
                    <ul class="pagination pagination-sm mb-0">
                        @for (int i = 1; i <= ViewBag.TotalPages; i++)
                        {
                            <li class="page-item @(i == ViewBag.CurrentPage ? "active" : "")">
                                <a class="page-link" asp-action="Index" asp-route-pageNumber="@i" asp-route-statusFilter="@statusFilter" asp-route-typeFilter="@typeFilter">@i</a>
                            </li>
                        }
                    </ul>
                </nav>
            </div>
        }
    </div>
</div>
