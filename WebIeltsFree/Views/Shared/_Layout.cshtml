<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - IELTS Learning Platform</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css" />
    <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@400;500;600;700&family=EB+Garamond:ital,wght@0,400;0,500;0,600;1,400&family=Crimson+Pro:wght@400;500;600&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body data-page="@ViewData["Page"]">
    <header>
        <nav class="navbar navbar-expand-lg navbar-dark">
            <div class="container">
                <a class="navbar-brand" asp-controller="Home" asp-action="Index">
                    <i class="bi bi-journal-bookmark-fill"></i>
                    <span>IELTS Learning</span>
                </a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="collapse navbar-collapse" id="navbarNav">
                    <ul class="navbar-nav me-auto">
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Home" asp-action="Index">
                                <i class="bi bi-house me-1"></i>Home
                            </a>
                        </li>
                        <li class="nav-item dropdown">
                            <a class="nav-link dropdown-toggle" href="#" data-bs-toggle="dropdown">
                                <i class="bi bi-book me-1"></i>Learn
                            </a>
                            <ul class="dropdown-menu">
                                <li><a class="dropdown-item" asp-controller="Home" asp-action="Courses">
                                    <i class="bi bi-collection me-2"></i>All Courses
                                </a></li>
                                <li><hr class="dropdown-divider"></li>
                                <li><a class="dropdown-item" asp-controller="Home" asp-action="Skill" asp-route-type="reading">
                                    <i class="bi bi-book me-2 text-primary"></i>Reading
                                </a></li>
                                <li><a class="dropdown-item" asp-controller="Home" asp-action="Skill" asp-route-type="listening">
                                    <i class="bi bi-headphones me-2 text-warning"></i>Listening
                                </a></li>
                                <li><a class="dropdown-item" asp-controller="Home" asp-action="Skill" asp-route-type="writing">
                                    <i class="bi bi-pencil me-2 text-success"></i>Writing
                                </a></li>
                                <li><a class="dropdown-item" asp-controller="Home" asp-action="Skill" asp-route-type="speaking">
                                    <i class="bi bi-mic me-2 text-danger"></i>Speaking
                                </a></li>
                            </ul>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Home" asp-action="Tests">
                                <i class="bi bi-clipboard-check me-1"></i>Practice Tests
                            </a>
                        </li>
                        <li class="nav-item dropdown">
                            <a class="nav-link dropdown-toggle" href="#" data-bs-toggle="dropdown">
                                <i class="bi bi-pencil-square me-1"></i>Practice
                            </a>
                            <ul class="dropdown-menu">
                                <li><a class="dropdown-item" asp-controller="Home" asp-action="Practice" asp-route-type="listening">
                                    <i class="bi bi-headphones me-2"></i>Listening Practice
                                </a></li>
                                <li><a class="dropdown-item" asp-controller="Home" asp-action="Practice" asp-route-type="reading">
                                    <i class="bi bi-book me-2"></i>Reading Practice
                                </a></li>
                                <li><hr class="dropdown-divider"></li>
                                <li><a class="dropdown-item" asp-controller="Home" asp-action="Practice" asp-route-type="writing">
                                    <i class="bi bi-file-text me-2"></i>Writing Practice
                                </a></li>
                                <li><a class="dropdown-item" asp-controller="Home" asp-action="Practice" asp-route-type="speaking">
                                    <i class="bi bi-mic me-2"></i>Speaking Practice
                                </a></li>
                            </ul>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Home" asp-action="AiTutor">
                                <i class="bi bi-robot me-1"></i>AI Tutor
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Teachers" asp-action="Index">
                                <i class="bi bi-people me-1"></i>Our Teachers
                            </a>
                        </li>
                        @if (User.Identity.IsAuthenticated)
                        {
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="Home" asp-action="SupportChat">
                                    <i class="bi bi-chat-dots me-1"></i>Support
                                </a>
                            </li>
                        }
                    </ul>
                    <ul class="navbar-nav" id="authNav">
                        @if (User.Identity.IsAuthenticated)
                        {
                            <li class="nav-item dropdown">
                                <a class="nav-link dropdown-toggle" href="#" data-bs-toggle="dropdown">
                                    @if (!string.IsNullOrEmpty(User.GetAvatar()))
                                    {
                                        <img src="@User.GetAvatar()" alt="Avatar" class="rounded-circle me-1" style="width: 24px; height: 24px;" />
                                    }
                                    else
                                    {
                                        <i class="bi bi-person-circle me-1"></i>
                                    }
                                    @User.GetFullName()
                                </a>
                                <ul class="dropdown-menu dropdown-menu-end">
                                    <li><a class="dropdown-item" href="/Home/Dashboard"><i class="bi bi-person me-2"></i>Hồ sơ cá nhân</a></li>
                                    <li><hr class="dropdown-divider"></li>
                                    <li>
                                        <form asp-controller="Account" asp-action="LogoutPost" method="post" style="display:inline;">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="dropdown-item text-danger"><i class="bi bi-box-arrow-right me-2"></i>Đăng xuất</button>
                                        </form>
                                    </li>
                                </ul>
                            </li>
                        }
                        else
                        {
                            <li class="nav-item" id="loginBtn">
                                <a class="nav-link" asp-controller="Home" asp-action="Login">
                                    <i class="bi bi-box-arrow-in-right me-1"></i>Login
                                </a>
                            </li>
                            <li class="nav-item ms-2" id="registerBtn">
                                <a class="btn btn-ielts" asp-controller="Home" asp-action="Register">
                                    Get Started Free
                                </a>
                            </li>
                        }
                    </ul>
                </div>
            </div>
        </nav>
    </header>

    <main class="py-4">
        <div class="container">
            @RenderBody()
        </div>
    </main>

    <footer class="footer">
        <div class="container">
            <div class="row">
                <div class="col-lg-4 mb-4 mb-lg-0">
                    <div class="footer-brand">
                        <i class="bi bi-journal-bookmark-fill"></i>
                        <span>IELTS Learning</span>
                    </div>
                    <p class="text-white-50 mb-3">
                        AI-powered IELTS preparation with personalized learning paths. 
                        Achieve your target band score with our adaptive platform.
                    </p>
                    <div class="d-flex gap-3">
                        <a href="#" class="text-white"><i class="bi bi-facebook fs-5"></i></a>
                        <a href="#" class="text-white"><i class="bi bi-twitter fs-5"></i></a>
                        <a href="#" class="text-white"><i class="bi bi-instagram fs-5"></i></a>
                        <a href="#" class="text-white"><i class="bi bi-youtube fs-5"></i></a>
                    </div>
                </div>
                <div class="col-6 col-lg-2">
                    <h6 class="mb-3">Platform</h6>
                    <ul class="list-unstyled">
                        <li class="mb-2"><a href="/Home/Courses">All Courses</a></li>
                        <li class="mb-2"><a href="/Home/Tests">Practice Tests</a></li>
                        <li class="mb-2"><a href="/Home/Practice?type=listening">Listening Exam</a></li>
                        <li class="mb-2"><a href="/Home/Practice?type=reading">Reading Exam</a></li>
                    </ul>
                </div>
                <div class="col-6 col-lg-2">
                    <h6 class="mb-3">Skills</h6>
                    <ul class="list-unstyled">
                        <li class="mb-2"><a href="/Home/Skill?type=listening">Listening</a></li>
                        <li class="mb-2"><a href="/Home/Skill?type=reading">Reading</a></li>
                        <li class="mb-2"><a href="/Home/Skill?type=writing">Writing</a></li>
                        <li class="mb-2"><a href="/Home/Skill?type=speaking">Speaking</a></li>
                    </ul>
                </div>
                <div class="col-6 col-lg-2">
                    <h6 class="mb-3">Resources</h6>
                    <ul class="list-unstyled">
                        <li class="mb-2"><a href="#">IELTS Tips</a></li>
                        <li class="mb-2"><a href="#">Band Calculator</a></li>
                        <li class="mb-2"><a href="#">Study Plans</a></li>
                        <li class="mb-2"><a href="#">FAQ</a></li>
                    </ul>
                </div>
                <div class="col-6 col-lg-2">
                    <h6 class="mb-3">Company</h6>
                    <ul class="list-unstyled">
                        <li class="mb-2"><a href="#">About Us</a></li>
                        <li class="mb-2"><a href="#">Contact</a></li>
                        <li class="mb-2"><a href="#">Privacy Policy</a></li>
                        <li class="mb-2"><a href="#">Terms of Use</a></li>
                    </ul>
                </div>
            </div>
            <hr class="my-4 opacity-25">
            <div class="d-flex flex-column flex-md-row justify-content-between align-items-center">
                <p class="small text-white-50 mb-2 mb-md-0">
                    &copy; 2026 IELTS Learning Platform. All rights reserved.
                </p>
                <p class="small text-white-50 mb-0">
                    Made with <i class="bi bi-heart-fill text-danger"></i> for IELTS learners worldwide
                </p>
            </div>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
