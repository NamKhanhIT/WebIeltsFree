@model WebIeltsFree.Models.Course

@{
    ViewData["Title"] = "Create Course";
}

<div class="row mb-4">
    <div class="col-12 d-flex justify-content-between align-items-center">
        <div>
            <h1 class="fs-3 fw-bold mb-1">Create New Course</h1>
            <p class="text-muted mb-0">Add a new IELTS training course or practice test to the vault.</p>
        </div>
        <div>
            <a asp-action="Index" class="btn btn-outline-secondary">
                <i class="ti ti-arrow-left me-2"></i>Back to List
            </a>
        </div>
    </div>
</div>

<div class="row g-4">
    <div class="col-lg-8">
        <div class="card shadow-sm border-0">
            <div class="card-body p-4">
                <form asp-action="Create" method="post">
                    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                    <div class="row g-3">
                        <div class="col-md-12">
                            <label asp-for="Title" class="form-label fw-semibold">Course Title <span class="text-danger">*</span></label>
                            <input asp-for="Title" class="form-control" placeholder="e.g., Cambridge IELTS 20 - Academic Test 1" required />
                            <span asp-validation-for="Title" class="text-danger small"></span>
                        </div>

                        <div class="col-md-12">
                            <label asp-for="Description" class="form-label fw-semibold">Description</label>
                            <textarea asp-for="Description" class="form-control" rows="3" placeholder="Brief description of the course content..."></textarea>
                            <span asp-validation-for="Description" class="text-danger small"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="SkillType" class="form-label fw-semibold">Skill Focus <span class="text-danger">*</span></label>
                            <select asp-for="SkillType" class="form-select" required>
                                <option value="mixed">Mixed (Full Test)</option>
                                <option value="listening">Listening</option>
                                <option value="reading">Reading</option>
                                <option value="writing">Writing</option>
                                <option value="speaking">Speaking</option>
                            </select>
                            <span asp-validation-for="SkillType" class="text-danger small"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="TargetBand" class="form-label fw-semibold">Target Band Score</label>
                            <input asp-for="TargetBand" class="form-control" type="number" step="0.5" min="0" max="9" placeholder="e.g., 7.0" />
                            <span asp-validation-for="TargetBand" class="text-danger small"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="DifficultyLevel" class="form-label fw-semibold">Difficulty Level (1-5)</label>
                            <input asp-for="DifficultyLevel" class="form-control" type="number" min="1" max="5" value="3" />
                            <span asp-validation-for="DifficultyLevel" class="text-danger small"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="EstimatedHours" class="form-label fw-semibold">Estimated Hours</label>
                            <input asp-for="EstimatedHours" class="form-control" type="number" min="0" value="3" />
                            <span asp-validation-for="EstimatedHours" class="text-danger small"></span>
                        </div>
                        
                        <div class="col-md-6">
                            <label asp-for="OrderIndex" class="form-label fw-semibold">Display Order</label>
                            <input asp-for="OrderIndex" class="form-control" type="number" value="10" />
                            <span asp-validation-for="OrderIndex" class="text-danger small"></span>
                        </div>
                        
                        <div class="col-md-6 d-flex align-items-end">
                            <div class="form-check form-switch mb-2">
                                <input asp-for="IsPublished" class="form-check-input" type="checkbox" role="switch" id="publishSwitch">
                                <label class="form-check-label ms-2" for="publishSwitch">Publish immediately</label>
                            </div>
                        </div>

                        <div class="col-12 mt-4">
                            <hr class="mb-4" />
                            <div class="d-flex justify-content-end gap-2">
                                <a asp-action="Index" class="btn btn-light">Cancel</a>
                                <button type="submit" class="btn btn-primary px-4">Create Course</button>
                            </div>
                        </div>
                    </div>
                </form>
            </div>
        </div>
    </div>
    
    <div class="col-lg-4">
        <div class="card shadow-sm border-0 bg-light">
            <div class="card-body p-4">
                <h5 class="fw-bold mb-3"><i class="ti ti-info-circle text-primary me-2"></i>Content Management Guide</h5>
                <p class="text-muted small">When creating a new course for the IELTS Vault, follow this structure:</p>
                <ul class="text-muted small ps-3">
                    <li class="mb-2"><strong>Course</strong> - The top-level container (e.g., Cambridge 20).</li>
                    <li class="mb-2"><strong>Modules</strong> - Skill areas within the course (e.g., Listening, Reading).</li>
                    <li class="mb-2"><strong>Lessons</strong> - Individual tests or passages (e.g., Test 1 Listening).</li>
                </ul>
                <div class="alert alert-warning py-2 px-3 mt-3 mb-0 small border-0 shadow-sm">
                    <i class="ti ti-alert-triangle me-1"></i> For bulk importing official Cambridge material, please use the Bulk Import tool in the Question Bank.
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
