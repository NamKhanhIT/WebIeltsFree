@model WebIeltsFree.Models.GradeDispute
@{
    ViewData["Title"] = "Resolve Dispute";
}

<div class="row mb-4">
    <div class="col-12 d-flex justify-content-between align-items-center">
        <h4 class="mb-0 fw-bold">Review &amp; Resolve Dispute #@Model.DisputeId</h4>
        <a asp-action="Index" asp-route-activeTab="under_review" class="btn btn-outline-secondary btn-sm"><i class="ti ti-arrow-left me-1"></i> Back to List</a>
    </div>
</div>

<div class="row">
    <!-- Left Card: Submission -->
    <div class="col-lg-7">
        <div class="card shadow-sm border-0 mb-4 h-100">
            <div class="card-header bg-white py-3 d-flex justify-content-between align-items-center">
                <div class="d-flex align-items-center gap-3">
                    <div class="avatar avatar-sm rounded-circle bg-primary-subtle text-primary d-flex align-items-center justify-content-center fw-bold">
                        @(Model.User?.Profile?.FullName?.FirstOrDefault().ToString() ?? Model.User?.Email.FirstOrDefault().ToString().ToUpper() ?? "?")
                    </div>
                    <h5 class="mb-0 fw-bold">@(Model.User?.Profile?.FullName ?? "Unknown Student")</h5>
                </div>
                <span class="badge @(Model.SubmissionType == "writing" ? "bg-info-subtle text-info" : "bg-primary-subtle text-primary") rounded-pill px-3 py-2">
                    <i class="ti @(Model.SubmissionType == "writing" ? "ti-pencil" : "ti-microphone") me-1"></i>
                    @Model.SubmissionType.ToUpper()
                </span>
            </div>
            
            <div class="card-body">
                <div class="d-flex align-items-center justify-content-center mb-4 p-4 bg-light rounded border border-light">
                    <div class="text-center">
                        <h6 class="text-muted fw-bold text-uppercase mb-1">Original AI Band Score</h6>
                        <h1 class="display-4 fw-bold text-dark mb-0">@Model.OriginalScore</h1>
                    </div>
                </div>

                @if (Model.SubmissionType == "writing")
                {
                    var w = ViewBag.WritingSubmission as WebIeltsFree.Models.WritingSubmission;
                    if (w != null)
                    {
                        <div class="row text-center mb-4">
                            <div class="col-3 border-end">
                                <h5 class="mb-0 fw-bold text-primary">@w.TaScore</h5>
                                <small class="text-muted" style="font-size: 0.7rem;">Task Achv.</small>
                            </div>
                            <div class="col-3 border-end">
                                <h5 class="mb-0 fw-bold text-primary">@w.CcScore</h5>
                                <small class="text-muted" style="font-size: 0.7rem;">Coh. &amp; Coh.</small>
                            </div>
                            <div class="col-3 border-end">
                                <h5 class="mb-0 fw-bold text-primary">@w.LrScore</h5>
                                <small class="text-muted" style="font-size: 0.7rem;">Lex. Rsrc.</small>
                            </div>
                            <div class="col-3">
                                <h5 class="mb-0 fw-bold text-primary">@w.GraScore</h5>
                                <small class="text-muted" style="font-size: 0.7rem;">Grammar</small>
                            </div>
                        </div>
                        
                        <h6 class="fw-bold mb-2">Essay Text</h6>
                        <div class="bg-light p-3 rounded text-dark fs-6" style="white-space: pre-wrap; font-family: inherit; max-height: 400px; overflow-y: auto; border: 1px solid #eef0f2;">@w.EssayText</div>
                        
                        <div class="bg-light p-3 rounded text-dark fs-6" style="white-space: pre-wrap; font-family: inherit; max-height: 400px; overflow-y: auto; border: 1px solid #eef0f2;">@w.EssayText</div>
                        
                        <h6 class="fw-bold mb-2 mt-4 text-primary">AI Feedback</h6>
                        <div class="bg-primary-subtle p-3 rounded small text-dark" style="max-height: 200px; overflow-y: auto;">
                            @w.AiFeedback
                        </div>
                    }
                }
                @if (Model.SubmissionType == "speaking")
                {
                    var s = ViewBag.SpeakingSession as WebIeltsFree.Models.SpeakingSession;
                    if (s != null)
                    {
                        <div class="row text-center mb-4">
                            <div class="col-4 border-end">
                                <h5 class="mb-0 fw-bold text-primary">@s.FluencyScore</h5>
                                <small class="text-muted" style="font-size: 0.7rem;">Fluency</small>
                            </div>
                            <div class="col-4 border-end">
                                <h5 class="mb-0 fw-bold text-primary">@s.PronunciationScore</h5>
                                <small class="text-muted" style="font-size: 0.7rem;">Pronunciation</small>
                            </div>
                            <div class="col-4">
                                <h5 class="mb-0 fw-bold text-primary">@s.GrammarScore</h5>
                                <small class="text-muted" style="font-size: 0.7rem;">Grammar</small>
                            </div>
                        </div>
                        
                        <h6 class="fw-bold mb-2">Transcript</h6>
                        <div class="bg-light p-3 rounded text-dark fs-6" style="white-space: pre-wrap; font-family: inherit; max-height: 400px; overflow-y: auto; border: 1px solid #eef0f2;">@s.Transcript</div>
                        
                        <h6 class="fw-bold mb-2 mt-4 text-primary">AI Feedback</h6>
                        <div class="bg-primary-subtle p-3 rounded small text-dark" style="max-height: 200px; overflow-y: auto;">
                            @s.AiFeedback
                        </div>
                    }
                }
            </div>
        </div>
    </div>

    <!-- Right Card: Resolution -->
    <div class="col-lg-5">
        <div class="card shadow-sm border-0 border-top border-warning border-4 mb-4 position-sticky" style="top: 80px;">
            <div class="card-header bg-white py-3">
                <h5 class="mb-0 fw-bold">Review &amp; Resolution</h5>
            </div>
            <div class="card-body p-4">
                <div class="mb-4">
                    <span class="d-block text-muted small fw-semibold text-uppercase mb-2">Student's Reason</span>
                    <blockquote class="border-start border-3 border-warning ps-3 py-2 bg-warning-subtle text-dark fst-italic small mb-0 rounded-end">
                        @Model.Reason
                    </blockquote>
                </div>

                <form asp-action="Edit" method="post">
                    <input type="hidden" name="id" value="@Model.DisputeId" />
                    
                    <div asp-validation-summary="All" class="text-danger small mb-3"></div>

                    <div class="mb-4">
                        <label class="form-label fw-bold">Revised Score (Optional)</label>
                        <div class="input-group">
                            <span class="input-group-text bg-light"><i class="ti ti-star"></i></span>
                            <input type="number" name="revisedScore" class="form-control shadow-none" min="0" max="9" step="0.5" placeholder="e.g. 6.5" />
                        </div>
                        <div class="form-text text-muted mt-2"><i class="ti ti-info-circle me-1"></i>Leave blank to uphold the original score. If provided, the original submission will be updated.</div>
                    </div>

                    @if (Model.SubmissionType == "writing")
                    {
                        <div class="row mb-3">
                            <div class="col-6 mb-2">
                                <label class="form-label small fw-bold">TA Score</label>
                                <input type="number" name="taScore" class="form-control form-control-sm" min="0" max="9" step="0.5" placeholder="Task Achv." />
                            </div>
                            <div class="col-6 mb-2">
                                <label class="form-label small fw-bold">CC Score</label>
                                <input type="number" name="ccScore" class="form-control form-control-sm" min="0" max="9" step="0.5" placeholder="Coh. & Coh." />
                            </div>
                            <div class="col-6 mb-2">
                                <label class="form-label small fw-bold">LR Score</label>
                                <input type="number" name="lrScore" class="form-control form-control-sm" min="0" max="9" step="0.5" placeholder="Lex. Rsrc." />
                            </div>
                            <div class="col-6 mb-2">
                                <label class="form-label small fw-bold">GRA Score</label>
                                <input type="number" name="graScore" class="form-control form-control-sm" min="0" max="9" step="0.5" placeholder="Grammar" />
                            </div>
                        </div>

                        <div class="mb-4">
                            <label class="form-label fw-bold">Detailed Feedback (Optional)</label>
                            <textarea name="feedbackDetails" class="form-control shadow-none" rows="3" placeholder="Provide paragraph-by-paragraph feedback..."></textarea>
                        </div>
                    }

                    <div class="mb-4">
                        <label class="form-label fw-bold">Teacher Notes <span class="text-danger">*</span></label>
                        <textarea name="teacherNotes" class="form-control shadow-none" rows="5" required placeholder="Provide feedback on why the score is being changed or upheld..."></textarea>
                        <div class="form-text text-muted mt-2">These notes will be sent directly to the student in their dispute ticket.</div>
                    </div>

                    <div class="d-flex flex-column gap-2 mt-4">
                        <button type="submit" name="action" value="resolve" class="btn btn-success py-2 fw-bold w-100 shadow-sm">
                            <i class="ti ti-check me-1"></i> Resolve Dispute
                        </button>
                        <button type="submit" name="action" value="reject" class="btn btn-danger py-2 fw-bold w-100 shadow-sm mt-2">
                            <i class="ti ti-x me-1"></i> Reject Dispute
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
